@using Meadow.Shared.Kpi
@implements IDisposable

@*
    Die Live-Vorschau im KPI-Dialog.

    Sie ersetzt den Knopf "SQL testen", der eine Datenbankrunde gekostet hat,
    das Skript dabei tatsaechlich AUSGEFUEHRT hat und den rohen
    DB-Ausnahmetext in den Browser geschrieben hat. Hier rechnet der
    Evaluator ueber die Caches im Speicher - also sofort, bei jeder Aenderung,
    und ohne dass man an etwas denken muss.

    "n von m Zeilen" nach dem Vorbild von CountText in den Tabellen: es macht
    den Unterschied zwischen "der Filter trifft nichts" und "die Kennzahl ist
    nun mal 0" sichtbar, statt beides als eine Null zu zeigen.

    Die Ampel steht hier mit derselben Komponente wie auf der Kachel: was man
    im Editor sieht, soll danach auf dem Dashboard stehen.
*@
<div class="mw-kpi-preview">
    <div class="mw-kpi-preview__head">
        <span class="mw-label">Vorschau</span>
        <span class="mw-result-count">@CountText</span>
    </div>

    <div class="@ValueClass">
        <span class="mw-kpi-preview__value">@Result.Display</span>
        @if (!string.IsNullOrWhiteSpace(Result.DeltaDisplay))
        {
            <span class="mw-kpi-preview__delta">@Result.DeltaDisplay</span>
        }
        <MeadowKpiFlag Status="Result.Status" Size="18" />
    </div>

    @if (!string.IsNullOrWhiteSpace(Result.Message))
    {
        <div class="@MessageClass">@Result.Message</div>
    }
</div>

@*
    Die Ansage fuer Screenreader steht BEWUSST in einem eigenen, unsichtbaren
    Element und nicht als aria-live am Wert oben.

    Die Vorschau rechnet bei jedem Tastendruck neu. Ein aria-live direkt auf
    dem Wert liesse jede Zwischenzahl vorlesen - beim Tippen von "12" also
    erst "1", dann "12". Entprellt wie MeadowSearchBox: angesagt wird, was
    nach der letzten Aenderung stehen bleibt.
*@
<span class="mw-sr-only" role="status" aria-live="polite" aria-atomic="true">@_announced</span>

@code {
    [Parameter, EditorRequired] public KpiResult Result { get; set; } = default!;

    /// <summary>Zeilen der Quelle insgesamt, also vor Zeitraum und Filtern.</summary>
    [Parameter] public int TotalRows { get; set; }

    private const int AnnounceDelayMs = 700;

    private string _announced = "";
    private string _pending = "";
    private CancellationTokenSource? _debounce;

    private bool IsError => Result.State == KpiResultState.Error;

    private string ValueClass => IsError
        ? "mw-kpi-preview__row is-error"
        : "mw-kpi-preview__row";

    /// <summary>
    /// Ein Hinweis ist kein Fehler. Gemischte Dosiereinheiten und ein toter Filterwert sagen
    /// "diese Zahl ist zweifelhaft" - der rote Kasten sagte bisher "hier ist etwas kaputt".
    /// </summary>
    private string MessageClass => IsError ? "mw-errbox" : "mw-hint mw-hint--warn";

    private string CountText => IsError
        ? "nicht berechenbar"
        : $"{Result.MatchedRows} von {TotalRows} Zeilen";

    protected override void OnParametersSet()
    {
        var text = Announcement();
        if (text == _pending)
        {
            return;
        }

        _pending = text;
        Schedule();
    }

    private string Announcement()
    {
        if (IsError)
        {
            return $"Vorschau nicht berechenbar. {Result.Message}";
        }

        var text = $"Vorschau: {Result.Display}, {CountText}";

        var state = KpiDefinitionSummary.StatusLabel(Result.Status);
        if (state.Length > 0)
        {
            text += $", {state}";
        }

        return string.IsNullOrWhiteSpace(Result.Message) ? text + "." : $"{text}. {Result.Message}";
    }

    private void Schedule()
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;

        _ = Announce(token);
    }

    private async Task Announce(CancellationToken token)
    {
        try
        {
            await Task.Delay(AnnounceDelayMs, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (token.IsCancellationRequested)
        {
            return;
        }

        _announced = _pending;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
    }
}
