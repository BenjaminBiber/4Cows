@using Meadow.Shared.Kpi
@using Meadow.Shared.Models
@implements IDisposable

@*
    Die Live-Vorschau im KPI-Dialog.

    Sie zeigt die ECHTE Kachel - dieselbe Komponente, die danach auf dem
    Dashboard steht, mit denselben Parametern. Vorher stand hier eine eigene,
    abstrakte Darstellung: Zahl plus Delta plus Zeilenzaehler. Die beantwortete
    "rechnet das richtig", aber nicht "sieht das richtig aus", und genau das ist
    beim Einstellen von Ampel, Verlauf und Durchschnitt die Frage.

    Sie ersetzt ausserdem weiterhin den Knopf "SQL testen", der eine
    Datenbankrunde gekostet hat, das Skript dabei tatsaechlich AUSGEFUEHRT hat
    und den rohen DB-Ausnahmetext in den Browser geschrieben hat. Hier rechnet
    der Evaluator ueber die Caches im Speicher - also sofort, bei jeder
    Aenderung, und ohne dass man an etwas denken muss.

    "n von m Zeilen" nach dem Vorbild von CountText in den Tabellen: es macht
    den Unterschied zwischen "der Filter trifft nichts" und "die Kennzahl ist
    nun mal 0" sichtbar, statt beides als eine Null zu zeigen.
*@
<div class="mw-kpi-preview">
    <div class="mw-kpi-preview__head">
        <span class="mw-label">Vorschau</span>
        <span class="mw-result-count">@CountText</span>
    </div>

    @* Auf einer Flaeche in Dashboard-Farbe, damit die weisse Kachel als Kachel
       zu erkennen ist und nicht mit dem Dialoghintergrund verschwimmt. *@
    <div class="mw-kpi-preview__stage">
        <MeadowKpiTile Title="@TileTitle"
                       Value="@Result.Display"
                       Delta="@Result.DeltaDisplay"
                       Trend="@Result.Trend"
                       Status="@Result.Status"
                       Series="@Values"
                       SeriesDisplay="@Definition.SeriesDisplay"
                       Average="@AverageDisplay"
                       AverageLabel="@AverageLabel"
                       HasError="@IsError"
                       Hint="@Result.Message" />
    </div>
</div>

@*
    Die Ansage fuer Screenreader steht BEWUSST in einem eigenen, unsichtbaren
    Element und nicht als aria-live an der Kachel.

    Die Vorschau rechnet bei jedem Tastendruck neu. Ein aria-live direkt am
    Wert liesse jede Zwischenzahl vorlesen - beim Tippen von "12" also erst
    "1", dann "12". Entprellt wie MeadowSearchBox: angesagt wird, was nach der
    letzten Aenderung stehen bleibt.
*@
<span class="mw-sr-only" role="status" aria-live="polite" aria-atomic="true">@_announced</span>

@code {
    [Parameter, EditorRequired] public KpiResult Result { get; set; } = default!;

    [Parameter, EditorRequired] public KpiDefinition Definition { get; set; } = new();

    /// <summary>Der Verlauf, oder null wenn die Definition keinen will.</summary>
    [Parameter] public KpiSeries? Series { get; set; }

    /// <summary>Der eingetippte Titel. Leer: Platzhalter, damit die Kachel nicht kopflos wirkt.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Zeilen der Quelle insgesamt, also vor Zeitraum und Filtern.</summary>
    [Parameter] public int TotalRows { get; set; }

    private const int AnnounceDelayMs = 700;

    private string _announced = "";
    private string _pending = "";
    private CancellationTokenSource? _debounce;

    private bool IsError => Result.State == KpiResultState.Error;

    private string TileTitle
        => string.IsNullOrWhiteSpace(Title) ? "Ohne Titel" : Title!;

    private IReadOnlyList<double?>? Values
        => Series?.Points.Select(p => p.Value).ToList();

    private string? AverageDisplay
        => Definition.ShowAverage ? Series?.AverageDisplay : null;

    private string? AverageLabel
        => Series is { } series ? KpiDefinitionSummary.AverageLabel(series.Bucket) : null;

    private string CountText => IsError
        ? "nicht berechenbar"
        : $"{Result.MatchedRows} von {TotalRows} Zeilen";

    protected override void OnParametersSet()
    {
        var text = Announcement();
        if (text == _pending)
        {
            return;
        }

        _pending = text;
        Schedule();
    }

    private string Announcement()
    {
        if (IsError)
        {
            return $"Vorschau nicht berechenbar. {Result.Message}";
        }

        var text = $"Vorschau: {Result.Display}, {CountText}";

        var state = KpiDefinitionSummary.StatusLabel(Result.Status);
        if (state.Length > 0)
        {
            text += $", {state}";
        }

        return string.IsNullOrWhiteSpace(Result.Message) ? text + "." : $"{text}. {Result.Message}";
    }

    private void Schedule()
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;

        _ = Announce(token);
    }

    private async Task Announce(CancellationToken token)
    {
        try
        {
            await Task.Delay(AnnounceDelayMs, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (token.IsCancellationRequested)
        {
            return;
        }

        _announced = _pending;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
    }
}
