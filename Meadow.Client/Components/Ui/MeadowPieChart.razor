@using System.Globalization
@*
    Ein Kuchendiagramm: Scheibe und Legende.

    Bewusst KEIN Chart.js, obwohl auf der Kuh-Seite schon eines laeuft. Das
    kommt vom CDN und ist im Hofnetz nicht garantiert erreichbar - genau der
    Fall, den .mw-chart-error auf derselben Seite behandelt. Ein Canvas ist
    fuer einen Screenreader ausserdem eine leere Flaeche, waehrend die Legende
    hier eine echte Liste bleibt: durchsuchbar, kopierbar, vorlesbar.

    Jedes Stueck ist ein echter Tortenpfad: vom Mittelpunkt zur Kante, ein
    A-Bogen ueber den Anteil, und zurueck.

    Der erste Versuch war ein Kreis je Stueck mit stroke-dasharray und
    stroke-width gleich dem Durchmesser - ein bekannter Trick, der ohne
    Bogenrechnen auskommt. Er sieht aber falsch aus, sobald Fugen dazukommen:
    die Fuge ist dann eine LUECKE IM WINKEL, klafft am Rand weit auf und
    laeuft zur Mitte hin zusammen, und der Strich liegt auf dem halben Radius
    statt auf der Kante - die Stuecke wirken auseinandergesprengt und die
    Scheibe nicht mehr rund. Ein Pfad ist ein paar Zeilen Trigonometrie mehr
    und dafuer genau die Form, die gemeint ist.

    Die Fuge ist jetzt ein Strich in der Kartenfarbe AUF der Kante
    (vector-effect: non-scaling-stroke im CSS): ueberall gleich breit, egal
    wie gross die Scheibe gerade ist.

    Ein Kuchen zeigt Anteile auf einen Blick. Zwei aehnlich grosse Stuecke
    unterscheidet er NICHT - deshalb steht in der Legende neben jedem Stueck
    seine Zahl, und die ist die genaue Auskunft. Mehr als sechs Stuecke sind
    nicht mehr auseinanderzuhalten; alles darueber faellt in "Weitere".

    Die Farbe folgt hier der Groesse und nicht dem Eintrag: das groesste
    Stueck ist immer Farbe 1. Das ist die Schwaeche jedes Kuchens - dasselbe
    Medikament ist bei der naechsten Kuh anders eingefaerbt. Tragbar, weil die
    Farbe nie allein steht: jede Legendenzeile nennt ihren Namen daneben.
*@
@if (Segments.Count == 0)
{
    <div class="mw-empty">@EmptyText</div>
}
else
{
    <div class="mw-pie @Class">
        @* aria-hidden: die Legende sagt dasselbe in Worten, und zweimal
           vorgelesen ist eine Grafik keine Hilfe. *@
        <svg class="mw-pie__disc" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
            @foreach (var segment in Segments)
            {
                <path class="mw-pie__slice @segment.Slot" d="@segment.Path"></path>
            }
        </svg>

        <ol class="mw-pie__legend">
            @foreach (var segment in Segments)
            {
                <li class="mw-pie__row @segment.Slot">
                    <span class="mw-pie__swatch" aria-hidden="true"></span>
                    <span class="mw-pie__label" title="@segment.Label">@segment.Label</span>
                    <span class="mw-pie__value">@segment.Count.ToString("N0")</span>
                </li>
            }
        </ol>
    </div>
}

@code {
    public sealed record Item(string Label, int Count);

    /// <summary>
    /// Groesstes Stueck zuerst - CowProfile liefert seine Zaehlungen bereits
    /// so. Die Reihenfolge entscheidet ueber Farbe und darueber, was in
    /// "Weitere" faellt.
    /// </summary>
    [Parameter] public IReadOnlyList<Item> Items { get; set; } = Array.Empty<Item>();

    [Parameter] public string EmptyText { get; set; } = "Keine Daten.";

    /// <summary>Zusatzklasse, wie bei MeadowChartCard - z.B. .mw-pie--large.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Ab hier sind die Stuecke nicht mehr auseinanderzuhalten.</summary>
    private const int MaxSlices = 6;

    // Mittelpunkt und Radius im viewBox 0 0 100 100. 48 statt 50, damit der
    // Fugenstrich auf der Aussenkante nicht am Rand des viewBox abgeschnitten
    // wird.
    private const double Centre = 50;
    private const double Radius = 48;

    private sealed record Segment(string Label, int Count, string Path, string Slot);

    private List<Segment> Segments { get; set; } = new();

    protected override void OnParametersSet()
    {
        Segments = Build();
    }

    private List<Segment> Build()
    {
        // Ein Stueck mit null zeichnet nichts, belegt aber eine Farbe und
        // eine Legendenzeile.
        var items = Items.Where(i => i.Count > 0).ToList();
        var total = items.Sum(i => i.Count);

        if (total == 0)
        {
            return new List<Segment>();
        }

        // Gekappt wird erst ab dem siebten Eintrag, und dann fallen mindestens
        // zwei zusammen. "Weitere (1)" - eine Sammelzeile, die den Namen ihres
        // einzigen Eintrags verschweigt - kann so gar nicht entstehen.
        var hasOther = items.Count > MaxSlices;
        var shown = hasOther
            ? items.Take(MaxSlices - 1)
                .Append(new Item(
                    $"Weitere ({items.Count - (MaxSlices - 1)})",
                    items.Skip(MaxSlices - 1).Sum(i => i.Count)))
                .ToList()
            : items;

        var segments = new List<Segment>(shown.Count);
        var cursor = 0d;

        for (var index = 0; index < shown.Count; index++)
        {
            var item = shown[index];
            var share = 100.0 * item.Count / total;

            // Die Sammelzeile traegt bewusst KEINE Kategoriefarbe, sondern das
            // gedaempfte Grau: sie ist kein Eintrag, sondern der Rest.
            var slot = hasOther && index == shown.Count - 1
                ? "mw-slice-other"
                : $"mw-slice-{index + 1}";

            // Kein Mindestanteil: ein Stueck ist genau so gross wie sein
            // Anteil. Eins von vierzig ist dann ein schmaler Keil - und
            // genau das stimmt auch. Gefunden wird es ueber die Legende.
            var path = shown.Count == 1 ? FullCircle() : Wedge(cursor, cursor + share);

            segments.Add(new Segment(item.Label, item.Count, path, slot));
            cursor += share;
        }

        return segments;
    }

    /// <summary>
    /// Ein Tortenstueck von Prozent <paramref name="from"/> bis
    /// <paramref name="to"/>: Mittelpunkt, Kante, Bogen, zurueck.
    /// </summary>
    private static string Wedge(double from, double to)
    {
        var (x0, y0) = Point(from);
        var (x1, y1) = Point(to);

        // Ueber einem halben Kreis muss der A-Bogen den LANGEN Weg nehmen -
        // sonst zeichnet er die Gegenseite und das groesste Stueck wird zum
        // kleinsten.
        var large = to - from > 50 ? 1 : 0;

        return $"M {Num(Centre)} {Num(Centre)} L {Num(x0)} {Num(y0)} "
             + $"A {Num(Radius)} {Num(Radius)} 0 {large} 1 {Num(x1)} {Num(y1)} Z";
    }

    /// <summary>
    /// Der Sonderfall "ein Stueck ist alles": ein Bogen ueber volle 360 Grad
    /// endet dort, wo er anfaengt, und zeichnet nichts. Zwei Halbkreise tun
    /// es.
    /// </summary>
    private static string FullCircle()
        => $"M {Num(Centre)} {Num(Centre - Radius)} "
         + $"A {Num(Radius)} {Num(Radius)} 0 1 1 {Num(Centre)} {Num(Centre + Radius)} "
         + $"A {Num(Radius)} {Num(Radius)} 0 1 1 {Num(Centre)} {Num(Centre - Radius)} Z";

    /// <summary>
    /// Punkt auf der Kante zum Anteil <paramref name="percent"/>. Die
    /// Vierteldrehung steckt im Winkel und nicht in einem transform: so
    /// beginnt das erste Stueck oben und nicht rechts.
    /// </summary>
    private static (double X, double Y) Point(double percent)
    {
        var angle = percent / 100.0 * 2 * Math.PI - Math.PI / 2;
        return (Centre + Radius * Math.Cos(angle), Centre + Radius * Math.Sin(angle));
    }

    /// <summary>
    /// InvariantCulture ist Pflicht und keine Vorsicht: Program.cs legt keine
    /// Kultur fest, auf einem de-Host waere "12,5" ein ungueltiger Wert in
    /// einem Pfad und das Stueck fiele still aus. Dasselbe Muster wie
    /// --mw-pager-slot in MeadowTablePager.
    /// </summary>
    private static string Num(double value)
        => value.ToString("0.###", CultureInfo.InvariantCulture);
}
