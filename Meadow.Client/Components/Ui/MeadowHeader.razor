@using Meadow.Client.Components.Services
@* st.header / st.mHeader — rein praesentational, aller Zustand kommt vom Layout. *@
<header class="mw-header">
    @*
        An erster Stelle steht ENTWEDER der Hamburger ODER der Zurueck-Pfeil,
        nie beides: eine Seite mit Zurueck-Ziel ist eine Detailseite, und dort
        ist "eine Ebene hoch" die Geste, die man braucht.

        Der Preis ist bewusst: auf so einer Seite gibt es am Desktop keinen
        Drawer mehr - erst eine Ebene hoch, dort steht er wieder. Mobil traegt
        die Tabbar am unteren Rand die Navigation ohnehin.

        Der Pfeil ist ein echtes a und kein history.back() - siehe
        LayoutState.PageBackHref. Sein Chevron ist derselbe wie ueberall, nur
        gedreht; ein eigener Pfeil-Pfad waere ein zweites Icon fuer dieselbe
        Geste, genau wie beim Zurueck-Knopf des Tabellen-Pagers.
    *@
    @if (BackHref is null)
    {
        <button type="button" class="mw-icon-btn mw-icon-btn--text"
                title="Navigation" aria-label="Navigation öffnen" @onclick="OnMenu">
            <MeadowIcon Name="MeadowIconName.Menu" Size="22" />
        </button>
    }
    else
    {
        <a class="mw-icon-btn mw-icon-btn--text mw-icon-btn--back" href="@BackHref"
           title="@BackTitle" aria-label="@BackTitle">
            <MeadowIcon Name="MeadowIconName.ChevronDown" Size="20" />
        </a>
    }

    @*
        Hat die Seite Geschwister, steht der Titel zweimal im Markup und CSS
        zeigt eine Variante: am Desktop reiner Text - das Design hat dort kein
        Dropdown -, mobil der antippbare Knopf mit Chevron.

        Zwei winzige Elemente statt einer Viewport-Abfrage in C#: Blazor Server
        prerendert ohne Viewport-Wissen, jede JS-gestuetzte Weiche wuerde beim
        ersten Frame die falsche Variante rendern und dann umklappen.

        Ohne Geschwister - auf der Kuh-Seite - bleibt es bei einem Element:
        reiner Text auf beiden Breiten. Ein stillgelegter Knopf waere
        fokussierbar und taete auf Enter nichts.
    *@
    @*
        Titel und Kennzeichen stecken in einer gemeinsamen Gruppe, damit sie
        mobil zusammenbleiben: .mw-header ist dort justify-content:
        space-between, und als vierter direkter Nachbar wuerde die Ohrmarke
        vom Titel weggeschoben.
    *@
    <div class="mw-header__heading">
        @* aria-label, weil beide Titel-Varianten im DOM stehen: ohne das liest
           ein Screenreader die Ueberschrift doppelt vor. *@
        @*
            Der Titel fuehrt aufs Dashboard - die Geste, die man von jedem
            Produktnamen oben links kennt. HomeHref ist null, WENN man schon
            dort ist: ein Link auf die eigene Seite verspricht etwas, das nicht
            passiert.

            Auf der Kuh- und der Kennzahl-Seite steht im Titel der Name des
            Tieres bzw. der Kennzahl. Dass der aufs Dashboard fuehrt, klingt
            zunaechst schief - der Weg "eine Ebene hoch" ist aber der
            Zurueck-Pfeil links daneben, und das hier ist der Weg ganz nach
            oben. Zwei verschiedene Gesten, zwei verschiedene Ziele.
        *@
        <h1 class="mw-header__title" tabindex="-1" aria-label="@PageTitle">
            @if (HasSiblings)
            {
                <MeadowHeaderTitle Text="@PageTitle" HomeHref="@HomeHref"
                                   Class="mw-only-desktop" />

                @* Mobil traegt der Titel zwei Ziele: der Text fuehrt nach Hause,
                   der Chevron oeffnet den Ansichtswechsel. Frueher war der ganze
                   Titel der Wechsel-Knopf - der Chevron bekommt dafuer eine
                   eigene, volle Tippflaeche, und er ist ohnehin das Zeichen, auf
                   das man fuer ein Ausklappen zielt. *@
                <span class="mw-title-split mw-only-mobile">
                    <MeadowHeaderTitle Text="@PageTitle" HomeHref="@HomeHref" />

                    <button type="button" class="mw-title-chevron" @onclick="OnTitle"
                            aria-haspopup="true"
                            aria-label="@($"{PageTitle} – Ansicht wechseln")">
                        <MeadowIcon Name="MeadowIconName.ChevronDown" Size="17"
                                    Class="mw-title-btn__chevron" />
                    </button>
                </span>
            }
            else
            {
                <MeadowHeaderTitle Text="@PageTitle" HomeHref="@HomeHref" />
            }
        </h1>

        @* Bewusst AUSSERHALB des h1: dessen aria-label deckt den Inhalt zu,
           und in der Ueberschrift stuende die Ohrmarke damit zwar auf dem
           Schirm, waere fuer einen Screenreader aber nicht vorhanden. *@
        @if (Subtitle is not null || Tags.Count > 0)
        {
            <div class="mw-header__meta">
                @if (Subtitle is not null)
                {
                    <span class="mw-header__eartag">@Subtitle</span>
                }
                @foreach (var tag in Tags)
                {
                    <span class="mw-tag @ToneClass(tag.Tone)">@tag.Text</span>
                }
            </div>
        }
    </div>

    <div class="mw-header__actions">
        <button type="button" class="mw-icon-btn mw-only-desktop"
                title="Datenbank Informationen" aria-label="Datenbank Informationen"
                @onclick="OnInfo">
            <MeadowIcon Name="MeadowIconName.Info" Size="20" />
        </button>

        <button type="button" class="mw-icon-btn"
                title="@(IsDark ? "Zu hell wechseln" : "Zu dunkel wechseln")"
                aria-label="@(IsDark ? "Helles Design aktivieren" : "Dunkles Design aktivieren")"
                aria-pressed="@(IsDark ? "true" : "false")"
                @onclick="OnToggleTheme">
            <MeadowIcon Name="@(IsDark ? MeadowIconName.Moon : MeadowIconName.Sun)" Size="20" />
        </button>
    </div>
</header>

@code {
    [Parameter] public string PageTitle { get; set; } = "";

    /// <summary>Kennzeichen neben dem Titel - auf der Kuh-Seite die Ohrmarke.</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Statusmarken neben dem Kennzeichen, z.B. "Kalb" oder "Abgang".</summary>
    [Parameter] public IReadOnlyList<PageTag> Tags { get; set; } = Array.Empty<PageTag>();

    /// <summary>Ziel des Zurueck-Pfeils, oder null fuer keinen Pfeil.</summary>
    [Parameter] public string? BackHref { get; set; }

    /// <summary>Wohin der Pfeil fuehrt - als Tooltip und fuer Screenreader.</summary>
    [Parameter] public string BackTitle { get; set; } = "Zurück zur Übersicht";

    /// <summary>
    /// Ziel des Titels - das Dashboard. Null auf dem Dashboard selbst, dann bleibt der Titel
    /// reiner Text.
    /// </summary>
    [Parameter] public string? HomeHref { get; set; }

    [Parameter] public bool HasSiblings { get; set; }
    [Parameter] public bool IsDark { get; set; }
    [Parameter] public EventCallback OnMenu { get; set; }
    [Parameter] public EventCallback OnTitle { get; set; }
    [Parameter] public EventCallback OnInfo { get; set; }
    [Parameter] public EventCallback OnToggleTheme { get; set; }

    // Der Ton ist Zustand, die Klasse Darstellung - die Uebersetzung gehoert
    // deshalb hierher und nicht in LayoutState.
    private static string ToneClass(PageTagTone tone)
        => tone == PageTagTone.Removed ? "mw-tag--removed" : "mw-tag--bandage";
}
