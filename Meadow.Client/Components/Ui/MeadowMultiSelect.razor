@inject IJSRuntime JS

@*
    Mehrfachauswahl-Dropdown fuer die Filterpanels — ersetzt MeadowChipSelect.

    Die Chip-Reihen liessen nur EINEN Wert zu ("Alle" war ein Sentinel unter
    den Chips), und bei zehn Medikamenten oder acht Befunden wurde die
    Chipwolke hoeher als das Panel und musste selbst scrollen.

    Klappt INLINE im Panel auf, nicht als eigenes Popover: das Filterpanel ist
    mobil ein scrollendes Bottom-Sheet (.mw-pop). Ein darin absolut
    positioniertes Menue wuerde an dessen overflow abgeschnitten — genau der
    Fehler, den .mw-pop mobil gerade losgeworden ist.

    Leere Auswahl heisst "Alle", also kein Filter. Innerhalb der Gruppe gilt
    ODER: eine Zeile passt, wenn sie EINEN der gewaehlten Werte traegt.
*@
<div class="mw-select">
    @* Das Fragezeichen NEBEN dem beschrifteten Element, nicht darin - siehe MeadowSingleSelect:
       Trigger und Gruppe zeigen per aria-labelledby hierher, und der Name waere sonst um den
       ganzen Hilfetext gewachsen. *@
    <span class="mw-select__labelrow">
        <span class="mw-select__label" id="@_labelId">@Label</span>
        @if (!string.IsNullOrWhiteSpace(Help))
        {
            <MeadowHelp Text="@Help" For="@Label" />
        }
    </span>

    <button type="button"
            class="@(_open ? "mw-select__trigger is-open" : "mw-select__trigger")"
            aria-expanded="@(_open ? "true" : "false")"
            aria-labelledby="@_labelId"
            @onclick="Toggle">
        <span class="mw-select__value">@Summary</span>
        <MeadowIcon Name="MeadowIconName.ChevronDown" Size="16" />
    </button>

    @* Eigener Rahmen um den offenen Teil, damit er sich als EIN Block positionieren laesst.
       Standardmaessig fliesst er mit - siehe den Kopfkommentar oben, warum. Wo Platz und Aufbau
       es hergeben, legt das CSS ihn ueber den Inhalt (.mw-select--overlay), statt den halben
       Dialog nach unten zu schieben. *@
    <div class="mw-select__menu" @ref="_menu">
    @if (_open)
    {
        @if (Options.Count == 0)
        {
            <p class="mw-hint">Keine Werte vorhanden.</p>
        }
        else
        {
            @* Erst ab einer Laenge, bei der Scrollen zum Absuchen wird. Bei "Kuh (Halsband)"
               sind das mehrere hundert Eintraege in einer 232px hohen Liste. *@
            @if (Options.Count >= SearchThreshold)
            {
                <div class="mw-check-search">
                    <MeadowSearchBox Value="@_filter" ValueChanged="OnFilterChanged"
                                     Placeholder="Option suchen…" DebounceMs="120"
                                     AriaLabel="@($"{Label} durchsuchen")" />
                </div>
            }

            <div class="mw-check-bar">
                <span>@CountText</span>
                @if (Selected.Count > 0)
                {
                    <div>
                        <button type="button" class="mw-btn mw-btn--ghost mw-btn--sm"
                                @onclick="ClearAsync">
                            Auswahl löschen
                        </button>
                    </div>
                }
            </div>

            <div class="mw-check-list" role="group" aria-labelledby="@_labelId">
                @* Gewaehlte zuerst und IMMER sichtbar, auch wenn sie nicht zum Suchtext passen.
                   Sonst verschwaende eine gesetzte Auswahl beim Tippen und saehe aus wie
                   geloescht. *@
                @* EINE Schleife, ein Elementtyp, jedes Element mit @key.

                   Beides ist noetig, und beides steht hier, weil es je einen sichtbaren Fehler
                   gekostet hat:

                   @key - die gewaehlten Optionen stehen oben, die Liste sortiert sich beim
                   Anklicken also um. Ohne @key ordnet Blazor die DOM-Knoten der REIHE NACH zu: der
                   Knoten, den der Browser gerade angehakt hat, bleibt stehen und vererbt sein
                   Haekchen an die Option, die dort jetzt steht ("Novaminsulfon" gewaehlt, Haekchen
                   bei "Resflor").

                   Eine Schleife - mit zwei getrennten @foreach wandert eine Option beim Waehlen aus
                   dem einen Block in den anderen. Derselbe Schluessel in zwei Regionen ist fuer das
                   Diffing kein Umzug, und die Knoten kamen mit leerer Klasse heraus.

                   Die Grenze zwischen "gewaehlt" und "Treffer" traegt deshalb eine Klasse am ersten
                   ungewaehlten Eintrag und kein eigenes Trennelement: ein Geschwister, das je nach
                   Auswahl seine Position wechselt, ist genau die Art Strukturaenderung, die das
                   Ganze eben zerlegt hat.

                   Und checked als AUSDRUCK: checked="true" waere ein statisches Attribut, und ein
                   vorhandenes checked-Attribut hakt an, egal was darin steht. *@
                @{
                    // Einmal je Render statt einmal je Eintrag - Pinned und Matches filtern beide
                    // ueber die volle Optionsliste.
                    var pinned = Pinned;
                    var matches = Matches;
                    var firstFree = pinned.Count > 0 ? matches.FirstOrDefault() : null;
                }

                @foreach (var option in pinned.Concat(matches))
                {
                    <label class="@CheckClass(option, firstFree)" @key="option">
                        <input type="checkbox" checked="@Selected.Contains(option)"
                               @onchange="() => ToggleOptionAsync(option)" />
                        <span>@option</span>
                    </label>
                }

                @if (pinned.Count == 0 && matches.Count == 0)
                {
                    <p class="mw-hint">Kein Treffer.</p>
                }
            </div>
        }
    }
    </div>
</div>

@code {
    /// <summary>Gruppentitel, z.B. "Befund" oder "Medikament".</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>Erklaerung hinter einem Fragezeichen neben der Beschriftung. Leer: kein Zeichen.</summary>
    [Parameter] public string? Help { get; set; }

    [Parameter] public IReadOnlyList<string> Options { get; set; } = Array.Empty<string>();

    /// <summary>
    /// Die Menge der Seite, keine Kopie: die Komponente traegt hier ein und
    /// aus und meldet danach ueber SelectionChanged, damit die Seite neu
    /// filtern kann. Leer = kein Filter.
    /// </summary>
    [Parameter, EditorRequired] public HashSet<string> Selected { get; set; } = new();

    [Parameter] public EventCallback SelectionChanged { get; set; }

    /// <summary>
    /// Ab so vielen Optionen bekommt die Liste ein Suchfeld. Zwoelf, weil die Liste bei
    /// max-height 232px etwa dort zu scrollen anfaengt.
    /// </summary>
    [Parameter] public int SearchThreshold { get; set; } = 12;

    /// <summary>Was der Trigger zeigt, solange nichts gewaehlt ist.</summary>
    public const string AllLabel = "Alle";

    private readonly string _labelId = $"sel-{Guid.NewGuid():N}";

    private bool _open;
    private bool _justOpened;
    private ElementReference _menu;

    private string _filter = "";

    /// <summary>Gewaehlte Optionen, in der Reihenfolge der Optionsliste - nicht der Auswahl.</summary>
    private IReadOnlyList<string> Pinned
        => Options.Where(Selected.Contains).ToList();

    private IReadOnlyList<string> Matches
        => Options
            .Where(o => !Selected.Contains(o))
            .Where(o => _filter.Length == 0 || o.Contains(_filter, StringComparison.OrdinalIgnoreCase))
            .ToList();

    /// <summary>
    /// Die Klasse eines Eintrags. Der erste ungewaehlte bekommt zusaetzlich die Trennlinie -
    /// als Rahmen an ihm selbst, nicht als eigenes Element dazwischen.
    /// </summary>
    private string CheckClass(string option, string? firstFree)
    {
        if (Selected.Contains(option))
        {
            return "mw-check is-on";
        }

        return string.Equals(option, firstFree, StringComparison.Ordinal)
            ? "mw-check mw-check--first-free"
            : "mw-check";
    }

    private string CountText
    {
        get
        {
            var text = $"{Selected.Count} von {Options.Count} gewählt";
            return _filter.Length == 0 ? text : $"{text} ({Matches.Count} Treffer)";
        }
    }

    private void OnFilterChanged(string value) => _filter = value;

    private string Summary => Selected.Count switch
    {
        0 => AllLabel,
        1 => Selected.First(),
        _ => $"{Selected.Count} ausgewählt"
    };

    private void Toggle()
    {
        _open = !_open;
        _justOpened = _open;

        // Der Suchtext gilt fuer EINE Sitzung im offenen Zustand: beim naechsten Aufklappen soll
        // die volle Liste dastehen und nicht ein Rest von letzter Woche.
        if (!_open)
        {
            _filter = "";
        }
    }

    /// <summary>
    /// Ein ueberlagerndes Menue vergroessert die Scrollhoehe seines Containers NICHT - beim
    /// untersten Feld ragte es unten aus dem Dialogkoerper heraus und war abgeschnitten.
    /// block: "nearest" scrollt genau so weit wie noetig und tut nichts, wenn es ohnehin
    /// vollstaendig sichtbar ist (also ueberall dort, wo im Fluss geklappt wird).
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_justOpened)
        {
            return;
        }

        _justOpened = false;
        await JS.InvokeVoidAsync("meadowMenu.reveal", _menu);
    }

    private Task ToggleOptionAsync(string option)
    {
        // Remove liefert false, wenn nichts entfernt wurde - dann war der Wert
        // nicht gewaehlt und kommt jetzt dazu.
        if (!Selected.Remove(option))
        {
            Selected.Add(option);
        }

        return SelectionChanged.InvokeAsync();
    }

    private Task ClearAsync()
    {
        Selected.Clear();
        return SelectionChanged.InvokeAsync();
    }
}
