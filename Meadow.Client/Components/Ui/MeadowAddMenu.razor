@*
    st.mAddMenu / st.amiItem / st.amiIcon — die Vier-Punkte-Auswahl ueber dem
    FAB. Erscheint nur dort, wo die Route keine eindeutige Hinzufuegen-Aktion
    hat, also auf Dashboard, Einstellungen und der Kuh-Seite.

    Auf der Kuh-Seite ist CowId gesetzt: dann oeffnen die vier Punkte die
    Dialoge mit genau diesem Tier vorbelegt, statt leer.
*@
@inject MeadowDialogLauncher Launcher

@if (Open)
{
    <button type="button" class="mw-menu-backdrop" tabindex="-1"
            aria-label="Menü schließen" @onclick="OnClose"></button>

    <div class="mw-menu mw-menu--add" role="menu" aria-label="Hinzufügen">
        <button type="button" role="menuitem" class="mw-menu__item"
                @onclick="RunCowTreatment">
            <span class="mw-menu__icon"><MeadowIcon Name="MeadowIconName.Cow" Size="17" /></span>
            Kuh Behandlung
        </button>
        <button type="button" role="menuitem" class="mw-menu__item"
                @onclick="RunPlannedCowTreatment">
            <span class="mw-menu__icon"><MeadowIcon Name="MeadowIconName.PlannedCow" Size="17" /></span>
            Geplante Kuh Behandlung
        </button>
        <button type="button" role="menuitem" class="mw-menu__item"
                @onclick="RunClawTreatment">
            <span class="mw-menu__icon"><MeadowIcon Name="MeadowIconName.Claw" Size="17" /></span>
            Klauen Behandlung
        </button>
        <button type="button" role="menuitem" class="mw-menu__item"
                @onclick="RunPlannedClawTreatment">
            <span class="mw-menu__icon"><MeadowIcon Name="MeadowIconName.PlannedClaw" Size="17" /></span>
            Geplante Klauen Behandlung
        </button>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Das vorzubelegende Tier (Cow_ID) auf der Kuh-Seite, sonst null. Ist es
    /// gesetzt, oeffnen die Punkte die Dialoge mit diesem Tier statt leer.
    /// </summary>
    [Parameter] public string? CowId { get; set; }

    private bool HasCow => !string.IsNullOrWhiteSpace(CowId);

    private Task RunCowTreatment()
        => HasCow
            ? Run(() => Launcher.OpenCowTreatmentAsync(CowId!))
            : Run(Launcher.OpenCowTreatmentAsync);

    private Task RunPlannedCowTreatment()
        => HasCow
            ? Run(() => Launcher.OpenPlannedCowTreatmentAsync(CowId!))
            : Run(Launcher.OpenPlannedCowTreatmentAsync);

    private Task RunClawTreatment()
        => HasCow
            ? Run(() => Launcher.OpenClawTreatmentAsync(CowId!))
            : Run(Launcher.OpenClawTreatmentAsync);

    private Task RunPlannedClawTreatment()
        => HasCow
            ? Run(() => Launcher.OpenPlannedClawTreatmentAsync(CowId!))
            : Run(Launcher.OpenPlannedClawTreatmentAsync);

    private async Task Run(Func<Task> open)
    {
        await OnClose.InvokeAsync();
        await open();
    }
}
