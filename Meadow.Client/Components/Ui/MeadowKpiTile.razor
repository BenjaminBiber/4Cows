@using Meadow.Shared.Kpi
@using Meadow.Shared.Models
@*
    kpiCard / st.kpiTitle / st.kpiVal — ersetzt KPI_Component.razor.

    Die Wurzel ist ein <div>, der Hauptlink darin ein "stretched link"
    (.mw-kpi__link::after deckt die ganze Karte ab). Vorher war die Kachel
    selbst das <a>; das ging, solange sie genau ein Ziel hatte. Mit dem
    Verlaufs-Knopf in der Ecke gaebe es zwei, und verschachtelte <a> sind
    ungueltiges HTML. So bleibt die Karte als Ganzes anklickbar, und beide
    Ziele sind mit der Tastatur erreichbar.

    Bleibt ein echtes <a href>: der Prototyp nutzt ein onClick-Div, aber die
    Kacheln zeigen auf Routen, und ein Link ist tastaturerreichbar und
    mit der mittleren Maustaste in einem neuen Tab oeffenbar.

    Die dritte Zeile des Prototyps (st.kpiSub) ist jetzt da - als Delta zum
    Vorzeitraum. Der frueher hier notierte Einwand ("die KPI-Tabelle hat kein
    Untertitel-Feld, und dafuer sollte es keine Migration geben") bleibt
    erfuellt: das Delta wird berechnet, nicht gespeichert. Dasselbe gilt fuer
    den Verlauf.

    Die Fehlerursache stand frueher NUR im title-Attribut. Auf dem Tablet, dem
    Hauptgeraet im Stall, erreicht die niemand - sichtbar war allein der rote
    Rahmen. Jetzt steht sie als dritte Zeile in der Kachel; der Tooltip bleibt
    zusaetzlich, er kostet nichts und traegt am Desktop den vollen Text.

    Ohne Href bleibt das <a> OHNE href-Attribut (Blazor laesst null-Attribute
    weg) und ist damit kein Link - nicht fokussierbar, kein Klickziel. Auf der
    Kuh-Seite brauchen das die beiden Kacheln, die zwei Quellen addieren: keine
    Tabelle zeigt "Kuh- UND Klauenbehandlungen zusammen", ein Link dorthin
    wuerde also eine andere Menge zeigen als die Zahl auf der Kachel.
    (Die Quelle "Kühe" war frueher derselbe Fall; sie zeigt seit /Kuehe auf die
    Kuh-Uebersicht.)
*@
<div class="@CssClass" title="@Hint">
    <a class="mw-kpi__link" href="@(string.IsNullOrWhiteSpace(Href) ? null : Href)"
       aria-label="@AriaLabel">
        <span class="mw-kpi__head">
            <span class="mw-kpi__title">@Title</span>
            <MeadowKpiFlag Status="Status" />
        </span>

        @if (HasAverage)
        {
            @* Zwei Zahlen statt einer. Eine Zahl ohne Bezug sagt wenig - "120" wird erst
               lesbar neben "Ø 10 pro Monat". Die Beschriftungen stehen in einer eigenen
               Zeile darueber, damit beide Spalten dieselbe Grundlinie behalten. *@
            <span class="mw-kpi__labels">
                <span>Aktuell</span>
                <span>@AverageLabel</span>
            </span>
        }

        <span class="mw-kpi__values">
            <span class="mw-kpi__value">@Value</span>
            @if (HasAverage)
            {
                <span class="mw-kpi__avg">@Average</span>
            }
        </span>
    </a>

    @if (HasChartSeries)
    {
        @* UNTER dem Wert, nicht dahinter: als Hintergrund musste die Deckkraft zwischen
           Lesbarkeit der Zahl und Sichtbarkeit der Kurve vermitteln und verlor beides ein
           wenig. Ein eigenes Band kostet ~56px und beendet den Streit.

           Die Spanne steht am linken Rand - ohne sie ist eine Kurve nur eine Form. *@
        <div class="mw-kpi__chart">
            @if (Range is { } range)
            {
                <span class="mw-kpi__axis" aria-hidden="true">
                    <span>@range.Max</span>
                    <span>@range.Min</span>
                </span>
            }
            <MeadowSparkline Values="Series!" Variant="KpiSeriesDisplay.Chart" />
        </div>
    }

    @if (HasFoot)
    {
        <div class="mw-kpi__foot">
            @if (!string.IsNullOrWhiteSpace(Delta))
            {
                <span class="mw-kpi__delta">
                    @if (Arrow.Length > 0)
                    {
                        <span class="mw-kpi__delta-arrow" aria-hidden="true">@Arrow</span>
                    }
                    <span>@Delta</span>
                    <span class="mw-sr-only">gegenüber dem Vorzeitraum</span>
                </span>
            }
            else
            {
                <span></span>
            }

            @if (HasInlineSeries)
            {
                <MeadowSparkline Values="Series!" Variant="KpiSeriesDisplay.Inline" />
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Hint))
    {
        <p class="mw-kpi__note">@Hint</p>
    }

    @if (!string.IsNullOrWhiteSpace(DetailHref))
    {
        @* Zweiter, kleinerer Einstieg - der Hauptlink bleibt die Tabelle. Wer im
           Stall auf "Offene Verbände" tippt, will die Liste, keinen Zwischenschritt. *@
        <a class="mw-kpi__more" href="@DetailHref" aria-label="@($"Verlauf von {Title} ansehen")">
            <MeadowIcon Name="MeadowIconName.Trend" Size="18" />
        </a>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Href { get; set; } = "";

    /// <summary>
    /// Die synthetische "KPI hinzufuegen"-Kachel, die KPIService bei weniger
    /// als acht KPIs anhaengt (erkennbar an KPIId == int.MinValue).
    /// </summary>
    [Parameter] public bool IsAddTile { get; set; }

    /// <summary>Fertig formatiert, z.B. "+12 %". Leer heisst: kein Vergleich.</summary>
    [Parameter] public string? Delta { get; set; }

    [Parameter] public KpiTrend Trend { get; set; }

    /// <summary>Die Ampel. None heisst "nicht bewertet" und zeigt gar nichts.</summary>
    [Parameter] public KpiStatus Status { get; set; }

    /// <summary>Die KPI liess sich nicht auswerten - nicht dasselbe wie "kein Ergebnis".</summary>
    [Parameter] public bool HasError { get; set; }

    /// <summary>Fehlertext, oder warum die Kachel leer ist. Sichtbar UND als Tooltip.</summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>Werte des Verlaufs, aeltester zuerst. Null oder zu kurz: kein Verlauf.</summary>
    [Parameter] public IReadOnlyList<double?>? Series { get; set; }

    [Parameter] public KpiSeriesDisplay SeriesDisplay { get; set; }

    /// <summary>Fertig formatierter Durchschnitt ueber die gezeigten Perioden.</summary>
    [Parameter] public string? Average { get; set; }

    /// <summary>Beschriftung dazu, z.B. "Ø pro Monat".</summary>
    [Parameter] public string? AverageLabel { get; set; }

    /// <summary>Ziel des Verlaufs-Knopfes in der Ecke. Leer: kein Knopf.</summary>
    [Parameter] public string? DetailHref { get; set; }

    /// <summary>
    /// Zusatzklasse, wie bei MeadowChartCard. Gebraucht fuer .mw-kpi--text:
    /// eine Kachel, deren Wert ein Wort ist ("Sohlengeschwür") und keine Zahl,
    /// traegt die 40px Display-Schrift nicht.
    /// </summary>
    [Parameter] public string? Class { get; set; }

    private bool HasSeries => Series is { Count: > 2 };

    private bool HasInlineSeries => HasSeries && SeriesDisplay == KpiSeriesDisplay.Inline;

    private bool HasChartSeries => HasSeries && SeriesDisplay == KpiSeriesDisplay.Chart;

    /// <summary>
    /// Unabhaengig vom Diagramm: die zweite Zahl hilft auch ohne Kurve, und die Kurve auch ohne
    /// sie. Der Aufrufer reicht sie nur durch, wenn die Definition sie angefordert hat.
    /// </summary>
    private bool HasAverage => !string.IsNullOrWhiteSpace(Average);

    private bool HasFoot => !string.IsNullOrWhiteSpace(Delta) || HasInlineSeries;

    /// <summary>
    /// Spanne der gezeichneten Werte, als Achsenbeschriftung. Ohne Nachkommastellen: an dieser
    /// Stelle geht es um die Groessenordnung, nicht um Genauigkeit - die steht oben.
    /// </summary>
    private (string Min, string Max)? Range
    {
        get
        {
            var values = Series?.Where(v => v.HasValue).Select(v => v!.Value).ToList();
            if (values is not { Count: > 0 })
            {
                return null;
            }

            var culture = System.Globalization.CultureInfo.CurrentCulture;
            return (values.Min().ToString("N0", culture), values.Max().ToString("N0", culture));
        }
    }

    private string CssClass => (IsAddTile, HasError) switch
    {
        (true, _) => "mw-kpi mw-kpi--add",
        (_, true) => "mw-kpi mw-kpi--error",
        _ => "mw-kpi"
    }
    + RateClass
    + (string.IsNullOrWhiteSpace(Href) && string.IsNullOrWhiteSpace(DetailHref) ? " mw-kpi--static" : "")
    + (string.IsNullOrWhiteSpace(Class) ? "" : " " + Class);

    // Bei einem Fehler KEINE Ampel: der rote Rahmen ist dort schon vergeben, und "ausserhalb des
    // Ziels" und "nicht auswertbar" muessen unterscheidbar bleiben. Der Evaluator liefert in dem
    // Fall ohnehin Status.None - das hier ist der Guertel zum Hosentraeger.
    private string RateClass => HasError ? "" : Status switch
    {
        KpiStatus.Good => " mw-kpi--rate-good",
        KpiStatus.Warning => " mw-kpi--rate-warn",
        KpiStatus.Bad => " mw-kpi--rate-crit",
        _ => ""
    };

    // Nur Richtung, keine Wertung: siehe den Kommentar zu .mw-kpi__delta.
    private string Arrow => Trend switch
    {
        KpiTrend.Up => "▲",
        KpiTrend.Down => "▼",
        KpiTrend.Flat => "▬",
        _ => ""
    };

    /// <summary>
    /// Zusammengesetzt, damit ein Screenreader nicht "Titel, Zahl, Dreieck" vorliest. Der Zustand
    /// steht als WORT darin - Farbe und Form sind beide unsichtbar, wenn man sie nicht sieht.
    /// </summary>
    private string AriaLabel
    {
        get
        {
            var text = $"{Title}: {Value}";

            if (HasAverage)
            {
                text += $", {AverageLabel} {Average}";
            }

            var state = KpiDefinitionSummary.StatusLabel(Status);
            if (!HasError && state.Length > 0)
            {
                text += $", {state}";
            }

            if (!string.IsNullOrWhiteSpace(Delta))
            {
                text += $", {Delta} gegenüber dem Vorzeitraum";
            }

            if (!string.IsNullOrWhiteSpace(Hint))
            {
                text += $". {Hint}";
            }

            return text;
        }
    }
}
