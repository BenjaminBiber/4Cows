@using Meadow.Shared.Models
@using Meadow.Shared.Kpi
@inject KpiRowProvider RowProvider

@*
    Das gefuehrte Formular, das den SQL-Editor als Standardweg ersetzt.

    Fortschreitend, KEIN Wizard: es gibt keine Stepper-Komponente, und vier
    Schritte in einem 760px-Dialog sind schlechter als ein Formular, das
    ohnehin scrollt (MeadowDialog setzt mw-scroll auf den Body). Abschnitte
    erscheinen, sobald der vorige sie moeglich macht.

    Zusammengesetzt aus den vorhandenen Bausteinen - MeadowSingleSelect,
    MeadowMultiSelect und MeadowSwitch werden unveraendert benutzt. Das geht
    auf, weil KpiDefinition.Filters bewusst dieselbe Semantik traegt wie
    MeadowMultiSelect: leer heisst "Alle", ODER innerhalb der Gruppe.

    Was eine Quelle nicht kann, FEHLT in der Liste, statt deaktiviert
    dazustehen - die Faehigkeiten stehen in KpiSourceRegistry, nicht hier.
*@

@* Was der Quellen- oder Kennzahlwechsel verworfen hat, steht hier - direkt unter der Auswahl,
   die es ausgeloest hat. Vorher aenderte Normalize() Kennzahl, Gruppierung und Zeitraum still
   und leerte die Filter dazu; man merkte es erst an einer Kachel, die etwas anderes zaehlte
   als gedacht. *@
@if (_changes.Count > 0)
{
    <div class="mw-notice" role="status">
        <div>
            @foreach (var change in _changes)
            {
                <p>@change</p>
            }
        </div>
        <button type="button" class="mw-btn mw-btn--ghost mw-btn--sm" @onclick="DismissChanges">
            Verstanden
        </button>
    </div>
}

<div class="mw-field-row">
    <div class="mw-col">
        <MeadowSingleSelect Label="Datenquelle" Options="SourceLabels"
                            Value="@Source.Label" ValueChanged="OnSourceChanged" />
    </div>
    <div class="mw-col">
        <MeadowSingleSelect Label="Berechnung" Options="MeasureLabels"
                            Value="@KpiDefinitionSummary.MeasureLabel(Definition.Measure)"
                            ValueChanged="OnMeasureChanged" />
    </div>
</div>

@if (Definition.RequiresGroupBy)
{
    <MeadowSingleSelect Label="Gruppieren nach" Options="GroupLabels"
                        Value="@KpiDefinitionSummary.GroupBy(Definition.GroupBy)"
                        ValueChanged="OnGroupChanged" />
}

@* Die Einheit haengt an "liefert eine Zahl", nicht an "misst eine Menge": KpiEvaluator.FromCount
   haengt sie laengst an, nur das Formular hat sie hinter RequiresDosage versteckt - eine Zaehlung
   konnte deshalb kein "Kühe" oder "Fälle" tragen. Die Nachkommastellen bleiben bei den Mengen,
   dort haben sie als einzige eine Bedeutung. *@
@if (Definition.YieldsNumber)
{
    <div class="mw-field-row">
        <div class="mw-col">
            <label class="mw-label" for="mw-kpi-unit">Einheit</label>
            <div class="mw-field">
                <MudTextField T="string" InputId="mw-kpi-unit" Variant="Variant.Text"
                              Value="@(Definition.Unit ?? "")"
                              ValueChanged="OnUnitChanged" Placeholder="@UnitPlaceholder" />
            </div>
        </div>
        @if (Definition.RequiresDosage)
        {
            <div class="mw-col">
                <label class="mw-label" for="mw-kpi-dec">Nachkommastellen</label>
                <div class="mw-field">
                    <MudNumericField T="int" InputId="mw-kpi-dec" Variant="Variant.Text"
                                     HideSpinButtons="true" Min="0" Max="4"
                                     Value="Definition.Decimals" ValueChanged="OnDecimalsChanged" />
                </div>
            </div>
        }
    </div>
}

@foreach (var tag in Source.Tags)
{
    var key = tag.Key;
    <MeadowMultiSelect Label="@tag.Label" Options="@OptionsFor(key)"
                       Selected="@SelectedFor(key)"
                       SelectionChanged="@(() => OnFilterChanged(key))" />
}

@if (Source.SupportsTimeframe)
{
    <MeadowSingleSelect Label="Zeitraum" Options="TimeframeLabels"
                        Value="@KpiDefinitionSummary.TimeframeOption(Definition.Timeframe, Source.IsPlanned)"
                        ValueChanged="OnTimeframeChanged" />
}

@if (Source.SupportsCompare)
{
    <MeadowSwitch Label="Vergleich zum Vorzeitraum"
                  Value="Definition.CompareToPrevious && Definition.AllowsComparison"
                  ValueChanged="OnCompareChanged" />

    @if (!Definition.AllowsComparison)
    {
        <p class="mw-hint">@CompareHint</p>
    }
}

<MeadowKpiTargetFields Definition="Definition" Changed="Notify" UnitSuffix="@(Definition.Unit ?? "")" />

@* Der Verlauf steht hier und nicht in den Zielwert-Feldern, weil er als einziger von der QUELLE
   abhaengt: ohne Datumsspalte gibt es keine Reihe, und das weiss nur der Builder. *@
@if (Definition.AllowsSeries && Source.HasDate)
{
    <MeadowSingleSelect Label="Verlauf" Options="SeriesLabels"
                        Value="@SeriesLabel(Definition.SeriesDisplay)"
                        ValueChanged="OnSeriesChanged" />

    @if (Definition.SeriesDisplay != KpiSeriesDisplay.None)
    {
        <p class="mw-hint">@SeriesHint</p>
    }
}

<MeadowKpiPreview Result="Preview" TotalRows="_rows.Count"
                 Series="PreviewSeries" SeriesDisplay="Definition.SeriesDisplay" />

@* Dieselbe Auswahl, als SQL. Nicht nur zum Nachlesen: der Expertenmodus
   uebernimmt genau dieses Skript, man startet dort also nicht bei null.

   Erzeugt wird es aus derselben Definition, aus der die Vorschau oben
   rechnet, und es liefert nachweislich denselben Wert - inklusive der
   deutschen Zahlenformatierung und der Einheit. *@
<div class="mw-check-bar">
    <span class="mw-label">Als SQL</span>
    <div>
        <button type="button" class="mw-btn mw-btn--ghost mw-btn--sm" @onclick="ToggleSql">
            @(_sqlOpen ? "Verbergen" : "Anzeigen")
        </button>
    </div>
</div>

@if (_sqlOpen)
{
    <pre class="mw-sqlbox">@Script.Annotated</pre>
}

@code {
    [Parameter, EditorRequired] public KpiDefinition Definition { get; set; } = new();

    [Parameter] public EventCallback Changed { get; set; }

    // Aus der Tabelle in Shared, nicht als eigene Liste: ein neuer Zeitraum soll hier von selbst
    // auftauchen und nicht an einer vergessenen Aufzaehlung haengenbleiben.
    private static readonly IReadOnlyList<KpiTimeframe> AllTimeframes = KpiTimeframes.All;

    /// <summary>
    /// Was Normalize() bei der LETZTEN Aktion korrigiert hat. Wird zu Beginn jeder Aktion geleert,
    /// damit der Hinweis immer den gerade ausgeloesten Schaden beschreibt und sich nichts aufstaut.
    /// </summary>
    private readonly List<string> _changes = new();

    private IReadOnlyList<KpiRow> _rows = Array.Empty<KpiRow>();
    private readonly Dictionary<string, HashSet<string>> _selected = new(StringComparer.Ordinal);
    private readonly Dictionary<string, IReadOnlyList<string>> _options = new(StringComparer.Ordinal);
    private KpiSourceId? _loaded;

    private KpiSourceInfo Source
        => KpiSourceRegistry.Find(Definition.Source) ?? KpiSourceRegistry.All[0];

    /// <summary>
    /// Live, ohne Knopfdruck und ohne Datenbank: der Evaluator ist eine reine Funktion ueber die
    /// Caches, die ohnehin im Speicher liegen. Das ist der spuerbarste Unterschied zum bisherigen
    /// "SQL testen", das eine DB-Runde gekostet hat und an das man sich erinnern musste.
    /// </summary>
    private KpiResult Preview => KpiEvaluator.Evaluate(Definition, Source, _rows, DateTime.Now);

    /// <summary>
    /// Der Verlauf der Vorschau - nur gerechnet, wenn die Definition ihn auch anfordert. Dieselbe
    /// Zurueckhaltung wie in KpiDashboard: wer keine Linie will, soll sie nicht bezahlen, und
    /// diese Property laeuft bei JEDEM Tastendruck im Formular.
    /// </summary>
    private IReadOnlyList<double?>? PreviewSeries
        => Definition.WantsSeries
            ? KpiEvaluator.Series(Definition, Source, _rows, DateTime.Now)
                .Points.Select(p => p.Value).ToList()
            : null;

    /// <summary>
    /// Dieselbe Definition als SQL. Reine Funktion, also einfach mitberechnet statt gecacht - und
    /// der Dialog ruft beim Wechsel in den Expertenmodus dieselbe Funktion auf, sodass Vorschau und
    /// uebernommenes Skript nicht auseinanderlaufen koennen.
    /// </summary>
    private KpiSqlScript Script => KpiSqlBuilder.Build(Definition, Source);

    private bool _sqlOpen;

    private void ToggleSql() => _sqlOpen = !_sqlOpen;

    protected override void OnParametersSet()
    {
        if (_loaded != Definition.Source)
        {
            Load();
        }
    }

    private void Load()
    {
        _loaded = Definition.Source;
        _rows = RowProvider.Rows(Definition.Source);

        _options.Clear();
        _selected.Clear();
        foreach (var tag in Source.Tags)
        {
            // Optionen aus den TATSAECHLICH vorkommenden Werten, nicht aus den Lookup-Tabellen -
            // die enthalten automatisch angelegte, nie benutzte Namen (siehe Cow_Table).
            _options[tag.Key] = Source.OptionsFor(tag.Key, _rows);
            _selected[tag.Key] = Definition.Filters.TryGetValue(tag.Key, out var values)
                ? new HashSet<string>(values, StringComparer.OrdinalIgnoreCase)
                : new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        }
    }

    private IReadOnlyList<string> OptionsFor(string key)
        => _options.TryGetValue(key, out var options) ? options : Array.Empty<string>();

    private HashSet<string> SelectedFor(string key)
        => _selected.TryGetValue(key, out var selected) ? selected : new(StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<string> SourceLabels
        => KpiSourceRegistry.All.Select(s => s.Label).ToList();

    private IReadOnlyList<string> MeasureLabels
        => Source.Measures.Select(KpiDefinitionSummary.MeasureLabel).ToList();

    private IReadOnlyList<string> GroupLabels
        => Source.Groupings.Select(KpiDefinitionSummary.GroupBy).ToList();

    private IReadOnlyList<string> TimeframeLabels
        => AllTimeframes.Select(t => KpiDefinitionSummary.TimeframeOption(t, Source.IsPlanned)).ToList();

    /// <summary>Passt sich der Kennzahl an, damit das Feld nicht nach "ml" aussieht, wo "Kühe" hingehört.</summary>
    private string UnitPlaceholder => Definition.Measure switch
    {
        KpiMeasure.SumDosage or KpiMeasure.AvgDosage => "z.B. ml",
        KpiMeasure.CountDistinctCows => "z.B. Kühe",
        _ => "z.B. Fälle"
    };

    private static readonly KpiSeriesDisplay[] SeriesModes =
        { KpiSeriesDisplay.None, KpiSeriesDisplay.Inline, KpiSeriesDisplay.Background };

    private static string SeriesLabel(KpiSeriesDisplay display) => display switch
    {
        KpiSeriesDisplay.Inline => "Kleine Linie",
        KpiSeriesDisplay.Background => "Als Hintergrund",
        _ => "Kein Verlauf"
    };

    private IReadOnlyList<string> SeriesLabels => SeriesModes.Select(SeriesLabel).ToList();

    /// <summary>
    /// Sagt, WELCHE Perioden gezeichnet werden. Die Einteilung folgt dem Zeitraum und ist nicht
    /// einstellbar - ein eigenes Feld dafuer koennte dem Zeitraum widersprechen.
    /// </summary>
    private string SeriesHint => Definition.Timeframe switch
    {
        KpiTimeframe.Days7 => "Acht Tagespunkte - der Zeitraum schließt beide Enden ein.",
        KpiTimeframe.Days30 => "31 Tagespunkte - der Zeitraum schließt beide Enden ein.",
        KpiTimeframe.Days90 => "13 Wochenpunkte.",
        _ => "Die letzten 12 Monate. Ältere Zeilen zählt die Kachel mit, der Verlauf zeigt sie nicht."
    };

    private string CompareHint => Definition.Measure == KpiMeasure.TopValue
        ? "Ein häufigster Wert ist keine Zahl und lässt sich nicht vergleichen."
        // Die Zeiträume kommen aus der Tabelle, nicht als Aufzählung im Text - sonst steht hier
        // nach dem nächsten neuen Zeitraum wieder eine Liste, die einen davon nicht kennt.
        : $"Ohne Zeitraum gibt es keinen Vorzeitraum - wähle {BoundedTimeframes}.";

    /// <summary>„7, 30 oder 90 Tage" - aus KpiTimeframes, damit die Aufzählung mitwächst.</summary>
    private static string BoundedTimeframes
    {
        get
        {
            var days = KpiTimeframes.All
                .Where(t => t != KpiTimeframe.All)
                .Select(t => KpiTimeframes.Days(t).ToString())
                .ToList();

            return days.Count switch
            {
                0 => "einen Zeitraum",
                1 => $"{days[0]} Tage",
                _ => $"{string.Join(", ", days.Take(days.Count - 1))} oder {days[^1]} Tage"
            };
        }
    }

    // ---- Aenderungen ---------------------------------------------------

    private void OnSourceChanged(string label)
    {
        var source = KpiSourceRegistry.All.FirstOrDefault(s => s.Label == label);
        if (source is null || source.Id == Definition.Source)
        {
            return;
        }

        _changes.Clear();
        Definition.Source = source.Id;

        // Die Filter der alten Quelle gelten hier nicht: sie wuerden als unbekannte Schluessel
        // liegen bleiben und die Kachel still auf null Treffer filtern.
        if (Definition.Filters.Count > 0)
        {
            Definition.Filters.Clear();
            Note("Die Filter der vorherigen Datenquelle gelten hier nicht und wurden entfernt.");
        }

        Load();
        Normalize();
        Notify();
    }

    private void OnMeasureChanged(string label)
    {
        _changes.Clear();
        var measure = Source.Measures
            .FirstOrDefault(m => KpiDefinitionSummary.MeasureLabel(m) == label);
        Definition.Measure = measure;
        Normalize();
        Notify();
    }

    private void OnGroupChanged(string label)
    {
        Definition.GroupBy = Source.Groupings
            .FirstOrDefault(g => KpiDefinitionSummary.GroupBy(g) == label);
        Notify();
    }

    private void OnTimeframeChanged(string label)
    {
        _changes.Clear();
        Definition.Timeframe = AllTimeframes
            .FirstOrDefault(t => KpiDefinitionSummary.TimeframeOption(t, Source.IsPlanned) == label);
        Normalize();
        Notify();
    }

    private void OnCompareChanged(bool value)
    {
        Definition.CompareToPrevious = value;
        Notify();
    }

    private void OnSeriesChanged(string label)
    {
        Definition.SeriesDisplay = SeriesModes.FirstOrDefault(m => SeriesLabel(m) == label);
        Notify();
    }

    private void OnUnitChanged(string value)
    {
        Definition.Unit = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        Notify();
    }

    private void OnDecimalsChanged(int value)
    {
        Definition.Decimals = Math.Clamp(value, 0, 4);
        Notify();
    }

    private void OnFilterChanged(string key)
    {
        var selected = SelectedFor(key);
        if (selected.Count == 0)
        {
            // Nicht als leere Liste stehen lassen: "kein Eintrag" und "leerer Eintrag" bedeuten
            // dasselbe, und die gespeicherte Definition bleibt so lesbar.
            Definition.Filters.Remove(key);
        }
        else
        {
            Definition.Filters[key] = selected.ToList();
        }

        Notify();
    }

    /// <summary>
    /// Haelt die Definition in einem Zustand, den die Quelle auch rechnen kann. Ohne das koennte ein
    /// Quellenwechsel eine Kennzahl stehen lassen, die es dort nicht gibt - und die Kachel zeigte
    /// einen Fehler, obwohl der Benutzer nur die Quelle gewechselt hat.
    /// </summary>
    private void Normalize()
    {
        if (!Source.Supports(Definition.Measure))
        {
            var was = KpiDefinitionSummary.MeasureLabel(Definition.Measure);
            Definition.Measure = Source.Measures.First();
            Note($"„{was}\" gibt es für diese Quelle nicht - die Berechnung steht jetzt auf "
                 + $"„{KpiDefinitionSummary.MeasureLabel(Definition.Measure)}\".");
        }

        if (Definition.RequiresGroupBy)
        {
            if (!Source.Supports(Definition.GroupBy))
            {
                var was = Definition.GroupBy;
                Definition.GroupBy = Source.Groupings.FirstOrDefault();
                if (was != KpiGroupBy.None)
                {
                    Note($"Nach „{KpiDefinitionSummary.GroupBy(was)}\" lässt sich hier nicht "
                         + $"gruppieren - jetzt nach „{KpiDefinitionSummary.GroupBy(Definition.GroupBy)}\".");
                }
            }
        }
        else
        {
            Definition.GroupBy = KpiGroupBy.None;
        }

        if (!Source.SupportsTimeframe && Definition.Timeframe != KpiTimeframe.All)
        {
            Definition.Timeframe = KpiTimeframe.All;
            Note($"„{Source.Label}\" hat keine Datumsspalte - der Zeitraum steht jetzt auf „Alle\".");
        }

        if ((!Definition.AllowsComparison || !Source.SupportsCompare) && Definition.CompareToPrevious)
        {
            Definition.CompareToPrevious = false;
            Note("Der Vergleich zum Vorzeitraum ist hier nicht möglich und wurde abgeschaltet.");
        }

        if (!Definition.YieldsNumber && Definition.Unit is not null)
        {
            Definition.Unit = null;
            Note("„Häufigster Wert\" liefert einen Namen - die Einheit wurde entfernt.");
        }

        if (!Definition.RequiresDosage)
        {
            Definition.Decimals = 0;
        }

        if (!Definition.AllowsTarget && Definition.TargetDirection != KpiTargetDirection.None)
        {
            Definition.TargetDirection = KpiTargetDirection.None;
            Definition.TargetGood = null;
            Definition.TargetWarning = null;
            Note("Ein Name lässt sich nicht gegen einen Zielwert prüfen - die Ampel wurde entfernt.");
        }

        if (Definition.SeriesDisplay != KpiSeriesDisplay.None
            && (!Definition.AllowsSeries || !Source.HasDate))
        {
            Definition.SeriesDisplay = KpiSeriesDisplay.None;
            Note(Source.HasDate
                ? "„Häufigster Wert“ liefert einen Namen - der Verlauf wurde entfernt."
                : $"„{Source.Label}“ hat keine Datumsspalte - der Verlauf wurde entfernt.");
        }
    }

    private void Note(string text) => _changes.Add(text);

    private void DismissChanges() => _changes.Clear();

    private void Notify() => Changed.InvokeAsync();
}
