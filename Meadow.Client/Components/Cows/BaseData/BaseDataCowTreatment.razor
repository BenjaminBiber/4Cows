@using Meadow.Client.Components.Cows.Dialogs
@using Meadow.Client.Components.Ui

@inject ICowService CowService
@inject IMedicineService MedicineService
@inject ICowTreatmentService CowTreatmentService
@inject IWhereHowService WhereHowService
@inject IUdderService UdderService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@*
    Basisdaten sind eine Desktop-Admin-Flaeche - deshalb dicht und ohne
    Mobile-Karten (das Design zeichnet hier keinen Mobile-Screen).
*@
<MeadowToolbar>
    <Left>
        <MeadowSearchBox Value="@_search" ValueChanged="OnSearchChanged"
                         AriaLabel="Kuh Behandlungen durchsuchen" />
    </Left>
</MeadowToolbar>

<MeadowTable TItem="CowTreatment" Items="_rows" Columns="_columns"
             RowKey="@(r => r.CowTreatmentId)"
             Class="mw-table-wrap--dense" ShowMobileCards="false"
             DefaultSortTitle="Datum" DefaultSortDescending="true"
             PagerLabel="Behandlungen pro Seite"
             EmptyText="Keine Behandlungen gefunden." />

@code {
    private List<CowTreatment> _all = new();
    private List<CowTreatment> _rows = new();
    private string _search = "";

    private IReadOnlyList<MeadowColumn<CowTreatment>> _columns = Array.Empty<MeadowColumn<CowTreatment>>();

    protected override async Task OnInitializedAsync()
    {
        BuildColumns();
        await CowTreatmentService.GetAllDataAsync();
        _all = CowTreatmentService.Treatments.Values.ToList();
        ApplyFilter();
    }

    private void BuildColumns() => _columns = new List<MeadowColumn<CowTreatment>>
    {
        new()
        {
            Title = "Halsbandnummer",
            Text = r => CollarText(r),
            // Bisher new Func<int,object>(x=>x) auf einer CowTreatment-Tabelle:
            // ein No-Op, der Kopf reagierte auf Klicks ohne zu sortieren.
            SortBy = r => CollarSortKey(r),
            Style = MeadowCellStyle.Bold
        },
        new()
        {
            Title = "Ohrmarkennummer",
            Text = r => CowService.GetEarTagDisplay(r.EarTagNumber),
            SortBy = r => CowService.GetEarTagDisplay(r.EarTagNumber)
        },
        new()
        {
            Title = "Datum",
            // Rohes DateTime samt Uhrzeit - jetzt formatiert.
            Text = r => r.AdministrationDate.ToString("dd.MM.yyyy"),
            SortBy = r => r.AdministrationDate,
            NoWrap = true
        },
        new()
        {
            Title = "Medikament",
            Text = r => MedicineService.GetMedicineNameById(r.MedicineId),
            SortBy = r => MedicineService.GetMedicineNameById(r.MedicineId)
        },
        new()
        {
            Title = "Wie/Wo",
            Text = r => WhereHowService.GetFullWhereHowName(r.WhereHowId, UdderService, r.UdderId),
            SortBy = r => WhereHowService.GetFullWhereHowName(r.WhereHowId, UdderService, r.UdderId)
        },
        new()
        {
            Title = "Menge",
            Text = r => r.MedicineDosage.ToString("0.##"),
            SortBy = r => r.MedicineDosage,
            Align = MeadowAlign.Right
        },
        new()
        {
            IsActions = true,
            Width = "104px",
            Template = row =>
                @<text>
                    <MeadowIconButton Icon="MeadowIconName.Edit" Title="Behandlung bearbeiten"
                                      OnClick="() => Edit(row)" />
                    <MeadowIconButton Icon="MeadowIconName.Trash" Title="Behandlung löschen"
                                      Danger="true" OnClick="() => Delete(row)" />
                </text>
        }
    };

    private string CollarText(CowTreatment row)
    {
        var collar = CowService.GetCollarNumberByCowId(row.EarTagNumber);
        return collar == int.MinValue ? "—" : collar.ToString();
    }

    // Unbekannte Halsbandnummern nach hinten, nicht nach vorne.
    private int CollarSortKey(CowTreatment row)
    {
        var collar = CowService.GetCollarNumberByCowId(row.EarTagNumber);
        return collar == int.MinValue ? int.MaxValue : collar;
    }

    private void OnSearchChanged(string value)
    {
        _search = value;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var term = _search.Trim();
        _rows = term.Length == 0
            ? _all.ToList()
            : _all.Where(r =>
                CollarText(r).Contains(term, StringComparison.OrdinalIgnoreCase)
                || CowService.GetEarTagDisplay(r.EarTagNumber)
                    .Contains(term, StringComparison.OrdinalIgnoreCase)
                || MedicineService.GetMedicineNameById(r.MedicineId)
                    .Contains(term, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    /// <summary>
    /// Eigener Dialog und nicht Add_Cow_Treatment_Dialog: der legt ein
    /// Kreuzprodukt aus Tieren und Medikamenten an, hier wird genau eine
    /// bestehende Zeile geaendert.
    ///
    /// Uebergeben wird eine KOPIE - der Dialog schreibt sein Parameter-Objekt
    /// beim Speichern voll, und das waere hier die Instanz aus dem
    /// Service-Cache.
    /// </summary>
    private async Task Edit(CowTreatment row)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };
        var parameters = new DialogParameters<Edit_Cow_Treatment_Dialog>
        {
            { x => x.Treatment, row.Copy() }
        };

        var dialog = await DialogService.ShowAsync<Edit_Cow_Treatment_Dialog>(
            string.Empty, parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        await CowTreatmentService.GetAllDataAsync();
        _all = CowTreatmentService.Treatments.Values.ToList();
        ApplyFilter();
    }

    private async Task Delete(CowTreatment row)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters<GenericDialog>
        {
            { x => x.HeaderText, "Löschen" },
            { x => x.Description, "Soll die Behandlung wirklich gelöscht werden?" },
            { x => x.AcceptButtonText, "Löschen" },
            { x => x.CancelButtonText, "Abbrechen" },
            { x => x.ColorScheme, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<GenericDialog>(string.Empty, parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        await CowTreatmentService.DeleteDataAsync(row.CowTreatmentId);
        await CowTreatmentService.GetAllDataAsync();
        _all = CowTreatmentService.Treatments.Values.ToList();
        ApplyFilter();
        Snackbar.Add("Behandlung gelöscht.", Severity.Success);
    }
}
