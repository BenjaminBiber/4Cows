@using Meadow.Client.Components.Cows.Dialogs
@using Meadow.Client.Components.Ui
@using Meadow.Shared.Models
@*
    Tab "Klauen": die erfassten Klauenbehandlungen dieses Tieres.

    Der Dialogfluss ist wortgleich der aus Claw_Table: Anzeigen-Dialog, und
    wenn der eine Behandlung zurueckgibt, oeffnet der Add-Dialog im
    Aenderungsmodus (ClawTreatmentId != 0).
*@
@implements IDisposable

@using Meadow.Client.Services

@inject IDialogService DialogService
@inject ISettingsService Settings
@inject IClawFindingService ClawFindingService
@inject MeadowSyncState Sync

<MeadowTable TItem="ClawTreatment" Items="Rows" Columns="_columns"
             RowKey="@(r => r.ClawTreatmentId)"
             RowClass="@(r => MeadowSyncRow.Class(Sync.StateOf(r.ClientId)))"
             DefaultSortTitle="Datum" DefaultSortDescending="true"
             PagerLabel="Behandlungen pro Seite"
             MoreLabel="Weitere Behandlungen laden"
             EmptyText="Für diese Kuh sind keine Klauenbehandlungen erfasst.">
    <MobileCard Context="row">
        @* Die ganze Karte ist der Knopf - sie enthaelt keine weiteren
           Bedienelemente, sonst waere das ein Knopf im Knopf. Wie in
           Claw_Table. *@
        <button type="button" class="mw-row-card mw-row-card--clickable"
                @onclick="() => OpenTreatment(row)">
            <div class="mw-row-card__top">
                <span class="mw-row-card__title">@row.TreatmentDate.ToString("dd.MM.yyyy")</span>
                @if (row.OpenBandages().Any())
                {
                    <span class="mw-tag mw-tag--bandage">Verband</span>
                }
            </div>
            <div class="mw-row-card__meta">
                <span>@Summary(row)</span>
            </div>
        </button>
    </MobileCard>
</MeadowTable>

@code {
    [Parameter] public IReadOnlyList<ClawTreatment> Rows { get; set; } = Array.Empty<ClawTreatment>();

    /// <summary>Die Seite laedt nach und baut das Profil neu.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<MeadowColumn<ClawTreatment>> _columns = new();

    protected override void OnInitialized() => _columns = new()
    {
        new MeadowColumn<ClawTreatment>
        {
            // Uebertragungszustand - dieselbe Spalte wie in der grossen
            // Tabelle. Eine synchronisierte Zeile rendert nichts.
            Title = "",
            Width = "28px",
            Template = row =>@<MeadowSyncDot State="@(Sync.StateOf(row.ClientId))" />
        },
        new MeadowColumn<ClawTreatment>
        {
            Title = "Datum",
            Text = r => r.TreatmentDate.ToString("dd.MM.yyyy"),
            SortBy = r => r.TreatmentDate,
            Style = MeadowCellStyle.Bold,
            NoWrap = true
        },
        new MeadowColumn<ClawTreatment>
        {
            Title = "Befunde",
            Text = Summary,
            SortBy = Summary
        },
        new MeadowColumn<ClawTreatment>
        {
            IsActions = true,
            Template = row =>@<button type="button" class="mw-btn mw-btn--sm mw-btn--primary"
                                      @onclick="() => OpenTreatment(row)">Behandlung öffnen</button>
        }
    };

    /// <summary>
    /// Nicht vorberechnet wie in Claw_Table: dort geht die Zusammenfassung in
    /// die Suche ein und wuerde sonst pro Tastendruck neu entstehen. Hier
    /// gibt es keine Suche und meist unter zehn Zeilen.
    /// </summary>
    private string Summary(ClawTreatment r)
        => ClawFindingSummary.Build(r, ClawFindingService.GetNameById, Settings.ClawFindingFallback);

    private async Task OpenTreatment(ClawTreatment treatment)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };
        var parameters = new DialogParameters<Show_Claw_Treatment_Dialog>
        {
            { x => x.Claw_Treatment, treatment }
        };

        var dialog = await DialogService.ShowAsync<Show_Claw_Treatment_Dialog>(
            string.Empty, parameters, options);
        var result = await dialog.Result;

        // "Bearbeiten" gibt die Behandlung zurueck und oeffnet damit den
        // Add-Dialog im Aenderungsmodus.
        if (result is null || result.Canceled || result.Data is not ClawTreatment edit)
        {
            return;
        }

        await EditTreatment(edit);
    }

    private async Task EditTreatment(ClawTreatment treatment)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };
        var parameters = new DialogParameters<Add_Claw_Treatment_Dialog>
        {
            { x => x.Claw_Treatment, treatment }
        };

        var dialog = await DialogService.ShowAsync<Add_Claw_Treatment_Dialog>(
            string.Empty, parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        await OnChanged.InvokeAsync();
    }

    /// <summary>
    /// Abonniert wird erst nach dem ersten Rendern und nicht in
    /// OnInitialized: dort steht der Spaltenaufbau als Ausdruckskoerper, und
    /// den in einen Block umzuschreiben haette jede Spalte dieser Datei
    /// angefasst, ohne dass sich an einer einzigen etwas aendert.
    /// </summary>
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Sync.Changed += OnSyncChanged;
        }
    }

    /// <summary>
    /// Der Uebertragungszustand hat sich geaendert - nur neu zeichnen. Die
    /// Zeilen kommen als Parameter herein und sind dieselben; was wechselt,
    /// ist der Punkt davor und die Zeilenklasse.
    /// </summary>
    private void OnSyncChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Sync.Changed -= OnSyncChanged;
}
