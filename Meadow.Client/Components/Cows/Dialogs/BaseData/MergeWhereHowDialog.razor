@using Meadow.Client.Components.Ui

@inject IWhereHowService WhereHowService
@inject ISnackbar Snackbar

<MeadowDialog Title="Wie / Wo zusammenführen" Size="MeadowDialogSize.Info">
    <ChildContent>
        <p class="mw-hint">
            @Description
        </p>

        <label class="mw-label" for="mw-merge-wherehow-target">Ziel (bleibt bestehen)</label>
        <div class="mw-field">
            @* CoerceValue FALSE: ein Ziel muss existieren. Ein per Tippfehler
               erfundenes Ziel wuerde die Behandlungen auf eine ID umhaengen,
               die es nicht gibt. *@
            <MeadowAutocomplete InputId="mw-merge-wherehow-target"
                                SelectValueOnTab="true" CoerceValue="false"
                                Value="@_targetName" ValueChanged="OnTargetChanged"
                                SearchFunc="SearchTargets"
                                Placeholder="Wie / Wo suchen…" />
        </div>

        <label class="mw-label">Welcher Name bleibt?</label>
        <div class="mw-field">
            @* Die Wahl ist der Kern dieses Dialogs. Im Stall wird kurz getippt
               ("IZ"), im Nachweis ist die ausgeschriebene Bezeichnung
               eindeutiger - was ueberwiegt, haengt am Einzelfall. Der gewaehlte
               Name landet in WhereHow_Name des Zieleintrags. *@
            <MudRadioGroup T="bool" @bind-Value="_keepSourceName">
                <MudRadio T="bool" Value="false" Dense="true">
                    @TargetLabel
                </MudRadio>
                <MudRadio T="bool" Value="true" Dense="true">
                    @SourceLabel
                </MudRadio>
            </MudRadioGroup>
        </div>

        @if (_target is not null)
        {
            @* Diese Zeile haben Medikament und Klauenbefund nicht - die tragen
               kein Verhaltensflag. Hier ist sie noetig: welche der beiden
               Viertel-Einstellungen bestehen bleibt, entscheidet ueber jede
               kuenftige Behandlung mit diesem Eintrag, und die Antwort ist
               nicht die, die man raet - es gewinnt das ZIEL, auch wenn die
               Quelle gerade offen war. *@
            <div class="mw-kv">
                <span>Viertel-Auswahl danach</span>
                <span class="@(_target.ShowDialog ? "mw-kv__ok" : "mw-kv__sub")">@QuarterAfter</span>
            </div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="mw-btn mw-btn--plain mw-btn--wide" @onclick="Cancel">
            Abbrechen
        </button>
        <button type="button" class="mw-btn mw-btn--primary mw-btn--wide"
                disabled="@(_target is null)" @onclick="Merge">
            Zusammenführen
        </button>
    </Footer>
</MeadowDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Der Eintrag, der verschwindet.</summary>
    [Parameter] public WhereHow Source { get; set; } = new();

    /// <summary>Optionale Vorbelegung des Ziels; im Dialog aenderbar.</summary>
    [Parameter] public WhereHow? Target { get; set; }

    /// <summary>
    /// Behandlungen, geplante Behandlungen und Medikamente, die auf die Quelle
    /// zeigen - steht nur im Beschreibungstext.
    /// </summary>
    [Parameter] public int SourceUsageCount { get; set; }

    private WhereHow? _target;
    private string _targetName = "";
    private bool _keepSourceName;

    private string SourceLabel => $"„{Source.WhereHowName}\" behalten (bisheriger Name)";

    private string TargetLabel => _target is null
        ? "Name des Ziels behalten"
        : $"„{_target.WhereHowName}\" behalten";

    private string QuarterAfter => _target?.ShowDialog == true
        ? "fragt nach dem Euterviertel"
        : "fragt nicht nach dem Euterviertel";

    private string Description
    {
        get
        {
            var usage = SourceUsageCount == 1 ? "1 Verwendung" : $"{SourceUsageCount} Verwendungen";

            return SourceUsageCount == 0
                ? $"„{Source.WhereHowName}\" verschwindet und wird durch das Ziel ersetzt."
                : $"„{Source.WhereHowName}\" hat {usage}. Behandlungen, geplante Behandlungen "
                  + "und Medikamente werden auf das Ziel umgehängt, der Eintrag verschwindet danach.";
        }
    }

    protected override void OnInitialized()
    {
        _target = Target;
        _targetName = Target?.WhereHowName ?? "";
    }

    private void OnTargetChanged(string? value)
    {
        _targetName = value ?? "";

        _target = WhereHowService.WhereHows.Values.FirstOrDefault(w =>
            w.WhereHowId != Source.WhereHowId
            && string.Equals(w.WhereHowName.Trim(), _targetName.Trim(), StringComparison.OrdinalIgnoreCase));
    }

    private Task<IEnumerable<string>> SearchTargets(string value, CancellationToken token)
    {
        // Sich selbst ausnehmen: ein Merge auf sich selbst wuerde erst
        // umhaengen und dann genau das Ziel loeschen. Der Service faengt das
        // ab, aber die Auswahl soll es nicht erst anbieten.
        var names = WhereHowService.WhereHows.Values
            .Where(w => w.WhereHowId != Source.WhereHowId)
            .Select(w => w.WhereHowName)
            .Distinct()
            .OrderBy(n => n, StringComparer.CurrentCulture);

        return Task.FromResult<IEnumerable<string>>(string.IsNullOrWhiteSpace(value)
            ? names
            : names.Where(n => n.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Merge()
    {
        if (_target is null)
        {
            Snackbar.Add("Bitte ein Ziel wählen.", Severity.Error);
            return;
        }

        var survivingName = _keepSourceName ? Source.WhereHowName : null;

        if (!await WhereHowService.MergeAsync(Source.WhereHowId, _target.WhereHowId, survivingName))
        {
            Snackbar.Add("Zusammenführen fehlgeschlagen.", Severity.Error);
            return;
        }

        var finalName = survivingName ?? _target.WhereHowName;
        Snackbar.Add($"Zusammengeführt zu „{finalName}\".", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }
}
