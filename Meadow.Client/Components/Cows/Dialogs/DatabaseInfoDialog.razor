@using Meadow.Client.Components.Ui
@using Meadow.Client.Components.Services
@implements IDisposable

@inject IConfiguration Configuration
@inject DatabaseConnectionState ConnectionState
@inject ICowSyncService CowSync
@inject DemoSettings Demo

<MeadowDialog Title="Datenbank Informationen" Size="MeadowDialogSize.Info">
    <ChildContent>
        <div class="@StatusClass">
            <span class="mw-status__dot"></span>
            <span class="mw-status__text">
                @(ConnectionState.IsConnected ? "Datenbank verbunden" : "Keine Verbindung")
            </span>
        </div>

        <div class="mw-kv"><span>Server</span><span class="mw-kv__mono">@Server</span></div>
        <div class="mw-kv"><span>Datenbank</span><span class="mw-kv__mono">@Database</span></div>

        @if (CowSync.Source == CowSyncSource.XLink)
        {
            <div class="mw-kv">
                <span>XLink Scraper</span>
                <span class="@XLinkClass">@XLinkStatus</span>
            </div>
            @* Ohne laufenden Sync sagt die Adresse nichts aus. *@
            @if (!Demo.Enabled)
            {
                <div class="mw-kv__sub">@XLinkUrl</div>
            }
        }
        else
        {
            <div class="mw-kv">
                <span>Horizon-Agent</span>
                <span class="@AgentClass">@AgentStatus</span>
            </div>
            @if (!Demo.Enabled)
            {
                <div class="mw-kv__sub">
                    Version @(CowSync.AgentVersion ?? "—") · @(CowSync.AgentMachineName ?? "unbekannter Rechner")
                </div>
                @if (!string.IsNullOrWhiteSpace(AgentError))
                {
                    <div class="mw-kv__sub">Letzter Fehler: @AgentError</div>
                }
            }
        }
    </ChildContent>
</MeadowDialog>

@code {
    // Program.cs liest diese Werte ueber builder.Configuration MIT Fallback.
    // Der Dialog nutzte Environment.GetEnvironmentVariable und zeigte damit
    // leer an, waehrend die App laengst verbunden war.
    private string Server => Configuration["DB_SERVER"] ?? "127.0.0.1";
    private string Database => Configuration["DB_DB"] ?? "4cows_v2";

    // Ebenfalls ueber Configuration, aus demselben Grund - und der ist hier
    // sogar zwingender: Environment.GetEnvironmentVariable liefert im Browser
    // IMMER null, weil es dort keine Prozessumgebung gibt. Der Dialog zeigte
    // damit auf jeder Instanz die eingebauten Rueckfallwerte an, also
    // "http://192.168.50.9/Xlink/" und 24 Stunden, ganz gleich was der Server
    // wirklich benutzt. Auf main lief derselbe Code im Serverprozess und
    // lieferte die echten Werte - die Zeile ist beim Umzug in den Browser
    // stillschweigend falsch geworden.
    //
    // /api/system/info gibt beide Werte unter genau diesen Schluesseln aus;
    // Program.cs laedt sie beim Start in die Konfiguration.
    private string XLinkUrl =>
        Configuration["XLinkUrl"] ?? "http://192.168.50.9/Xlink/";

    private double IntervalHours =>
        double.TryParse(Configuration["XLinkSyncIntervalHours"], out var h) && h > 0
            ? h
            : 24;

    private string StatusClass =>
        ConnectionState.IsConnected ? "mw-status mw-status--ok" : "mw-status mw-status--bad";

    private string XLinkClass =>
        !Demo.Enabled && CowSync.LastSyncUtc is not null && !CowSync.LastSyncSucceeded
            ? "mw-kv__bad"
            : "mw-kv__ok";

    private string XLinkStatus
    {
        get
        {
            // Im Demo-Modus registriert Program.cs den CowSyncBackgroundService
            // gar nicht erst - er wuerde jede Demo-Kuh als abgegangen markieren,
            // weil der Scraper sie nicht liefert. "aktiv ... noch kein Abgleich"
            // waere hier also schlicht falsch.
            if (Demo.Enabled)
            {
                return "im Demo-Modus deaktiviert";
            }

            var interval = $"alle {IntervalHours:0.##} h";

            if (CowSync.LastSyncUtc is null)
            {
                return $"aktiv · {interval} · noch kein Abgleich";
            }

            var when = CowSync.LastSyncUtc.Value.ToLocalTime().ToString("dd.MM. HH:mm");
            return CowSync.LastSyncSucceeded
                ? $"aktiv · zuletzt {when}"
                : $"Fehler · zuletzt {when}";
        }
    }

    /// <summary>
    /// Ohne Lebenszeichen innerhalb dieser Spanne gilt der Agent als offline.
    /// Sein Takt liegt deutlich darunter.
    /// </summary>
    private static readonly TimeSpan HeartbeatTimeout = TimeSpan.FromMinutes(5);

    private string? AgentError =>
        string.IsNullOrWhiteSpace(CowSync.AgentLastError) ? CowSync.LastSyncError : CowSync.AgentLastError;

    private bool AgentOnline =>
        CowSync.LastHeartbeatUtc is { } beat
        && DateTimeOffset.UtcNow - beat <= HeartbeatTimeout;

    private string AgentClass =>
        Demo.Enabled || (AgentOnline && (CowSync.LastSyncUtc is null || CowSync.LastSyncSucceeded))
            ? "mw-kv__ok"
            : "mw-kv__bad";

    private string AgentStatus
    {
        get
        {
            // Wie bei XLink: im Demo-Modus laeuft gar kein Abgleich.
            if (Demo.Enabled)
            {
                return "im Demo-Modus deaktiviert";
            }

            if (!AgentOnline)
            {
                return "Agent offline";
            }

            if (CowSync.LastSyncUtc is null)
            {
                return "verbunden · noch kein Snapshot";
            }

            var when = CowSync.LastSyncUtc.Value.ToLocalTime().ToString("dd.MM. HH:mm");
            if (!CowSync.LastSyncSucceeded)
            {
                return $"Fehler · zuletzt {when}";
            }

            var count = CowSync.LastSnapshotAnimalCount;
            return count is null
                ? $"aktiv · zuletzt {when}"
                : $"aktiv · zuletzt {when} · {count} Tiere";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ConnectionState.ConnectionStateChanged += OnConnectionChanged;

        try
        {
            await CowSync.LoadStatusAsync();
        }
        catch (Exception e)
        {
            // Der Dialog zeigt dann den zuletzt bekannten Stand.
            Console.Error.WriteLine($"Status des Kuh-Abgleichs nicht lesbar: {e.Message}");
        }

        await ConnectionState.EnsureLatestStatusAsync();
    }

    private void OnConnectionChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => ConnectionState.ConnectionStateChanged -= OnConnectionChanged;
}
