@using Meadow.Client.Components.Ui
@using Meadow.Shared.Models
@using Meadow.Shared.Kpi
@using Blazor.AceEditorJs
@using Meadow.Client.Components.Services

@inject IKPIService KPIService
@inject IDialogService DialogService
@inject KpiRowProvider RowProvider
@inject ThemeState Theme

@*
    Der KPI-Dialog. Standardweg ist das gefuehrte Formular
    (MeadowKpiBuilder); der frueher einzige SQL-Editor lebt als
    Expertenmodus weiter.

    Bestehende KPIs mit handgeschriebenem Skript oeffnen direkt im Editor -
    sie sollen in der Form editierbar bleiben, in der sie geschrieben wurden.

    Das URL-Feld erscheint nur noch im Expertenmodus. Builder-KPIs LEITEN ihr
    Klick-Ziel aus der Definition ab (KpiDrillDownUrl), inklusive der Filter -
    frueher war es Freitext, und ein Tippfehler fuehrte still ins 404.

    Beim ANLEGEN steht zuerst die Vorlagenauswahl. Das Formular startete
    bisher leer, obwohl KpiSeeds sieben fertige Definitionen kennt - und die
    erste Frage beim Anlegen ist nun mal nicht "welche Datenquelle", sondern
    "so etwas wie was".

    Der Sortier-Index ist weg. Zwei Bedienelemente fuer dieselbe Eigenschaft,
    von denen eines Duplikate erlaubt, waren die Ursache der beliebigen
    Reihenfolge und nicht ihr Symptom - sortiert wird jetzt in der Liste.
*@
<MeadowDialog Title="@(IsSave ? "KPI hinzufügen" : "KPI bearbeiten")" Size="MeadowDialogSize.Split"
              OnClose="TryCancelAsync">
    <ChildContent>
        @if (ShowTemplates)
        {
            <MeadowKpiTemplates Chosen="UseTemplate" />
        }
        else
        {
            <div>
                <label class="mw-label" for="mw-kpi-title">
                    Titel
                    <MeadowHelp For="Titel" Text="Steht als Überschrift auf der Kachel und ist der Name,
                                unter dem du die Kennzahl in der Liste wiederfindest." />
                </label>
                <div class="@TitleFieldClass">
                    <MudTextField T="string" InputId="mw-kpi-title" Variant="Variant.Text"
                                  @ref="_titleField"
                                  Value="@KPI.Title" ValueChanged="OnTitleChanged"
                                  OnBlur="ValidateTitle"
                                  aria-invalid="@(_titleError.Length > 0)"
                                  aria-describedby="mw-kpi-title-err"
                                  Placeholder="z.B. Offene Verbände" />
                </div>
                @if (_titleError.Length > 0)
                {
                    <p class="mw-field-error" id="mw-kpi-title-err">@_titleError</p>
                }
            </div>

            <div class="mw-check-bar">
                <span class="mw-label">@(_expert ? "Eigenes SQL" : "Definition")</span>
                <div>
                    @if (_expert)
                    {
                        <button type="button" class="mw-btn mw-btn--ghost mw-btn--sm"
                                disabled="@_checking" @onclick="CheckScript">
                            @(_checking ? "Wird geprüft…" : "Skript prüfen")
                        </button>
                    }
                    <button type="button" class="mw-btn mw-btn--ghost mw-btn--sm" @onclick="ToggleExpert">
                        @(_expert ? "Zum Formular" : "Expertenmodus: eigenes SQL")
                    </button>
                </div>
            </div>

            @if (_expert)
            {
                @if (!IsSave && KPI.IsBuilder)
                {
                    <p class="mw-hint mw-hint--warn">
                        Diese KPI ist als Formular definiert. Speichern im Expertenmodus ersetzt sie
                        durch das Skript unten; die Definition bleibt gespeichert, wird aber nicht
                        mehr ausgewertet. Zielwert und Verlauf entstehen aus der Definition und
                        gelten deshalb nur im Formularmodus.
                    </p>
                }

                @if (_scriptKept)
                {
                    @* Nicht stillschweigend ueberschreiben: hier steht ein Skript, das nicht aus dem
                       Formular kommt - selbst geschrieben oder von der Umstellung aufbewahrt. Ein
                       Ausflug ins Formular soll es nicht kosten. *@
                    <div class="mw-check-bar">
                        <span class="mw-hint">
                            Das Skript unten stammt nicht aus dem Formular und wurde deshalb behalten.
                        </span>
                        <div>
                            <button type="button" class="mw-btn mw-btn--ghost mw-btn--sm"
                                    @onclick="RegenerateSql">
                                Aus Formular neu erzeugen
                            </button>
                        </div>
                    </div>
                }

                <div>
                    <label class="mw-label" for="mw-kpi-url">
                        URL
                        <MeadowHelp For="URL" Text="Wohin ein Klick auf die Kachel führt. Nur im
                                    Expertenmodus von Hand: eine Kennzahl aus dem Formular leitet ihr
                                    Ziel samt Filtern aus der Definition ab." />
                    </label>
                    <div class="mw-field">
                        <MudTextField T="string" InputId="mw-kpi-url" Variant="Variant.Text"
                                      Value="@KPI.Url" ValueChanged="OnUrlChanged"
                                      Placeholder="Klauen_Daten" />
                    </div>
                    @if (_urlWarning.Length > 0)
                    {
                        <p class="mw-hint mw-hint--warn">@_urlWarning</p>
                    }
                </div>

                @* Feste Hoehe per .mw-ace: der Editor misst beim Initialisieren und
                   wuerde in einem flexiblen Container mit Hoehe 0 unbrauchbar.

                   Der @key erzwingt einen Neuaufbau bei Theme-Wechsel: Ace liest
                   sein Theme nur beim Initialisieren.

                   Aus demselben Grund steht _scriptVersion mit im Key: Ace liest
                   auch seinen INHALT nur beim Initialisieren. Wird KPI.Script von
                   C# aus ersetzt ("Aus Formular neu erzeugen"), bekaeme der Editor
                   das sonst nie zu sehen. *@
                <div class="mw-ace">
                    <AceJsEditor @key="(Theme.IsDark, _scriptVersion)" @bind-Value="@KPI.Script"
                                 Options="AceOptions" />
                </div>

                <p class="mw-hint">
                    Nur lesende Abfragen: eine einzelne Anweisung, die mit SELECT oder WITH beginnt.
                    Sie muss eine Zeile mit einer Spalte namens <code>value</code> als Text liefern.
                </p>

                @if (_sqlError.Length > 0)
                {
                    <div class="mw-check-bar">
                        <span class="mw-label">Fehler</span>
                        <div>
                            <button type="button" class="mw-btn mw-btn--ghost mw-btn--sm"
                                    @onclick="() => _expanded = !_expanded">
                                @(_expanded ? "Verbergen" : "Anzeigen")
                            </button>
                        </div>
                    </div>
                    @if (_expanded)
                    {
                        <div class="mw-errbox">@_sqlError</div>
                    }
                }
                else if (_notRun)
                {
                    @* Kein roter Kasten: es ist nichts kaputt. Kpi:AllowScriptValidation ist
                       standardmaessig aus, und das ist richtig so - die Anwendung hat keine
                       Authentifizierung und verbindet als root. Bisher hat die Oberflaeche nur
                       verschwiegen, dass sie aus ist. *@
                    <p class="mw-hint mw-hint--warn">
                        Das Skript ist formal in Ordnung. Ausgeführt wurde es nicht — die
                        Skriptprüfung ist auf diesem Server abgeschaltet
                        (<code>Kpi:AllowScriptValidation</code>).
                    </p>
                }
                else if (_testedValue is not null)
                {
                    <p class="mw-hint">SQL erfolgreich ausgeführt. Ergebnis: @_testedValue</p>
                }
            }
            else
            {
                @* Zwei Spalten: links die Einstellung, rechts ihre Wirkung.
                   Untereinander scrollte das eine aus dem Bild, sobald man am anderen drehte -
                   und genau deshalb sah man die Kachel vorher nur als abstrakte Zahl statt als
                   das, was hinterher auf dem Dashboard steht. *@
                <div class="mw-kpi-split">
                    <div class="mw-kpi-split__form">
                        <MeadowKpiBuilder Definition="_definition" Rows="_rows"
                                          Changed="OnDefinitionChanged" />
                    </div>

                    <aside class="mw-kpi-split__side">
                        <MeadowKpiPreview Result="Preview" Definition="_definition"
                                          Series="PreviewSeries" Title="@KPI.Title"
                                          TotalRows="_rows.Count" />

                        @* Dieselbe Auswahl, als SQL. Nicht nur zum Nachlesen: der Expertenmodus
                           uebernimmt genau dieses Skript, man startet dort also nicht bei null.

                           Erzeugt wird es aus derselben Definition, aus der die Kachel daneben
                           rechnet, und es liefert nachweislich denselben Wert - inklusive der
                           deutschen Zahlenformatierung und der Einheit. *@
                        <div class="mw-kpi-split__sql">
                            <span class="mw-label">Als SQL</span>
                            <pre class="mw-sqlbox">@Script.Annotated</pre>
                        </div>
                    </aside>
                </div>
            }

            @if (_saveError.Length > 0)
            {
                <div class="mw-errbox">@_saveError</div>
            }
        }
    </ChildContent>
    <Footer>
        @if (ShowTemplates)
        {
            <button type="button" class="mw-btn mw-btn--plain mw-btn--wide" @onclick="TryCancelAsync">
                Abbrechen
            </button>
        }
        else
        {
            <button type="button" class="mw-btn mw-btn--plain mw-btn--wide" @onclick="TryCancelAsync">
                Abbrechen
            </button>
            <button type="button" class="mw-btn mw-btn--primary mw-btn--wide" @onclick="SaveKPI">
                Speichern
            </button>
        }
    </Footer>
</MeadowDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>
    /// Eine KOPIE der Kennzahl - siehe KPI.Copy() und Settings.OpenKpiDialog. Der Dialog bindet
    /// direkt auf dieses Objekt, und ohne Kopie stuende eine abgebrochene Aenderung trotzdem im
    /// Cache und auf dem Dashboard.
    /// </summary>
    [Parameter] public KPI KPI { get; set; } = new();

    [Parameter] public bool IsSave { get; set; } = true;

    /// <summary>
    /// AceTheme.sqlserver ist hell. Im Dark Mode war der Editor damit die
    /// einzige weisse Flaeche der App - also mitschalten. Die Sprache
    /// bleibt sqlserver.
    /// </summary>
    private AceEditorOptions AceOptions => new()
    {
        IsReadOnly = false,
        Language = AceLanguage.sqlserver,
        Theme = Theme.IsDark ? AceTheme.nord_dark : AceTheme.sqlserver
    };

    private KpiDefinition _definition = new();
    private bool _expert;

    /// <summary>
    /// Die Zeilen der aktuellen Quelle. Der Dialog besitzt sie, nicht das Formular: Vorschau,
    /// Reihe und Filteroptionen brauchen dieselben, und KpiRowProvider ist ausdruecklich nicht
    /// gecacht (siehe seinen Kopfkommentar) - zwei Besitzer hiessen zwei Projektionen pro
    /// Tastendruck.
    /// </summary>
    private IReadOnlyList<KpiRow> _rows = Array.Empty<KpiRow>();

    private KpiSourceId? _rowsFor;

    private KpiSourceInfo Source
        => KpiSourceRegistry.Find(_definition.Source) ?? KpiSourceRegistry.All[0];

    /// <summary>
    /// Live, ohne Knopfdruck und ohne Datenbank: der Evaluator ist eine reine Funktion ueber die
    /// Caches, die ohnehin im Speicher liegen. Das ist der spuerbarste Unterschied zum bisherigen
    /// "SQL testen", das eine DB-Runde gekostet hat und an das man sich erinnern musste.
    /// </summary>
    private KpiResult Preview => KpiEvaluator.Evaluate(_definition, Source, _rows, DateTime.Now);

    /// <summary>
    /// Der Verlauf der Vorschau - nur gerechnet, wenn die Definition ihn auch anfordert. Dieselbe
    /// Zurueckhaltung wie in KpiDashboard: wer weder Linie noch Durchschnitt will, soll sie nicht
    /// bezahlen, und das hier laeuft bei JEDEM Tastendruck im Formular.
    /// </summary>
    private KpiSeries? PreviewSeries
        => _definition.WantsSeries
            ? KpiEvaluator.Series(_definition, Source, _rows, DateTime.Now)
            : null;

    /// <summary>
    /// Dieselbe Definition als SQL. Reine Funktion, also einfach mitberechnet statt gecacht - und
    /// AdoptGeneratedSql ruft dieselbe Funktion auf, sodass die Kachel daneben und das
    /// uebernommene Skript nicht auseinanderlaufen koennen.
    /// </summary>
    private KpiSqlScript Script => KpiSqlBuilder.Build(_definition, Source);

    /// <summary>Das zuletzt aus dem Formular erzeugte Skript - der Vergleichswert dafuer, ob im
    /// Editor etwas von Hand geaendert wurde.</summary>
    private string? _generated;

    /// <summary>Im Editor wurde in diesem Dialog selbst getippt - nur dann wird nicht ueberschrieben.</summary>
    private bool _handEdited;

    private bool _scriptKept;

    /// <summary>Teil des @@key des Ace-Editors - siehe Kommentar dort.</summary>
    private int _scriptVersion;

    private string _sqlError = string.Empty;
    private string _saveError = string.Empty;
    private string _titleError = string.Empty;
    private string _urlWarning = string.Empty;
    private string? _testedValue;
    private bool _notRun;
    private bool _checking;
    private bool _expanded = true;

    private MudTextField<string>? _titleField;

    /// <summary>Beim Anlegen steht die Vorlagenauswahl vor dem Formular.</summary>
    private bool _templateChosen;

    private bool ShowTemplates => IsSave && !_templateChosen;

    /// <summary>
    /// Der Zustand beim Oeffnen, als eine Zeichenkette. Reicht fuer die Frage "hat sich etwas
    /// geaendert" und ist billiger als eine tiefe Kopie zum Vergleichen - und die Definition ist
    /// ohnehin schon als JSON darstellbar.
    /// </summary>
    private string _snapshot = "";

    private bool IsDirty => Fingerprint() != _snapshot;

    private string TitleFieldClass => _titleError.Length > 0 ? "mw-field mw-field--invalid" : "mw-field";

    protected override void OnInitialized()
    {
        _definition = KpiDefinition.Deserialize(KPI.Definition) ?? new KpiDefinition();

        // Eine bestehende SQL-KPI oeffnet in ihrem Editor; alles andere - auch eine neue KPI - im
        // Formular. Neue KPIs bekommen Kind erst beim Speichern gesetzt, denn KpiKind.Sql ist 0
        // und damit der Default eines frischen KPI-Objekts.
        _expert = !IsSave && !KPI.IsBuilder;

        // Beim Bearbeiten gibt es nichts auszuwaehlen, und eine kopierte Kennzahl bringt ihre
        // Definition schon mit - die Vorlagen stehen nur vor einem wirklich leeren Formular.
        _templateChosen = !IsSave || KPI.IsBuilder || !string.IsNullOrWhiteSpace(KPI.Script);

        LoadRows();
        _snapshot = Fingerprint();
    }

    /// <summary>
    /// Holt die Zeilen, wenn sich die Quelle geaendert hat - und nur dann. Die Liste wird als
    /// NEUE Referenz weitergereicht, daran erkennt das Formular, dass es seine Filteroptionen
    /// neu aufbauen muss.
    /// </summary>
    private void LoadRows()
    {
        if (_rowsFor == _definition.Source)
        {
            return;
        }

        _rowsFor = _definition.Source;
        _rows = RowProvider.Rows(_definition.Source);
    }

    private string Fingerprint()
        => string.Join(
            "\n",
            KPI.Title ?? "",
            KPI.Url ?? "",
            KPI.Script ?? "",
            _expert ? "sql" : "builder",
            KpiDefinition.Serialize(_definition));

    private void UseTemplate(KpiSeed? seed)
    {
        if (seed is not null)
        {
            _definition = seed.Definition.Clone();
            if (string.IsNullOrWhiteSpace(KPI.Title))
            {
                KPI.Title = seed.Title;
            }
        }

        _templateChosen = true;
        LoadRows();
        // Der Schnappschuss wird NEU gesetzt: die Vorlage ist der Ausgangspunkt, nicht die erste
        // Aenderung - sonst fragte der Abbrechen-Knopf sofort nach, ob man verwerfen will.
        _snapshot = Fingerprint();
    }

    private void ToggleExpert()
    {
        if (_expert)
        {
            // Beim Verlassen des Editors festhalten, ob dort von Hand getippt wurde. Nur DAS ist
            // schuetzenswert - ein Altskript, das die Migration stehengelassen hat, ist keine
            // Handarbeit, und bei einer Formular-KPI ist die Definition die Wahrheit.
            if (!string.Equals(KPI.Script?.Trim(), _generated?.Trim(), StringComparison.Ordinal))
            {
                _handEdited = true;
            }
        }
        else
        {
            // Beim Wechsel INS SQL: das Formular wird zu SQL uebersetzt, damit man dort nicht bei
            // null anfaengt. Das erzeugte Skript liefert nachweislich denselben Wert wie die
            // Vorschau, es ist also ein Startpunkt und keine Neuinterpretation.
            AdoptGeneratedSql();
        }

        _expert = !_expert;
        ClearCheck();
        _saveError = string.Empty;
    }

    /// <summary>
    /// Uebernimmt das erzeugte SQL in den Editor - ausser der Benutzer hat dort in diesem Dialog
    /// selbst getippt.
    ///
    /// Die Unterscheidung ist wichtig: eine bestehende SQL-KPI oeffnet direkt im Editor und wird
    /// deshalb nie ueberschrieben (es gibt keinen Wechsel HIN zum Editor). Wer dagegen im Formular
    /// baut, will genau das im Editor sehen - auch wenn dort noch ein von der Migration
    /// aufbewahrtes Altskript steht.
    /// </summary>
    private void AdoptGeneratedSql(bool force = false)
    {
        if (!force && _handEdited)
        {
            _scriptKept = true;
            return;
        }

        _generated = Script.Annotated;
        KPI.Script = _generated;
        _scriptKept = false;
        _handEdited = false;
        // Zwingt den Ace-Editor zum Neuaufbau, sonst zeigt er weiter den alten Inhalt.
        _scriptVersion++;
    }

    private void RegenerateSql()
    {
        AdoptGeneratedSql(force: true);
        ClearCheck();
    }

    private void OnDefinitionChanged()
    {
        _saveError = string.Empty;
        LoadRows();
    }

    private void OnTitleChanged(string value)
    {
        KPI.Title = value;
        if (_titleError.Length > 0)
        {
            ValidateTitle();
        }
    }

    private void OnUrlChanged(string value)
    {
        KPI.Url = value;

        // Warnung, kein Speicherverbot: ein handgeschriebenes Skript darf bewusst irgendwohin
        // zeigen, und die Adresse kann auch von einer anderen Installation stammen.
        _urlWarning = string.IsNullOrWhiteSpace(value) || MeadowRoutes.Exists(value)
            ? string.Empty
            : "Diese Adresse gehört zu keiner Seite der Anwendung — der Klick auf die Kachel landet im 404.";
    }

    private void ValidateTitle()
        => _titleError = string.IsNullOrWhiteSpace(KPI.Title)
            ? "Ohne Titel wäre die Kachel nicht zu erkennen."
            : string.Empty;

    private void ClearCheck()
    {
        _sqlError = string.Empty;
        _testedValue = null;
        _notRun = false;
    }

    private async Task TryCancelAsync()
    {
        if (!IsDirty)
        {
            MudDialog.Cancel();
            return;
        }

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters<GenericDialog>
        {
            { x => x.HeaderText, "Änderungen verwerfen?" },
            { x => x.Description, "Die Änderungen an dieser Kennzahl sind noch nicht gespeichert." },
            { x => x.AcceptButtonText, "Verwerfen" },
            { x => x.CancelButtonText, "Weiter bearbeiten" },
            { x => x.ColorScheme, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<GenericDialog>(string.Empty, parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            MudDialog.Cancel();
        }
    }

    private async Task CheckScript()
    {
        ClearCheck();
        _checking = true;

        try
        {
            // Das Skript AUS DEM EDITOR, nicht die gespeicherte Zeile: der alte Knopf rief den
            // Wert-Endpunkt fuer KPI.KPIId ab, und bei einer neuen Kennzahl gab es die noch nicht.
            var check = await KPIService.CheckScriptAsync(KPI.Script);

            if (check.Rejection is not null)
            {
                _sqlError = check.Rejection;
                _expanded = true;
            }
            else if (check.NotRun)
            {
                _notRun = true;
            }
            else
            {
                _testedValue = check.Value;
            }
        }
        catch (Exception e)
        {
            _sqlError = e.Message;
            _expanded = true;
        }
        finally
        {
            _checking = false;
        }
    }

    private async Task SaveKPI()
    {
        _saveError = string.Empty;

        ValidateTitle();
        if (_titleError.Length > 0)
        {
            // Der Fokus springt zum Feld: die Fehlerbox stand frueher am Ende des scrollenden
            // Koerpers und konnte ausserhalb des Sichtbereichs liegen.
            if (_titleField is not null)
            {
                await _titleField.FocusAsync();
            }

            return;
        }

        if (_expert)
        {
            // Vor dem Speichern pruefen, nicht erst vor dem Ausfuehren: sonst legt man eine Kachel
            // an, die dauerhaft "--" zeigt, und erfaehrt den Grund nie.
            var rejection = KpiScriptGuard.Reject(KPI.Script);
            if (rejection is not null)
            {
                _saveError = rejection;
                return;
            }

            KPI.Kind = (int)KpiKind.Sql;
        }
        else
        {
            var source = KpiSourceRegistry.Find(_definition.Source);
            var preview = source is null
                ? KpiResult.Failed("Unbekannte Datenquelle.")
                : KpiEvaluator.Evaluate(_definition, source, Array.Empty<KpiRow>(), DateTime.Now);

            if (preview.State == KpiResultState.Error)
            {
                _saveError = preview.Message ?? "Diese Definition lässt sich nicht auswerten.";
                return;
            }

            KPI.Kind = (int)KpiKind.Builder;
            KPI.Definition = KpiDefinition.Serialize(_definition);
            // Nur ein Rueckfall, falls die Definition einmal unlesbar wird - den echten Link samt
            // Filtern baut KpiDrillDownUrl aus der Definition.
            KPI.Url = source!.Route;
            // Ein vom Kunden geschriebenes Skript wird NICHT geloescht: damit bleibt der Wechsel
            // in den Expertenmodus umkehrbar. Ausgefuehrt wird es nicht mehr.
        }

        var saved = IsSave
            ? await KPIService.InsertDataAsync(KPI)
            : await KPIService.UpdateDataAsync(KPI);

        if (!saved)
        {
            _saveError = "Speichern fehlgeschlagen. Prüfe die Datenbankverbindung.";
            return;
        }

        MudDialog.Close(DialogResult.Ok(true));
    }
}
