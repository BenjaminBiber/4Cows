@inherits LayoutComponentBase
@implements IDisposable

@using Meadow.Client.Components.Ui
@using Meadow.Client.Components.Services

@inject NavigationManager Nav
@inject LayoutState Layout
@inject ThemeState Theme
@inject MeadowDialogLauncher Launcher

<PageTitle>@Title · Meadow</PageTitle>

@* MudBlazor bleibt als Wirt fuer Dialoge, Snackbars und die Formular-Popover.
   MudThemeProvider ist nicht das, was die App dunkel macht - das erledigt das
   data-mw-theme-Attribut. Er wird trotzdem gebunden, damit Muds C#-seitige
   Schattierungen zum Theme passen. *@
<MudThemeProvider IsDarkMode="@Theme.IsDark" Theme="@MeadowMudTheme.Instance" />
<MudPopoverProvider />
<MudDialogProvider Position="DialogPosition.Center" CloseOnEscapeKey="true" BackdropClick="true" />
<MudSnackbarProvider />

<div class="mw-shell">
    <MeadowHeader PageTitle="@Title"
                  Subtitle="@Layout.PageSubtitle"
                  Tags="@Layout.PageTags"
                  BackHref="@Layout.PageBackHref"
                  HomeHref="@_home"
                  HasSiblings="@_hasSiblings"
                  IsDark="@Theme.IsDark"
                  OnMenu="@Layout.ToggleDrawer"
                  OnTitle="@OnTitleClick"
                  OnInfo="@OpenInfo"
                  OnToggleTheme="@Theme.ToggleAsync" />

    @* Direkt unter dem Kopf und damit auf JEDER Seite. Wer im Stall eine
       Klauenbehandlung erfasst, sieht das Dashboard den ganzen Tag nicht -
       ein Band nur dort waere ein Band fuer niemanden. *@
    <MeadowSyncBand />

    <div class="mw-body">
        <MeadowDrawer Open="@Layout.DrawerOpen" OnClose="@Layout.CloseAll" OnInfo="OpenInfo" />

        <main class="mw-content mw-scroll">
            <div class="mw-content-inner @(_wide ? "mw-content-inner--wide" : null)">
                @Body
            </div>
        </main>
    </div>

    <MeadowTabbar Route="@_route" FabTitle="@_fabTitle" OnFab="@OnFab" />
</div>

<MeadowPageMenu Open="@Layout.PageMenuOpen" Route="@_route" OnClose="@Layout.CloseAll" />
<MeadowAddMenu Open="@Layout.AddMenuOpen" OnClose="@Layout.CloseAll" />

@code {
    private string _route = "";
    private string _routeTitle = "Dashboard";

    /// <summary>Ziel des Titels im Kopf, oder null auf dem Dashboard selbst.</summary>
    private string? _home;
    private string _fabTitle = "Hinzufügen";
    private bool _hasSiblings;
    private bool _wide;

    /// <summary>
    /// Der Titel der Seite: was sie selbst angemeldet hat, sonst der aus der
    /// Route.
    ///
    /// Bewusst eine Eigenschaft und kein in ReadRoute berechnetes Feld. Die
    /// Kuh-Seite ruft SetPageHeading beim Aufbauen ihrer Daten auf, also NACH
    /// ReadRoute; ein Feld haette den alten Wert dann schon uebernommen, und
    /// das StateHasChanged aus dem Changed-Ereignis rendere ihn nur noch
    /// einmal.
    /// </summary>
    private string Title => Layout.PageTitleOverride ?? _routeTitle;

    protected override void OnInitialized()
    {
        ReadRoute();
        Layout.Changed += OnStateChanged;
        Theme.Changed += OnStateChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Erst hier gibt es JS. Das Attribut steht dank des Inline-Skripts
            // in index.html schon vor dem ersten Paint; nachgelesen wird es nur,
            // damit MudThemeProvider denselben Zustand kennt.
            await Theme.InitializeAsync();
        }
    }

    private void ReadRoute()
    {
        _route = MeadowRoutes.Normalize(Nav.ToBaseRelativePath(Nav.Uri));
        _routeTitle = MeadowRoutes.TitleFor(_route);
        _home = MeadowRoutes.HomeFor(_route);
        _hasSiblings = MeadowRoutes.HasSiblings(_route);
        _fabTitle = MeadowDialogLauncher.FabTitleFor(_route);
        _wide = MeadowRoutes.IsWide(_route);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // VOR ReadRoute: sonst traegt die neue Seite fuer einen Moment den
        // Titel der alten - und auf einer Nicht-Kuh-Seite stuende sonst noch
        // die Ohrmarke des zuletzt geoeffneten Tiers im Kopf. Die Kuh-Seite
        // setzt ihren Kopf gleich danach wieder.
        Layout.SetPageHeading(null);
        ReadRoute();
        // Jede Navigation schliesst Drawer und Mobile-Menues (Prototyp: go()).
        Layout.CloseAll();
        StateHasChanged();
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void OnTitleClick()
    {
        if (_hasSiblings)
        {
            Layout.TogglePageMenu();
        }
    }

    private Task OpenInfo()
    {
        Layout.CloseAll();
        return Launcher.OpenDatabaseInfoAsync();
    }

    private Task OnFab()
    {
        var action = Launcher.FabActionFor(_route);
        if (action is null)
        {
            Layout.ToggleAddMenu();
            return Task.CompletedTask;
        }

        Layout.CloseAll();
        return action();
    }

    public void Dispose()
    {
        Layout.Changed -= OnStateChanged;
        Theme.Changed -= OnStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
