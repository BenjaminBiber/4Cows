@page "/app"
@implements IDisposable

@using Meadow.Client.Components.Cows.Dialogs
@using Meadow.Client.Components.Ui
@using Meadow.Client.Components.Services
@using Meadow.Shared.Kpi
@using Meadow.Shared.Models

@inject IDialogService DialogService
@inject IJSRuntime JS
@inject MeadowDataLoader Data
@inject MeadowDialogLauncher Launcher
@inject MeadowDataChanges Changes
@inject ThemeState Theme
@inject ICowTreatmentService cowTreatmentService
@inject IClawTreatmentService clawTreatmentService
@inject IMedicineService medicineService
@inject IKPIService KPIService
@inject DatabaseConnectionState DatabaseConnectionState

<div class="mw-dash-top">
    @* Drei Zustaende statt eines stillen Nichts: bisher startete _kpis als leere
       Liste, und waehrend des Ladens - sowie dauerhaft bei null Kennzahlen -
       war der Bereich schlicht leer. *@
    @if (_kpisLoading)
    {
        <div class="mw-kpi-grid">
            @for (var i = 0; i < 4; i++)
            {
                <div class="mw-kpi mw-kpi--skeleton" aria-hidden="true"></div>
            }
        </div>
        <span class="mw-sr-only" role="status">Kennzahlen werden geladen…</span>
    }
    else if (_tiles.Count == 0)
    {
        <div class="mw-kpi-empty">
            <p>Noch keine Kennzahlen angelegt.</p>
            <a class="mw-btn mw-btn--primary" href="@MeadowRoutes.SettingsKpis">
                Die erste Kennzahl anlegen
            </a>
        </div>
    }
    else
    {
        <div class="@GridClass">
            @foreach (var tile in _tiles)
            {
                <MeadowKpiTile Title="@tile.Kpi.Title"
                               Value="@tile.Result.Display"
                               Href="@KpiDrillDown.Href(tile)"
                               IsAddTile="@tile.IsAddTile"
                               Delta="@tile.Result.DeltaDisplay"
                               Trend="@tile.Result.Trend"
                               Status="@tile.Result.Status"
                               Series="@SeriesOf(tile)"
                               SeriesDisplay="@SeriesDisplayOf(tile)"
                               Average="@AverageOf(tile)"
                               AverageLabel="@AverageLabelOf(tile)"
                               DetailHref="@DetailHref(tile)"
                               HasError="@(tile.Result.State == KpiResultState.Error)"
                               Hint="@tile.Result.Message" />
            }
        </div>

        @* Mobil blendet das Grid ab der fuenften Kachel aus. Das war bisher eine
           Sackgasse: Kachel 5 bis 8 waren auf dem Telefon nicht erreichbar, ohne
           dass irgendetwas darauf hingewiesen haette. *@
        @if (_tiles.Count > MobileVisible)
        {
            <button type="button" class="mw-kpi-more" aria-expanded="@_showAllTiles"
                    @onclick="() => _showAllTiles = !_showAllTiles">
                @(_showAllTiles ? "Weniger zeigen" : $"Alle {_tiles.Count} Kacheln zeigen")
            </button>
        }
    }

    @* Vier Aktionen auf Desktop, zwei mobil: dort deckt der FAB in der
       Tabbar die geplanten Behandlungen ab.

       Sortiert nach TIER, nicht nach "erfasst/geplant": erst beide Kuh-, dann
       beide Klauen-Aktionen. Wer zur Kuh greift, sucht die geplante Kuhgabe
       direkt darunter und nicht zwei Knoepfe weiter. Die Farbe traegt dieselbe
       Gruppierung - Kuh teal, Klaue blau -, und damit steht jetzt Paar unter
       Paar statt abwechselnd. Dieselbe Reihenfolge wie im Hinzufuegen-Menue
       ueber dem FAB (MeadowAddMenu). *@
    <div class="mw-dash-actions">
        <MeadowActionButton Label="Kuh Behandlung hinzufügen"
                            Icon="MeadowIconName.Cow"
                            Teal="true"
                            OnClick="@Launcher.OpenCowTreatmentAsync" />

        <MeadowActionButton Label="Geplante Kuh Behandlung"
                            Icon="MeadowIconName.PlannedCow"
                            Teal="true"
                            Class="mw-only-desktop"
                            OnClick="@Launcher.OpenPlannedCowTreatmentAsync" />

        <MeadowActionButton Label="Klauen Behandlung hinzufügen"
                            Icon="MeadowIconName.Claw"
                            Class="mw-act--group"
                            OnClick="@Launcher.OpenClawTreatmentAsync" />

        <MeadowActionButton Label="Geplante Klauen Behandlung"
                            Icon="MeadowIconName.PlannedClaw"
                            Class="mw-only-desktop"
                            OnClick="@Launcher.OpenPlannedClawTreatmentAsync" />
    </div>
</div>

<div class="mw-dash-charts">
    <MeadowChartCard Title="@($"Kuh Behandlungen {_selectedYear}")">
        <Tools>
            <button type="button" class="mw-icon-btn-sm" title="Medikamente auswählen"
                    aria-label="Medikamente auswählen" @onclick="OpenChartEditor">
                <MeadowIcon Name="MeadowIconName.Edit" Size="16" />
            </button>
            <button type="button" class="mw-icon-btn-sm" title="Jahr wählen"
                    aria-label="Jahr wählen" @onclick="OpenYearChangeDialog">
                <MeadowIcon Name="MeadowIconName.Calendar" Size="16" />
            </button>
        </Tools>
        <ChildContent>
            <canvas id="CowChart"></canvas>
        </ChildContent>
    </MeadowChartCard>

    <MeadowChartCard Title="@($"Klauen Behandlungen {_selectedYear}")" Class="mw-only-desktop">
        <ChildContent>
            <canvas id="ClawChart"></canvas>
        </ChildContent>
    </MeadowChartCard>
</div>

@if (_chartError is not null)
{
    @* Chart.js kommt vom CDN. Ohne Internet - im Hof-Netz durchaus denkbar -
       fehlt die Bibliothek, und das soll sichtbar sein statt still leer. *@
    <div class="mw-chart-error" role="status">
        Die Diagramme konnten nicht gezeichnet werden. Prüfe, ob die
        Chart.js-Bibliothek erreichbar ist.
    </div>
}

@code {
    // Die Monatsachse zeigt nur den Anfangsbuchstaben (so das Design), der
    // Tooltip den vollen Namen - siehe meadowChart.render.
    private static readonly string[] MonthInitials =
        { "J", "F", "M", "A", "M", "J", "J", "A", "S", "O", "N", "D" };

    private static readonly string[] MonthNames =
    {
        "Januar", "Februar", "März", "April", "Mai", "Juni",
        "Juli", "August", "September", "Oktober", "November", "Dezember"
    };

    /// <summary>Wie viele Kacheln das Grid mobil zeigt, bevor aufgeklappt wird (siehe CSS).</summary>
    private const int MobileVisible = 4;

    private IReadOnlyList<KpiTileModel> _kpis = Array.Empty<KpiTileModel>();

    /// <summary>
    /// Bewusst ein eigenes Flag und nicht "_kpis ist leer": leer heisst waehrend des Ladens etwas
    /// anderes als danach, und genau diese beiden Faelle waren vorher nicht zu unterscheiden.
    /// </summary>
    private bool _kpisLoading = true;

    private bool _showAllTiles;

    /// <summary>Alles ausser der synthetischen "+"-Kachel - die zaehlt nicht als Kennzahl.</summary>
    private List<KpiTileModel> _tiles => _kpis.ToList();

    private string GridClass => _showAllTiles ? "mw-kpi-grid is-expanded" : "mw-kpi-grid";

    /// <summary>
    /// Die Werte des Verlaufs, oder null. KpiDashboard rechnet die Reihe nur, wenn die Definition
    /// sie anfordert - hier wird sie also nur noch weitergereicht.
    /// </summary>
    private IReadOnlyList<double?>? SeriesOf(KpiTileModel tile)
        => tile.Series is { Points.Count: > 0 } series
            ? series.Points.Select(p => p.Value).ToList()
            : null;

    private KpiSeriesDisplay SeriesDisplayOf(KpiTileModel tile)
        => Definition(tile)?.SeriesDisplay ?? KpiSeriesDisplay.None;

    /// <summary>
    /// Nur wenn die Definition ihn auch anfordert. Die Reihe wird oft fuer das Diagramm gerechnet,
    /// ohne dass die zweite Zahl gewuenscht ist - sie steckt dann trotzdem im Ergebnis.
    /// </summary>
    private string? AverageOf(KpiTileModel tile)
        => Definition(tile)?.ShowAverage == true ? tile.Series?.AverageDisplay : null;

    private string? AverageLabelOf(KpiTileModel tile)
        => tile.Series is { } series ? KpiDefinitionSummary.AverageLabel(series.Bucket) : null;

    /// <summary>
    /// Der Verlaufs-Knopf erscheint nur, wenn es dort auch etwas zu sehen gibt - also nicht an der
    /// "+"-Kachel und nicht an einer Kennzahl ohne Reihe.
    /// </summary>
    private string? DetailHref(KpiTileModel tile)
        => tile.IsAddTile || tile.Series is not { Points.Count: > 0 }
            ? null
            : MeadowRoutes.KpiDetailFor(tile.Kpi.KPIId);

    private static KpiDefinition? Definition(KpiTileModel tile)
        => tile.IsAddTile ? null : KpiDefinition.Deserialize(tile.Kpi.Definition);
    private List<int> _selectedMedicines = new();
    private int _selectedYear = DateTime.Now.Year;
    private bool _medicineSubsetActive;
    private bool _rendered;
    private bool _dataReady;
    private bool _chartsDrawn;

    private string? _chartError;

    protected override async Task OnInitializedAsync()
    {
        DatabaseConnectionState.ConnectionStateChanged += OnConnectionChanged;
        Theme.Changed += OnThemeChanged;
        Changes.Changed += OnDataChanged;

        await DatabaseConnectionState.EnsureLatestStatusAsync();

        // Genau ein Ladevorgang. Bisher rief jeder Chart-Neuaufbau GetLists()
        // und damit alle sieben Service-Caches neu - ein Jahreswechsel im
        // Diagramm waren sieben DB-Runden.
        await Data.EnsureDashboardAsync();
        _kpis = await KPIService.GetDashboardAsync();
        _kpisLoading = false;
        _dataReady = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _rendered = true;
        }

        // Gezeichnet wird, sobald die Daten da sind - nicht beim ersten Rendern.
        //
        // Unter Blazor Server war das dasselbe: die Seite wurde prerendert,
        // OnInitializedAsync lief dabei bis zum Ende durch, und der erste
        // interaktive Render hatte die Caches schon gefuellt vorgefunden. In
        // WebAssembly gibt es kein Prerendering. Blazor rendert einmal SOFORT
        // und erst nach den awaits in OnInitializedAsync ein zweites Mal -
        // beim ersten Rendern sind die Caches also leer.
        //
        // Das faellt nicht als Fehler auf: Chart.js zeichnet brav zwoelf
        // Nullen, die Achsen stehen, und das Diagramm sieht aus wie ein Jahr
        // ohne Behandlungen. Nachgestellt und genau so gesehen.
        if (_dataReady && !_chartsDrawn)
        {
            _chartsDrawn = true;
            await RenderChartsAsync();
        }
    }

    // ---- Diagramme ----------------------------------------------------

    /// <summary>
    /// Einziger Einstiegspunkt zum Zeichnen. Chart.js kommt vom CDN und
    /// ChartHelper.js arbeitet mit einem Canvas-Kontext - schlaegt eines
    /// davon fehl, soll das Dashboard ohne Diagramme weiterlaufen statt den
    /// Circuit abzureissen.
    /// </summary>
    private async Task RenderChartsAsync(bool destroyFirst = false)
    {
        if (!_rendered)
        {
            return;
        }

        try
        {
            if (destroyFirst)
            {
                await JS.InvokeVoidAsync("meadowChart.destroy", "CowChart");
                await JS.InvokeVoidAsync("meadowChart.destroy", "ClawChart");
            }

            await RenderCowChartAsync();
            await RenderClawChartAsync();
            _chartError = null;
        }
        catch (JSException ex)
        {
            _chartError = ex.Message;
        }

        StateHasChanged();
    }

    private async Task<ChartTheme> ReadThemeAsync()
    {
        var tokens = await JS.InvokeAsync<Dictionary<string, string>>(
            "meadowTheme.tokens",
            new[] { "primary", "teal", "sage", "blue", "muted", "border" });

        return new ChartTheme(tokens);
    }

    private async Task RenderCowChartAsync()
    {
        var theme = await ReadThemeAsync();

        object[] datasets;
        bool stacked;

        if (_medicineSubsetActive && _selectedMedicines.Count > 0)
        {
            var palette = BuildPalette(theme);
            var i = 0;
            datasets = _selectedMedicines
                .Select(id => new { Id = id, Name = medicineService.GetMedicineNameById(id) })
                .Where(m => !string.IsNullOrEmpty(m.Name) && m.Name != "--")
                .Select(m => (object)new
                {
                    label = m.Name,
                    data = cowTreatmentService.GetCowTreatmentMedicineChartData(m.Id, _selectedYear),
                    backgroundColor = palette[i++ % palette.Count],
                    borderRadius = 5,
                    borderSkipped = "bottom",
                    // Kein borderColor: hier stand
                    // MudBlazor.Color.Primary.ToString(), also der String
                    // "Primary" als CSS-Farbe.
                    borderWidth = 0
                })
                .ToArray();
            stacked = true;
        }
        else
        {
            datasets = new object[]
            {
                new
                {
                    label = "Kuh Behandlungen",
                    data = cowTreatmentService.GetCowTreatmentChartData(_selectedYear),
                    backgroundColor = theme.Primary,
                    borderRadius = 5,
                    borderSkipped = "bottom",
                    borderWidth = 0
                }
            };
            stacked = false;
        }

        await RenderBarChartAsync("CowChart", datasets, theme, stacked, showLegend: stacked);
    }

    private async Task RenderClawChartAsync()
    {
        var theme = await ReadThemeAsync();

        var datasets = new object[]
        {
            new
            {
                label = "Klauen Behandlungen",
                data = clawTreatmentService.GetClawTreatmentChartData(_selectedYear),
                backgroundColor = theme.Teal,
                borderRadius = 5,
                borderSkipped = "bottom",
                borderWidth = 0
            }
        };

        await RenderBarChartAsync("ClawChart", datasets, theme, stacked: false, showLegend: false);
    }

    private async Task RenderBarChartAsync(
        string canvasId, object[] datasets, ChartTheme theme, bool stacked, bool showLegend)
    {
        var config = new
        {
            type = "bar",
            data = new
            {
                labels = MonthInitials,
                datasets
            },
            options = new
            {
                responsive = true,
                maintainAspectRatio = false,
                interaction = new { intersect = false, mode = "index" },
                scales = new
                {
                    x = new
                    {
                        stacked,
                        grid = new { display = false },
                        border = new { color = theme.Border },
                        ticks = new { color = theme.Muted, font = new { size = 10 } }
                    },
                    y = new
                    {
                        stacked,
                        beginAtZero = true,
                        grid = new { color = theme.Border },
                        border = new { display = false },
                        ticks = new { color = theme.Muted, precision = 0, font = new { size = 10 } }
                    }
                },
                plugins = new
                {
                    legend = new
                    {
                        display = showLegend,
                        labels = new { color = theme.Muted, boxWidth = 12, font = new { size = 11 } }
                    }
                }
            }
        };

        await JS.InvokeVoidAsync("meadowChart.render", canvasId, config, MonthNames);
    }

    private List<string> BuildPalette(ChartTheme theme)
    {
        // Erst die Markenfarben, dann die bisherigen Pastelltoene als
        // Auffuellung fuer viele gleichzeitig gewaehlte Medikamente.
        var palette = new List<string> { theme.Primary, theme.Teal, theme.Sage, theme.Blue };
        var random = new Random(4711); // fester Seed: gleiche Farben pro Medikament-Reihenfolge
        while (palette.Count < 33)
        {
            var candidate = $"#{random.Next(90, 150):X2}{random.Next(140, 200):X2}{random.Next(160, 220):X2}";
            if (!palette.Contains(candidate))
            {
                palette.Add(candidate);
            }
        }

        return palette;
    }

    // ---- Dialoge ------------------------------------------------------

    private async Task OpenChartEditor()
    {
        var parameters = new DialogParameters<ChartEditorDialog>
        {
            { x => x.Medicines, _selectedMedicines }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            BackdropClick = false
        };

        var dialog = await DialogService.ShowAsync<ChartEditorDialog>(
            "Diagramm bearbeiten", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not HashSet<int> selected)
        {
            return;
        }

        _selectedMedicines = selected.ToList();

        // Sind alle Medikamente gewaehlt, ist die Aufschluesselung
        // bedeutungslos - dann zurueck auf die Gesamtsumme.
        var allMedicines = medicineService.GetMedicineNames().Distinct().Count();
        _medicineSubsetActive = _selectedMedicines.Count > 0
                                && _selectedMedicines.Count < allMedicines;

        await RenderChartsAsync(destroyFirst: true);
    }

    private async Task OpenYearChangeDialog()
    {
        var parameters = new DialogParameters<ChartDateDialog> { { x => x.Year, _selectedYear } };

        var dialog = await DialogService.ShowAsync<ChartDateDialog>("Jahr wählen", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not int year)
        {
            return;
        }

        _selectedYear = year;
        await RenderChartsAsync(destroyFirst: true);
    }

    // ---- Zustand ------------------------------------------------------

    private void OnConnectionChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// Die vier Aktionsknoepfe dieser Seite legen Behandlungen an - Kacheln
    /// und Diagramme zaehlen genau die. Ohne dieses Nachladen stand der
    /// eigene Neuzugang bis zum Seitenwechsel nicht in den Zahlen.
    ///
    /// Ohne Unterscheidung nach Art: jede der vier Arten geht in mindestens
    /// eine Kachel ein, und EnsureDashboardAsync laedt sowieso alles.
    /// </summary>
    private void OnDataChanged(MeadowDataKind kind) => _ = InvokeAsync(async () =>
    {
        await Data.EnsureDashboardAsync();
        _kpis = await KPIService.GetDashboardAsync();
        _kpisLoading = false;
        StateHasChanged();
        await RenderChartsAsync(destroyFirst: true);
    });

    private void OnThemeChanged() => _ = InvokeAsync(async () =>
    {
        // Achsen-, Gitter- und Balkenfarben stecken in der Chart.js-Config,
        // nicht im CSS - beim Themenwechsel muss neu gezeichnet werden.
        StateHasChanged();
        await RenderChartsAsync(destroyFirst: true);
    });

    public void Dispose()
    {
        DatabaseConnectionState.ConnectionStateChanged -= OnConnectionChanged;
        Theme.Changed -= OnThemeChanged;
        Changes.Changed -= OnDataChanged;
    }

    private sealed record ChartTheme(
        string Primary, string Teal, string Sage, string Blue, string Muted, string Border)
    {
        public ChartTheme(IReadOnlyDictionary<string, string> tokens) : this(
            Pick(tokens, "primary", "#2C7DA0"),
            Pick(tokens, "teal", "#619B98"),
            Pick(tokens, "sage", "#8DC2B0"),
            Pick(tokens, "blue", "#60ADC9"),
            Pick(tokens, "muted", "#6c7b78"),
            Pick(tokens, "border", "#e6ecea"))
        {
        }

        private static string Pick(IReadOnlyDictionary<string, string> tokens, string key, string fallback)
            => tokens.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value)
                ? value
                : fallback;
    }
}
