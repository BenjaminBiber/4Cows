@page "/Settings"

@using Meadow.Client.Components.Cows.Dialogs
@using Meadow.Client.Components.Cows.BaseData
@using Meadow.Client.Components.Ui
@using Meadow.Client.Components.Services
@using Meadow.Shared.Kpi

@inject IKPIService KPIService
@inject ISettingsService Defaults
@inject MeadowDataLoader Data
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject Meadow.Client.Services.PushService Push

<div class="mw-tabs">
    @foreach (var tab in Tabs)
    {
        <button type="button" class="mw-tab @(_tab == tab ? "is-active" : "")"
                @onclick="() => SelectTab(tab)">
            @tab
        </button>
    }
</div>

@if (_tab == TabKpi)
{
    @* Die einzige Tabelle der App ohne Suche - und ausgerechnet die, in der man nach "was
       filtert eigentlich auf Penicillin" sucht. Gesucht wird deshalb ueber Titel UND
       Definitionstext, nicht nur ueber den Namen. *@
    <div class="mw-toolbar">
        <MeadowSearchBox Value="@_kpiSearch" ValueChanged="OnKpiSearchChanged"
                         Placeholder="KPI suchen…" AriaLabel="Kennzahlen durchsuchen" />
    </div>

    <MeadowTable TItem="KPI" Items="FilteredKpis" Columns="_kpiColumns"
                 RowKey="@(k => k.KPIId)"
                 DefaultSortTitle="Sortierung"
                 ShowMobileCards="false"
                 IsLoading="@(!_kpisLoaded)"
                 PagerLabel="KPIs pro Seite"
                 EmptyText="@KpiEmptyText" />

    <div class="mw-table-foot">
        <button type="button" class="mw-btn mw-btn--primary"
                @onclick="() => OpenKpiDialog(new KPI(), true)">
            <MeadowIcon Name="MeadowIconName.Plus" Size="20" />
            <span>KPI hinzufügen</span>
        </button>
    </div>
}
else if (_tab == TabBaseData)
{
    <div class="mw-chip-tabs">
        @foreach (var sub in BaseDataTabs)
        {
            <button type="button" class="mw-mini-chip @(_baseTab == sub ? "is-active" : "")"
                    @onclick="() => _baseTab = sub">
                @sub
            </button>
        }
    </div>

    @* Nur der aktive Zweig wird gerendert - MudTabs hielt alle
       Tabellen gleichzeitig im DOM. *@
    @switch (_baseTab)
    {
        case "Kuh Behandlung":
            <BaseDataCowTreatment />
            break;
        case "Klauen Behandlung":
            <BaseDataClawTreatment />
            break;
        case "Kühe":
            <BaseDataCow />
            break;
        case "Wie / Wo":
            <BaseDataWhereHow />
            break;
        case "Behandlungsgrund":
            <BaseDataTreatmentReason />
            break;
        case "Klauenbefund":
            <BaseDataClawFinding />
            break;
        @* "Medikamente" ausdruecklich, nicht nur ueber default: sonst ist
           default das stille Auffangbecken fuer jeden Tippfehler in
           BaseDataTabs, und ein falsch geschriebener Reiter zeigt wortlos die
           Medikamente. Der Rueckfall bleibt derselbe Zweig. *@
        case "Medikamente":
        default:
            <BaseDataMedicine />
            break;
    }
}
else
{
    <div class="mw-card mw-settings-card">
        <h2 class="mw-section-title">Standardwerte</h2>

        <label class="mw-label" for="mw-claw-fallback">
            Anzeigetext für Klauen ohne erfassten Befund
        </label>
        <input id="mw-claw-fallback" class="mw-input" type="text"
               value="@_fallbackDraft"
               @oninput="e => _fallbackDraft = e.Value?.ToString() ?? string.Empty" />
        <p class="mw-hint">
            Wird nur angezeigt, nicht gespeichert: unberührte Klauen bleiben in der
            Datenbank leer. Ältere Behandlungen, in denen „Pflege" wirklich
            gespeichert wurde, zeigen weiter ihren eigenen Wert.
        </p>

        <div class="mw-table-foot">
            <button type="button" class="mw-btn mw-btn--primary" @onclick="SaveFallback">
                Speichern
            </button>
        </div>
    </div>

    <div class="mw-card mw-settings-card">
        <h2 class="mw-section-title">Verband-Erinnerung</h2>

        <label class="mw-label" for="mw-bandage-reminder-days">
            Tage bis zur Verband-Erinnerung
        </label>
        <input id="mw-bandage-reminder-days" class="mw-input" type="number" min="1"
               value="@_bandageReminderDaysDraft"
               @oninput="e => _bandageReminderDaysDraft = e.Value?.ToString() ?? string.Empty" />
        <p class="mw-hint">
            Anzahl Tage ab dem Behandlungsdatum, nach denen an das Entfernen eines
            Verbands erinnert werden soll. Muss eine positive ganze Zahl sein.
        </p>

        <div class="mw-table-foot">
            <button type="button" class="mw-btn mw-btn--primary" @onclick="SaveBandageReminderDays">
                Speichern
            </button>
        </div>
    </div>

    @* Web-Push-Opt-in. Die einzige sichtbare Stelle, an der Task 3 die
       Berechtigung anfragt - ein Klick loest requestPermission() aus (nur so
       akzeptiert der Browser die Abfrage) und meldet den Browser serverseitig
       an. Die Karte erscheint gar nicht erst, wenn der Browser Push nicht
       beherrscht oder der Server keine VAPID-Schluessel hat. *@
    @if (_pushSupported && _pushServerEnabled)
    {
        <div class="mw-card mw-settings-card">
            <h2 class="mw-section-title">Benachrichtigungen</h2>
            <p class="mw-hint">
                Erlaubt dem Server, dieses Gerät auch bei geschlossener App zu
                benachrichtigen (z. B. an das Entfernen eines Verbands zu
                erinnern). Aktueller Stand: @PushStatusText
            </p>

            <div class="mw-table-foot">
                @if (_pushPermission == "granted")
                {
                    <button type="button" class="mw-btn" @onclick="DisablePush" disabled="@_pushBusy">
                        Benachrichtigungen abschalten
                    </button>
                }
                else
                {
                    <button type="button" class="mw-btn mw-btn--primary" @onclick="EnablePush"
                            disabled="@(_pushBusy || _pushPermission == "denied")">
                        Benachrichtigungen aktivieren
                    </button>
                }
            </div>

            @if (_pushPermission == "denied")
            {
                <p class="mw-hint">
                    Der Browser hat Benachrichtigungen für diese Seite blockiert.
                    Bitte in den Browsereinstellungen wieder erlauben.
                </p>
            }
        </div>
    }
}

@code {
    private const string TabKpi = "KPIs";
    private const string TabBaseData = "Basisdaten";
    private const string TabDefaults = "Standardwerte";

    private static readonly string[] Tabs = { TabKpi, TabBaseData, TabDefaults };

    private static readonly string[] BaseDataTabs =
    {
        "Kuh Behandlung", "Klauen Behandlung", "Kühe", "Medikamente", "Wie / Wo",
        "Behandlungsgrund", "Klauenbefund"
    };

    private string _tab = TabKpi;
    private string _baseTab = BaseDataTabs[0];

    private List<KPI> _kpis = new();
    private string _fallbackDraft = "";
    private string _bandageReminderDaysDraft = "";
    private string _kpiSearch = "";

    // Push-Zustand fuer die Opt-in-Karte. Alles browserabhaengig, deshalb erst
    // nach dem ersten Render (OnAfterRenderAsync) ermittelt - vorher steht kein
    // JS-Interop bereit.
    private bool _pushSupported;
    private bool _pushServerEnabled;
    private string _pushPermission = "default";
    private bool _pushBusy;

    private string PushStatusText => _pushPermission switch
    {
        "granted" => "aktiviert",
        "denied" => "vom Browser blockiert",
        _ => "nicht aktiviert"
    };

    /// <summary>
    /// Getrennt vom "ist die Liste leer": bisher stand waehrend des Ladens der Leerzustand da, und
    /// "noch nicht geladen" sah aus wie "keine angelegt". Jede andere Tabelle der App reicht
    /// IsLoading durch, nur diese nicht.
    /// </summary>
    private bool _kpisLoaded;

    /// <summary>Die zuletzt geloeschte Kennzahl, fuer das Rueckgaengig in der Snackbar.</summary>
    private KPI? _lastDeleted;

    private IReadOnlyList<KPI> FilteredKpis
    {
        get
        {
            var search = _kpiSearch.Trim();
            if (search.Length == 0)
            {
                return _kpis;
            }

            return _kpis
                .Where(k => k.Title.Contains(search, StringComparison.OrdinalIgnoreCase)
                            || KpiDefinitionSummary.Describe(k)
                                .Contains(search, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private string KpiEmptyText => _kpiSearch.Trim().Length > 0
        ? "Keine KPI passt zur Suche."
        : "Noch keine KPIs angelegt.";

    private void OnKpiSearchChanged(string value) => _kpiSearch = value;

    private IReadOnlyList<MeadowColumn<KPI>> _kpiColumns = Array.Empty<MeadowColumn<KPI>>();

    /// <summary>
    /// Der Reiter steht in der URL, nicht nur im Feld.
    ///
    /// Ohne das gibt es keinen Link auf die KPI-Verwaltung - und genau dorthin zeigen jetzt der
    /// Leerzustand des Dashboards und der Weg aus einer fehlerhaften Kachel. Ein Neuladen verwarf
    /// die Unterauswahl ausserdem still.
    /// </summary>
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabParam { get; set; }

    protected override async Task OnInitializedAsync()
    {
        BuildColumns();

        // Haengte bisher am Auth-Callback und lief erst nach der Anmeldung.
        await Data.EnsureDashboardAsync();
        _fallbackDraft = Defaults.ClawFindingFallback;
        _bandageReminderDaysDraft = Defaults.BandageRemovalReminderDays.ToString();
        await LoadKpis();
    }

    /// <summary>
    /// Push-Zustand nachtragen, sobald JS-Interop bereit ist. Nur beim ersten
    /// Render: der Zustand aendert sich danach nur ueber die Buttons, die ihn
    /// selbst pflegen.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _pushSupported = await Push.IsSupportedAsync();
        if (_pushSupported)
        {
            _pushPermission = await Push.PermissionAsync();
            var key = await Push.GetPublicKeyAsync();
            _pushServerEnabled = key?.Enabled ?? false;
            StateHasChanged();
        }
    }

    private async Task EnablePush()
    {
        _pushBusy = true;
        try
        {
            var ok = await Push.EnableAsync();
            _pushPermission = await Push.PermissionAsync();
            Snackbar.Add(
                ok ? "Benachrichtigungen aktiviert." : "Benachrichtigungen konnten nicht aktiviert werden.",
                ok ? Severity.Success : Severity.Warning);
        }
        finally
        {
            _pushBusy = false;
        }
    }

    private async Task DisablePush()
    {
        _pushBusy = true;
        try
        {
            await Push.DisableAsync();
            _pushPermission = await Push.PermissionAsync();
            Snackbar.Add("Benachrichtigungen abgeschaltet.", Severity.Success);
        }
        finally
        {
            _pushBusy = false;
        }
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(TabParam))
        {
            _tab = Tabs.FirstOrDefault(t => Slug(t) == TabParam.ToLowerInvariant()) ?? _tab;
        }
    }

    /// <summary>Reiter-Name als URL-Fragment: "KPIs" -> "kpis", "Standardwerte" -> "standardwerte".</summary>
    private static string Slug(string tab) => tab.ToLowerInvariant().Replace(" ", "-");

    private void SelectTab(string tab)
    {
        _tab = tab;
        // replace: true - der Reiterwechsel ist keine eigene Station in der Zurueck-Historie.
        Nav.NavigateTo($"{MeadowRoutes.Settings}?tab={Slug(tab)}", replace: true);
    }

    // Sechs Spalten, sechs verschiedene Sortierschluessel - bisher sortierten
    // alle nach KPIId.
    private void BuildColumns() => _kpiColumns = new List<MeadowColumn<KPI>>
    {
        new()
        {
            Title = "ID",
            Text = k => k.KPIId.ToString(),
            SortBy = k => k.KPIId,
            Style = MeadowCellStyle.Mono,
            Width = "70px"
        },
        new()
        {
            Title = "Titel",
            Text = k => k.Title,
            SortBy = k => k.Title,
            Style = MeadowCellStyle.Bold
        },
        new()
        {
            Title = "Typ",
            Text = k => k.IsBuilder ? "Builder" : "SQL",
            SortBy = k => k.IsBuilder ? 0 : 1,
            Width = "90px"
        },
        new()
        {
            // Hier stand Shorten(k.Script). Bei einer Builder-KPI ist Script leer,
            // die Zeile haette also ausgerechnet fuer die neuen KPIs leer gewirkt.
            // KpiDefinitionSummary beschreibt beide Arten in einer Zeile.
            Title = "Definition",
            Text = KpiDefinitionSummary.Describe,
            SortBy = k => KpiDefinitionSummary.Describe(k),
            MaxWidth = "320px",
            NoWrap = true
        },
        new()
        {
            Title = "Sortierung",
            Text = k => k.SortOrder.ToString(),
            SortBy = k => k.SortOrder,
            Align = MeadowAlign.Right,
            Width = "110px"
        },
        new()
        {
            // Hier stand k.Url. Bei einer Builder-KPI ist das nur die nackte Route - der
            // Rueckfall fuer den Fall, dass die Definition unlesbar wird - und damit NICHT das
            // Ziel, auf dem ein Klick landet. Die Filter fehlten.
            Title = "Link (Vorschau)",
            Text = KpiDrillDownUrl.Build,
            SortBy = k => KpiDrillDownUrl.Build(k),
            Style = MeadowCellStyle.Mono
        },
        new()
        {
            IsActions = true,
            Width = "196px",
            Template = kpi =>
                @<text>
                    @* Pfeile und nicht Ziehen: HTML5-Drag&Drop feuert auf Touch nicht, und das
                       Tablet ist das Hauptgeraet. Deaktiviert, sobald nach einer anderen Spalte
                       sortiert wird - "eine Position nach oben" hat in einer alphabetischen
                       Liste kein definiertes Ziel. *@
                    <MeadowIconButton Icon="MeadowIconName.ChevronDown" Title="@UpTitle(kpi)"
                                      Class="mw-icon-btn--up"
                                      Disabled="@(!CanReorder || IsFirst(kpi))"
                                      OnClick="() => MoveAsync(kpi, -1)" />
                    <MeadowIconButton Icon="MeadowIconName.ChevronDown" Title="@DownTitle(kpi)"
                                      Disabled="@(!CanReorder || IsLast(kpi))"
                                      OnClick="() => MoveAsync(kpi, 1)" />
                    <MeadowIconButton Icon="MeadowIconName.Plus" Title="KPI duplizieren"
                                      OnClick="() => DuplicateKpi(kpi)" />
                    <MeadowIconButton Icon="MeadowIconName.Edit" Title="KPI bearbeiten"
                                      OnClick="() => OpenKpiDialog(kpi)" />
                    <MeadowIconButton Icon="MeadowIconName.Trash" Title="KPI löschen"
                                      Danger="true" OnClick="() => DeleteKpi(kpi)" />
                </text>
        }
    };

    // ---- Reihenfolge ----------------------------------------------------

    /// <summary>
    /// Sortieren geht nur in der gespeicherten Reihenfolge - und nur ohne aktive Suche, weil man
    /// sonst zwei Zeilen tauscht, zwischen denen ungezeigte liegen.
    /// </summary>
    private bool CanReorder => _kpiSearch.Trim().Length == 0;

    private bool IsFirst(KPI kpi) => _kpis.Count > 0 && _kpis[0].KPIId == kpi.KPIId;

    private bool IsLast(KPI kpi) => _kpis.Count > 0 && _kpis[^1].KPIId == kpi.KPIId;

    private string UpTitle(KPI kpi)
        => CanReorder
            ? $"„{kpi.Title}\" eine Position nach oben"
            : "Zum Sortieren erst die Suche leeren";

    private string DownTitle(KPI kpi)
        => CanReorder
            ? $"„{kpi.Title}\" eine Position nach unten"
            : "Zum Sortieren erst die Suche leeren";

    /// <summary>
    /// Verschiebt eine Kennzahl und normalisiert die Reihenfolge auf 0..n-1.
    ///
    /// Die Normalisierung ist der eigentliche Punkt: das frueher im Dialog editierbare Zahlenfeld
    /// liess Duplikate zu, und bei gleichem Sortier-Index war die Reihenfolge der Kacheln beliebig.
    /// Geschrieben wird nur, was sich wirklich geaendert hat.
    /// </summary>
    private async Task MoveAsync(KPI kpi, int direction)
    {
        var index = _kpis.FindIndex(k => k.KPIId == kpi.KPIId);
        var target = index + direction;

        if (index < 0 || target < 0 || target >= _kpis.Count)
        {
            return;
        }

        var ordered = _kpis.ToList();
        (ordered[index], ordered[target]) = (ordered[target], ordered[index]);

        for (var i = 0; i < ordered.Count; i++)
        {
            if (ordered[i].SortOrder == i)
            {
                continue;
            }

            var moved = ordered[i].Copy();
            moved.SortOrder = i;
            await KPIService.UpdateDataAsync(moved);
        }

        await LoadKpis();
    }


    // Diese Liste zeigt Titel, Skript und Sortierung - nie einen berechneten Wert. GetAllKPIs
    // fuehrte aber jedes KPI-Skript aus und ".Keys" warf die Ergebnisse anschliessend weg: sieben
    // SQL-Abfragen fuer eine Namensliste, bei jedem Aufruf der Einstellungen und nach jedem
    // Speichern und Loeschen. GetAllDataAsync laedt genau das, was die Tabelle darstellt.
    private async Task LoadKpis()
    {
        await KPIService.GetAllDataAsync();
        // ThenBy auf den Titel, damit die Reihenfolge auch bei doppelten Sortier-Indizes
        // feststeht - Altbestand kann sie haben, das frueher editierbare Zahlenfeld liess sie zu.
        _kpis = KPIService.KPIs.Values
            .OrderBy(k => k.SortOrder)
            .ThenBy(k => k.Title, StringComparer.CurrentCulture)
            .ToList();
        _kpisLoaded = true;
    }

    private async Task OpenKpiDialog(KPI kpi, bool isNew = false)
    {
        var options = new DialogOptions
        {
            BackdropClick = false,
            // AUS, damit MudDialogProvider den Dialog nicht global wegescapet, bevor der
            // Dirty-Check fragen kann. Die Taste faengt MeadowDialog selbst und reicht sie an
            // KPIDialog.TryCancelAsync weiter - siehe den Kommentar in MeadowDialog.OnKeyDown.
            CloseOnEscapeKey = false,
            // Large und nicht Medium: Medium deckelt bei 960px und schnitte die 1040px ab, die
            // MeadowDialogSize.Split fuer die zwei Spalten braucht. Die tatsaechliche Breite setzt
            // weiterhin das CSS (--mw-dlg-w), das hier ist nur die Obergrenze von MudBlazor.
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };
        var parameters = new DialogParameters<KPIDialog>
        {
            // Eine KOPIE, nicht die Instanz aus dem Cache von KPIService: der Dialog bindet direkt
            // auf das Objekt (@bind-Value="KPI.Title"), und ohne Kopie stand eine abgebrochene
            // Aenderung trotzdem im Cache und auf dem Dashboard. Siehe KPI.Copy().
            { x => x.KPI, kpi.Copy() },
            { x => x.IsSave, isNew }
        };

        var dialog = await DialogService.ShowAsync<KPIDialog>(string.Empty, parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        Snackbar.Add(isNew ? "KPI angelegt." : "KPI gespeichert.", Severity.Success);
        await LoadKpis();
    }

    private async Task DeleteKpi(KPI kpi)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters<GenericDialog>
        {
            { x => x.HeaderText, "Löschen" },
            { x => x.Description, $"Soll das KPI „{kpi.Title}\" wirklich gelöscht werden?" },
            { x => x.AcceptButtonText, "Löschen" },
            { x => x.CancelButtonText, "Abbrechen" },
            { x => x.ColorScheme, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<GenericDialog>(string.Empty, parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        if (!await KPIService.DeleteDataAsync(kpi.KPIId))
        {
            Snackbar.Add("Löschen fehlgeschlagen.", Severity.Error);
            return;
        }

        _lastDeleted = kpi.Copy();
        await LoadKpis();

        // Der Bestaetigungsdialog bleibt: Rueckgaengig ueber eine Snackbar ist ein Netz mit vier
        // Sekunden Maschenweite, kein Ersatz fuer die Frage davor.
        Snackbar.Add("KPI gelöscht.", Severity.Success, config =>
        {
            config.Action = "Rückgängig";
            config.ActionColor = Color.Primary;
            // MudBlazor 7 schreibt das Feld klein: Onclick, nicht OnClick.
            config.Onclick = _ => UndoDeleteAsync();
        });
    }

    /// <summary>
    /// Legt die geloeschte Kennzahl wieder an.
    ///
    /// Sie bekommt dabei eine NEUE KPI_ID. Das ist in Ordnung - es gibt keine Fremdschluessel auf
    /// KPI_ID, und die Detailseite wird nach dem Loeschen ohnehin nicht mehr geoeffnet - steht aber
    /// hier, damit niemand spaeter eine Id-Stabilitaet annimmt, die es nicht gibt.
    /// </summary>
    private async Task UndoDeleteAsync()
    {
        if (_lastDeleted is null)
        {
            return;
        }

        var restored = _lastDeleted.Copy();
        restored.KPIId = 0;
        _lastDeleted = null;

        if (await KPIService.InsertDataAsync(restored))
        {
            await LoadKpis();
            StateHasChanged();
        }
        else
        {
            Snackbar.Add("Wiederherstellen fehlgeschlagen.", Severity.Error);
        }
    }

    /// <summary>
    /// Eine Kopie zum Bearbeiten, statt das Formular noch einmal von Hand auszufuellen.
    ///
    /// Script bleibt LEER, auch wenn das Original eines hatte: eine Builder-Kennzahl mit Skript
    /// laeuft beim Speichern durch KpiScriptGuard und meldete dem Benutzer sonst einen Fehler ueber
    /// SQL, das er nie gesehen hat. Die Definition wird ueber Clone() neu serialisiert und nicht
    /// als Zeichenkette kopiert - so ist sichergestellt, dass die Kopie lesbar ist.
    /// </summary>
    private async Task DuplicateKpi(KPI kpi)
    {
        var definition = KpiDefinition.Deserialize(kpi.Definition);

        var copy = new KPI
        {
            KPIId = 0,
            Title = $"{kpi.Title} (Kopie)",
            Url = kpi.Url,
            Script = kpi.IsBuilder ? string.Empty : kpi.Script,
            Kind = kpi.Kind,
            Definition = definition is null ? null : KpiDefinition.Serialize(definition.Clone()),
            SortOrder = _kpis.Count == 0 ? 0 : _kpis.Max(k => k.SortOrder) + 1
        };

        await OpenKpiDialog(copy, isNew: true);
    }

    private async Task SaveFallback()
    {
        var value = _fallbackDraft.Trim();
        if (value.Length == 0)
        {
            Snackbar.Add("Der Anzeigetext darf nicht leer sein.", Severity.Error);
            return;
        }

        if (!await Defaults.SetAsync(AppSetting.ClawFindingFallbackKey, value))
        {
            Snackbar.Add("Speichern fehlgeschlagen.", Severity.Error);
            return;
        }

        _fallbackDraft = value;
        Snackbar.Add("Standardwert gespeichert.", Severity.Success);
    }

    private async Task SaveBandageReminderDays()
    {
        var raw = _bandageReminderDaysDraft.Trim();
        if (!int.TryParse(raw, out var days) || days < 1)
        {
            Snackbar.Add("Bitte eine positive ganze Zahl eingeben.", Severity.Error);
            return;
        }

        if (!await Defaults.SetAsync(AppSetting.BandageRemovalReminderDaysKey, days.ToString()))
        {
            Snackbar.Add("Speichern fehlgeschlagen.", Severity.Error);
            return;
        }

        _bandageReminderDaysDraft = days.ToString();
        Snackbar.Add("Verband-Erinnerung gespeichert.", Severity.Success);
    }
}
