@using Meadow.Api.Components.Ui
@using Meadow.Shared.Models
@*
    Die vier Euterviertel als Pegel - genau wie die Klauen nebenan: jedes
    Viertel fuellt sich von unten, so weit es am Hoechstwert dieser Kuh liegt.

    Anordnung und Reihenfolge wie im UdderDialog: LV RV oben, LH RH unten.
    Das Euter wird von hinten betrachtet, und die Anwendung ist darin
    durchgaengig - diese Seite ist nicht die richtige Stelle, um als einzige
    zu spiegeln.

    Frueher waren es vier eingefaerbte Kaesten aus einer vierstufigen
    Farbrampe. Dieselbe Kritik wie bei den Klauen traf sie: zwei benachbarte
    Stufen sehen gleich aus, und die Rampe verlangte fuer jede Stufe noch
    eine dazu lesbare Schriftfarbe. Ein Fuellstand ist eine Laenge, die man
    ohne Schluessel vergleicht - und er sieht auf beiden Karten der Spalte
    gleich aus, was die zwei Karten als ein Paar lesbar macht.

    Jede Zelle ist ein Link auf die Lasche "Kuh", gefiltert auf genau dieses
    Viertel - wie die Klaue nebenan auf ihre Lasche.

    Hier stand einmal, das ginge nicht, weil eine Behandlung mehrere Viertel
    treffen kann. Das ist zwar richtig, aber kein Hindernis: die vier
    gefilterten Mengen ueberschneiden sich eben, statt die Liste zu teilen.
    Was zaehlt, ist dass die Zahl auf der Zelle und die Zeilen in der Liste
    dieselbe Menge beschreiben - und das tun sie, weil beide dasselbe
    Praedikat verwenden (Udder.GetQuarter).

    Genau dieselbe Ueberschneidung ist der Grund, warum sich die vier Zahlen
    hoeher summieren als die Zahl der Kuhbehandlungen: die Udder-Zeile traegt
    vier Booleans, und eine Behandlung kann mehrere davon setzen. Unter dem
    Raster stand dazu eine Fussnote - entfernt, weil die Kachel ohne
    Kleingedrucktes auskommen soll. Wer die Summe nachrechnet und sich
    wundert, findet die Begruendung hier.
*@
@if (Total == 0)
{
    <div class="mw-empty">Für diese Kuh sind keine Kuhbehandlungen erfasst.</div>
}
else if (WithQuarter == 0)
{
    <div class="mw-empty">Keine Behandlung mit Viertelangabe.</div>
}
else
{
    <div class="mw-part-grid" role="group" aria-label="Euterviertel nach Behandlungshäufigkeit">
        @foreach (var position in HoofPositions.All)
        {
            var count = Count(position);

            @* Echter Link und kein onclick: der Filter lebt in ?viertel=,
               also funktionieren Zurueck-Knopf, Mittelklick und ein geteilter
               Link von selbst.

               Ohne Behandlung bleibt das a OHNE href (Blazor laesst
               null-Attribute weg) und ist damit kein Link: eine leere Liste
               zu oeffnen ist kein Ziel. *@
            <a class="mw-part-cell @(position == Selected ? "is-active" : null)"
               href="@Href(position, count)"
               aria-current="@(position == Selected ? "true" : null)">
                @* Zwei deckungsgleiche Umrisse: der untere leer, der obere
                   gefuellt und oben weggeschnitten. Beide tragen kein Title
                   und sind damit aria-hidden - die Zahl daneben sagt dasselbe
                   in Worten. *@
                <span class="mw-level" style="@($"--mw-level: {Level(count)}%")">
                    <Teat />
                    <span class="mw-level__fill"><Teat /></span>
                </span>

                @* "LV" ist kein Wort - ausgeschrieben steht es ohnehin da. *@
                <span class="mw-part-cell__label">@CowDetailPosition.QuarterLabel(position)</span>

                <span class="mw-part-cell__count">
                    @count.ToString("N0")
                    <span class="mw-sr-only">
                        @(count == 1 ? "Behandlung" : "Behandlungen")
                    </span>
                </span>
            </a>
        }
    </div>
}

@code {
    /// <summary>Behandlungen je Viertel, aus CowProfile.UdderQuarters.</summary>
    [Parameter] public IReadOnlyDictionary<HoofPosition, int> Quarters { get; set; }
        = new Dictionary<HoofPosition, int>();

    /// <summary>Kuhbehandlungen MIT Viertelangabe.</summary>
    [Parameter] public int WithQuarter { get; set; }

    /// <summary>Alle Kuhbehandlungen dieser Kuh.</summary>
    [Parameter] public int Total { get; set; }

    /// <summary>Fuer die Adressen der vier Links. Die Cow_ID, nicht die Halsbandnummer.</summary>
    [Parameter] public string CowId { get; set; } = "";

    /// <summary>Das Viertel, auf das die Liste gerade gefiltert ist, oder null.</summary>
    [Parameter] public HoofPosition? Selected { get; set; }

    /// <summary>
    /// Untergrenze fuer ein Viertel, das ueberhaupt behandelt wurde - siehe
    /// CowHoofLevels.MinLevel, dieselbe Ueberlegung und derselbe Wert, damit
    /// die beiden Karten nebeneinander dieselbe Skala zeigen.
    /// </summary>
    private const int MinLevel = 18;

    private int Count(HoofPosition position)
        => Quarters.TryGetValue(position, out var count) ? count : 0;

    private int Max => HoofPositions.All.Max(Count);

    /// <summary>
    /// Fuellstand in Prozent der Umrisshoehe. Ganzzahlig, damit der Wert ohne
    /// Ruecksicht auf die Kultur in den style-Wert darf - "0,42%" waere ein
    /// ungueltiger CSS-Wert und der Pegel fiele still auf null zurueck.
    /// </summary>
    private int Level(int count)
        => count == 0 || Max == 0
            ? 0
            : Math.Max(MinLevel, (int)Math.Round(100.0 * count / Max));

    private string? Href(HoofPosition position, int count)
        => count == 0 ? null : CowDetailPosition.QuarterHref(CowId, position);
}
