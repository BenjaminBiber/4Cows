@using _4Cows_FE.Components.Meadow
@using BB_Cow.Services

@inject UdderService UdderService
@inject ISnackbar Snackbar

@* Die vier Euterviertel, gleiche Umschalter-Sprache wie beim Klauen-Selektor. *@
<MeadowDialog Title="Euterviertel auswählen" Size="MeadowDialogSize.Info">
    <ChildContent>
        <div class="mw-quarter-grid" role="group" aria-label="Euterviertel">
            @foreach (var quarter in Quarters)
            {
                <button type="button" class="@ToggleClass(quarter.Get())"
                        aria-pressed="@(quarter.Get() ? "true" : "false")"
                        @onclick="() => quarter.Toggle()">@quarter.Label</button>
            }
        </div>
        @* Hier stand "Nicht ausgewählt bedeutet: kein bestimmtes Viertel."
           Das war die Einladung zu genau dem, was jetzt nicht mehr geht: eine
           Euterbehandlung ohne Viertel. *@
        <div class="mw-hint">Mindestens ein Viertel ist erforderlich.</div>
    </ChildContent>
    <Footer>
        <button type="button" class="mw-btn mw-btn--plain mw-btn--wide" @onclick="Cancel">
            Abbrechen
        </button>
        @* Gesperrt statt Fehlermeldung nach dem Klick - der Hinweis darueber
           sagt, warum. Save prueft trotzdem noch: disabled ist Anzeige,
           keine Zusicherung. *@
        <button type="button" class="mw-btn mw-btn--primary mw-btn--wide"
                disabled="@(!HasAnyQuarter)" @onclick="Save">
            Speichern
        </button>
    </Footer>
</MeadowDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    private readonly Udder _udder = new();

    private sealed record Quarter(string Label, Func<bool> Get, Action Toggle);

    private Quarter[] Quarters => new[]
    {
        new Quarter("LV", () => _udder.QuarterLV, () => _udder.QuarterLV = !_udder.QuarterLV),
        new Quarter("RV", () => _udder.QuarterRV, () => _udder.QuarterRV = !_udder.QuarterRV),
        new Quarter("LH", () => _udder.QuarterLH, () => _udder.QuarterLH = !_udder.QuarterLH),
        new Quarter("RH", () => _udder.QuarterRH, () => _udder.QuarterRH = !_udder.QuarterRH)
    };

    private static string ToggleClass(bool on) => on ? "mw-quarter is-on" : "mw-quarter";

    private bool HasAnyQuarter
        => _udder.QuarterLV || _udder.QuarterRV || _udder.QuarterLH || _udder.QuarterRH;

    // Abbrechen MUSS Cancel liefern: der Aufrufer setzt bei einem
    // Ok-Ergebnis die Viertel-ID, bei Abbruch dagegen "keine Viertel".
    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        if (!HasAnyQuarter)
        {
            Snackbar.Add("Bitte mindestens ein Euterviertel auswählen.", Severity.Error);
            return;
        }

        var id = await UdderService.GetIDByBools(_udder);
        if (id == int.MinValue)
        {
            Snackbar.Add("Euterviertel konnten nicht gespeichert werden.", Severity.Error);
            return;
        }

        MudDialog.Close(DialogResult.Ok(id));
    }
}
