@using _4Cows_FE.Components.Meadow

@inject ClawFindingService ClawFindingService
@inject ISnackbar Snackbar

<MeadowDialog Title="Klauenbefunde zusammenführen" Size="MeadowDialogSize.Info">
    <ChildContent>
        <p class="mw-hint">
            @Description
        </p>

        <label class="mw-label" for="mw-merge-finding-target">Ziel (bleibt bestehen)</label>
        <div class="mw-field">
            @* CoerceValue FALSE: ein Ziel muss existieren. Ein per Tippfehler
               erfundenes Ziel wuerde die Klauen auf eine ID umhaengen,
               die es nicht gibt. *@
            <MudAutocomplete T="string" InputId="mw-merge-finding-target" Variant="Variant.Text"
                             SelectValueOnTab="true" CoerceValue="false"
                             Value="@_targetName" ValueChanged="OnTargetChanged"
                             SearchFunc="SearchTargets"
                             Placeholder="Klauenbefund suchen…" />
        </div>

        <label class="mw-label">Welcher Name bleibt?</label>
        <div class="mw-field">
            @* Die Wahl ist der Kern dieses Dialogs. Im Stall wird kurz getippt
               ("Morte"), im Nachweis ist die ausgeschriebene Bezeichnung
               eindeutiger - was ueberwiegt, haengt am Einzelfall. Der gewaehlte
               Name landet in Claw_Finding_Name des Zieleintrags. *@
            <MudRadioGroup T="bool" @bind-Value="_keepSourceName">
                <MudRadio T="bool" Value="false" Dense="true">
                    @TargetLabel
                </MudRadio>
                <MudRadio T="bool" Value="true" Dense="true">
                    @SourceLabel
                </MudRadio>
            </MudRadioGroup>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="mw-btn mw-btn--plain mw-btn--wide" @onclick="Cancel">
            Abbrechen
        </button>
        <button type="button" class="mw-btn mw-btn--primary mw-btn--wide"
                disabled="@(_target is null)" @onclick="Merge">
            Zusammenführen
        </button>
    </Footer>
</MeadowDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Der Eintrag, der verschwindet.</summary>
    [Parameter] public ClawFinding Source { get; set; } = new();

    /// <summary>Optionale Vorbelegung des Ziels; im Dialog aenderbar.</summary>
    [Parameter] public ClawFinding? Target { get; set; }

    /// <summary>Behandlungen, die den Quell-Befund tragen - nicht Klauen.</summary>
    [Parameter] public int SourceUsageCount { get; set; }

    private ClawFinding? _target;
    private string _targetName = "";
    private bool _keepSourceName;

    private string SourceLabel => $"„{Source.ClawFindingName}\" behalten (bisheriger Name)";

    private string TargetLabel => _target is null
        ? "Name des Ziels behalten"
        : $"„{_target.ClawFindingName}\" behalten";

    private string Description
    {
        get
        {
            var usage = SourceUsageCount == 1 ? "1 Behandlung" : $"{SourceUsageCount} Behandlungen";
            var moved = SourceUsageCount == 1 ? "Die Behandlung wird" : "Die Behandlungen werden";

            return SourceUsageCount == 0
                ? $"„{Source.ClawFindingName}\" verschwindet und wird durch das Ziel ersetzt."
                : $"„{Source.ClawFindingName}\" wird in {usage} verwendet. {moved} auf das Ziel "
                  + "umgehängt, der Eintrag verschwindet danach.";
        }
    }

    protected override void OnInitialized()
    {
        _target = Target;
        _targetName = Target?.ClawFindingName ?? "";
    }

    private void OnTargetChanged(string value)
    {
        _targetName = value ?? "";

        _target = ClawFindingService.Findings.Values.FirstOrDefault(f =>
            f.ClawFindingId != Source.ClawFindingId
            && string.Equals(f.ClawFindingName.Trim(), _targetName.Trim(), StringComparison.OrdinalIgnoreCase));
    }

    private Task<IEnumerable<string>> SearchTargets(string value, CancellationToken token)
    {
        // Sich selbst ausnehmen: ein Merge auf sich selbst wuerde erst
        // umhaengen und dann genau das Ziel loeschen. Der Service faengt das
        // ab, aber die Auswahl soll es nicht erst anbieten.
        var names = ClawFindingService.Findings.Values
            .Where(f => f.ClawFindingId != Source.ClawFindingId)
            .Select(f => f.ClawFindingName)
            .Distinct()
            .OrderBy(n => n, StringComparer.CurrentCulture);

        return Task.FromResult<IEnumerable<string>>(string.IsNullOrWhiteSpace(value)
            ? names
            : names.Where(n => n.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Merge()
    {
        if (_target is null)
        {
            Snackbar.Add("Bitte ein Ziel wählen.", Severity.Error);
            return;
        }

        var survivingName = _keepSourceName ? Source.ClawFindingName : null;

        if (!await ClawFindingService.MergeAsync(
                Source.ClawFindingId, _target.ClawFindingId, survivingName))
        {
            Snackbar.Add("Zusammenführen fehlgeschlagen.", Severity.Error);
            return;
        }

        var finalName = survivingName ?? _target.ClawFindingName;
        Snackbar.Add($"Zusammengeführt zu „{finalName}\".", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }
}
