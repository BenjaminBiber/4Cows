@using _4Cows_FE.Components.Meadow

@inject MedicineService MedicineService

@*
    Bisher eine MudTable mit MultiSelection als Mehrfachauswahl. Jetzt eine
    Checkbox-Liste - damit ist nach dem Umbau keine MudTable mehr im Projekt.
*@
<MeadowDialog Title="Diagramm bearbeiten" Size="MeadowDialogSize.Info">
    <Meta>
        <span>Welche Medikamente sollen aufgeschlüsselt werden?</span>
    </Meta>
    <ChildContent>
        <div class="mw-check-bar">
            <span>@_selected.Count von @_medicines.Count gewählt</span>
            <div>
                <button type="button" class="mw-btn mw-btn--ghost mw-btn--sm" @onclick="SelectAll">
                    Alle
                </button>
                <button type="button" class="mw-btn mw-btn--ghost mw-btn--sm" @onclick="SelectNone">
                    Keine
                </button>
            </div>
        </div>

        @if (_medicines.Count == 0)
        {
            <p class="mw-hint">Keine Medikamente vorhanden.</p>
        }
        else
        {
            <div class="mw-check-list">
                @foreach (var id in _medicines)
                {
                    var isOn = _selected.Contains(id);
                    <label class="mw-check @(isOn ? "is-on" : "")">
                        <input type="checkbox" checked="@isOn"
                               @onchange="@(() => Toggle(id))" />
                        <span>@MedicineService.GetMedicineNameById(id)</span>
                    </label>
                }
            </div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="mw-btn mw-btn--plain mw-btn--wide" @onclick="Cancel">
            Abbrechen
        </button>
        <button type="button" class="mw-btn mw-btn--primary mw-btn--wide" @onclick="Accept">
            Übernehmen
        </button>
    </Footer>
</MeadowDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public List<int> Medicines { get; set; } = new();

    private List<int> _medicines = new();
    private readonly HashSet<int> _selected = new();

    protected override void OnInitialized()
    {
        // Nach Namen sortiert - angezeigt wird der Name, nicht die ID.
        _medicines = MedicineService.Medicines.Keys
            .OrderBy(MedicineService.GetMedicineNameById, StringComparer.OrdinalIgnoreCase)
            .ToList();

        // Leere Vorauswahl heisst "alle" (so verhaelt sich der Aufrufer).
        foreach (var id in Medicines.Count == 0 ? _medicines : Medicines)
        {
            _selected.Add(id);
        }
    }

    private void Toggle(int id)
    {
        if (!_selected.Remove(id))
        {
            _selected.Add(id);
        }
    }

    private void SelectAll()
    {
        foreach (var id in _medicines)
        {
            _selected.Add(id);
        }
    }

    private void SelectNone() => _selected.Clear();

    private void Cancel() => MudDialog.Cancel();

    // Der Aufrufer erwartet ein HashSet<int> - Vertrag unveraendert.
    private void Accept() => MudDialog.Close(DialogResult.Ok(_selected));
}
