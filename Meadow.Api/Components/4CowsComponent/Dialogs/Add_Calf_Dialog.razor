@using _4Cows_FE.Components.Meadow

@inject ISnackbar Snackbar
@inject CowService cowService

<MeadowDialog Title="Kalb anlegen" Size="MeadowDialogSize.Info">
    <ChildContent>
        <div>
            <label class="mw-label" for="mw-calf-collar">Halsbandnummer</label>
            <div class="mw-field">
                <MudNumericField T="int" InputId="mw-calf-collar" Variant="Variant.Text"
                                 HideSpinButtons="true" Min="1" Immediate="true"
                                 @bind-Value="CollarNumber" Placeholder="z.B. 142" />
            </div>
        </div>

        <p class="mw-hint">
            Ein Kalb wird ohne Ohrenmarkennummer angelegt. Sobald es (über XLink oder
            manuell) eine Ohrenmarke erhält, wird sie zugewiesen.
        </p>
    </ChildContent>
    <Footer>
        <button type="button" class="mw-btn mw-btn--plain mw-btn--wide" @onclick="Cancel">
            Abbrechen
        </button>
        <button type="button" class="mw-btn mw-btn--primary mw-btn--wide" @onclick="Save">
            Speichern
        </button>
    </Footer>
</MeadowDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    private int CollarNumber;

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        if (CollarNumber <= 0)
        {
            Snackbar.Add("Halsbandnummer muss größer als 0 sein!", Severity.Error);
            return;
        }

        if (cowService.IsCollarInUse(CollarNumber))
        {
            Snackbar.Add($"Halsbandnummer {CollarNumber} ist bereits vergeben!", Severity.Error);
            return;
        }

        var success = await cowService.InsertDataAsync(Cow.CreateCalf(CollarNumber));
        if (!success)
        {
            Snackbar.Add("Anlegen fehlgeschlagen.", Severity.Error);
            return;
        }

        Snackbar.Add($"Kalb mit Halsbandnummer {CollarNumber} angelegt.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }
}
