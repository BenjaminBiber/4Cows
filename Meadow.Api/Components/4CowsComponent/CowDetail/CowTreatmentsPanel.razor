@using _4Cows_FE.Components.Meadow
@using BB_Cow.Class
@*
    Tab "Kuh": die erfassten Kuhbehandlungen dieses Tieres.

    Spalten wie in Cow_Table, aber ohne Halsband und Ohrmarke - beides steht
    im Kopf der Seite und waere hier in jeder Zeile dieselbe Angabe.
*@
@inject MedicineService medicineService
@inject WhereHowService WhereHowService
@inject UdderService UdderService
@inject TreatmentReasonService TreatmentReasonService
@inject SettingsService SettingsService

<MeadowTable TItem="CowTreatment" Items="Rows" Columns="_columns"
             RowKey="@(r => r.CowTreatmentId)"
             DefaultSortTitle="Datum" DefaultSortDescending="true"
             PagerLabel="Behandlungen pro Seite"
             MoreLabel="Weitere Behandlungen laden"
             EmptyText="Für diese Kuh sind keine Behandlungen erfasst.">
    <MobileCard Context="row">
        @{ var place = SplitWhereHow(WhereHow(row)); }
        <div class="mw-row-card">
            <div class="mw-row-card__top">
                <span class="mw-row-card__title">@Medicine(row)</span>
                <span class="mw-row-card__date">
                    <MeadowIcon Name="MeadowIconName.Calendar" Size="13" />
                    @row.AdministrationDate.ToString("dd.MM.yyyy")
                </span>
            </div>
            <div class="mw-row-card__fields">
                <div class="mw-row-card__field">
                    <span class="mw-row-card__label">Stelle</span>
                    <span class="mw-row-card__value">
                        @place.Place@if (place.Detail is not null)
                        {
                            <span class="mw-row-card__sep">&#183;</span>@place.Detail
                        }
                    </span>
                </div>
                <div class="mw-row-card__field">
                    <span class="mw-row-card__label">Menge</span>
                    <span class="mw-row-card__value">
                        @Dosage(row)<span class="mw-row-card__unit">@DosageUnitOf(row)</span>
                    </span>
                </div>
                @* Ohne Grund entfaellt die Angabe ganz - ein "–" kostet auf der
                   Karte nur Platz. Wie in Cow_Table. *@
                @if (row.TreatmentReasonId is not null)
                {
                    <div class="mw-row-card__field">
                        <span class="mw-row-card__label">Grund</span>
                        <span class="mw-row-card__value">@Reason(row)</span>
                    </div>
                }
            </div>
        </div>
    </MobileCard>
</MeadowTable>

@code {
    /// <summary>Schon auf diese Kuh gefiltert - das Panel liest nie selbst aus den Caches.</summary>
    [Parameter] public IReadOnlyList<CowTreatment> Rows { get; set; } = Array.Empty<CowTreatment>();

    private List<MeadowColumn<CowTreatment>> _columns = new();

    protected override void OnInitialized() => _columns = new()
    {
        new MeadowColumn<CowTreatment>
        {
            Title = "Datum",
            Text = r => r.AdministrationDate.ToString("dd.MM.yyyy"),
            SortBy = r => r.AdministrationDate,
            Style = MeadowCellStyle.Bold,
            NoWrap = true
        },
        new MeadowColumn<CowTreatment>
        {
            Title = "Medikament",
            Text = Medicine,
            SortBy = Medicine,
            Template = row =>@<span class="mw-pill">@Medicine(row)</span>
        },
        new MeadowColumn<CowTreatment>
        {
            Title = "Wie / Wo",
            Text = WhereHow,
            SortBy = WhereHow
        },
        new MeadowColumn<CowTreatment>
        {
            Title = "Menge",
            Text = DosageWithUnit,
            // Sortiert wird ueber die Zahl, nicht ueber den Text mit Einheit.
            SortBy = r => r.MedicineDosage,
            Align = MeadowAlign.Right,
            NoWrap = true
        },
        new MeadowColumn<CowTreatment>
        {
            Title = "Grund",
            Text = Reason,
            SortBy = Reason
        }
    };

    private string Medicine(CowTreatment r) => medicineService.GetMedicineNameById(r.MedicineId);

    private string WhereHow(CowTreatment r)
        => WhereHowService.GetFullWhereHowName(r.WhereHowId, UdderService, r.UdderId);

    private string Dosage(CowTreatment r) => r.MedicineDosage.ToString("0.##");

    // Die Einheit haengt am Medikament (Medicine.Dosage_Unit); Rueckfallwert
    // ist der Standard aus AppSetting. Genau wie in Cow_Table - eine fest
    // verdrahtete "ml" wies auch die Menge einer Tablette in Millilitern aus.
    private string DosageUnitOf(CowTreatment r)
        => medicineService.GetDosageUnit(r.MedicineId, SettingsService.DefaultDosageUnit);

    private string DosageWithUnit(CowTreatment r) => $"{Dosage(r)} {DosageUnitOf(r)}";

    private string Reason(CowTreatment r) => TreatmentReasonService.GetNameById(r.TreatmentReasonId);

    // "Euter (LV/ RH)" wird auf der Karte zu "Euter . LV/RH" - dieselbe
    // Angabe ohne die Klammern, die in einer schmalen Spalte nur Platz
    // kosten. Wie in Cow_Table.
    private static (string Place, string? Detail) SplitWhereHow(string value)
    {
        var open = value.LastIndexOf('(');
        if (open <= 0 || !value.EndsWith(')'))
        {
            return (value.Trim(), null);
        }

        var detail = value[(open + 1)..^1].Replace("/ ", "/").Trim();
        return (value[..open].TrimEnd(), detail.Length == 0 ? null : detail);
    }
}
