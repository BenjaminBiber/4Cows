<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Meadow.Api</RootNamespace>
        <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <OutputType>Exe</OutputType>
        <UserSecretsId>22056f54-a927-4fdb-9c5d-89feec646b5f</UserSecretsId>
    </PropertyGroup>
    
    <ItemGroup>
      <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.27" />
      <PackageReference Include="EPPlus" Version="7.5.1" />
      <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.19.6" />
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.6" />
      <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.2" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Meadow.Data\Meadow.Data.csproj" />
      <ProjectReference Include="..\Meadow.Shared\Meadow.Shared.csproj" />
      <!-- Nur zum AUSLIEFERN: publish von Meadow.Api zieht die WebAssembly-Ausgabe
           des Clients nach wwwroot. Kein einziger Typ aus Meadow.Client wird hier
           verwendet, und es darf auch keiner werden - die Naht laeuft ueber HTTP. -->
      <ProjectReference Include="..\Meadow.Client\Meadow.Client.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>


  <!--
    Blazor.AceEditorJs liefert 473 Dateien mit 15,9 MB aus: 191 Sprachmodi
    (8,3 MB), 11 Syntaxpruefer (5,7 MB, worker-xquery.js allein 3,4 MB), 48
    Themes und 4 Tastaturlayouts.

    Benutzt werden davon DREI. KPIDialog setzt AceLanguage.sqlserver und, je
    nach Design, AceTheme.sqlserver oder AceTheme.nord_dark - fuer ein
    Eingabefeld, das in genau einem Dialog vorkommt.

    Ohne dieses Target liegen die 15,9 MB im Image UND in
    service-worker-assets.js, und der Service Worker versucht beim Installieren
    jede einzelne davon zu holen. Bei einem Ziel im einstelligen MB-Bereich ist
    das allein schon das Doppelte.

    Die ext-*-Dateien bleiben (0,6 MB): ace.js laedt sie bei Bedarf nach, und
    welche davon der Editor anfasst, haengt an seiner Konfiguration. Wer eine
    weitere Sprache braucht, traegt sie hier ein - sonst laedt Ace das Modul
    zur Laufzeit und bekommt eine 404.
  -->
  <Target Name="TrimAceAssets" BeforeTargets="GenerateComputedPublishStaticWebAssets;GenerateComputedBuildStaticWebAssets">
    <ItemGroup>
      <StaticWebAsset Remove="@(StaticWebAsset)" Condition="
        $([System.String]::Copy('%(StaticWebAsset.RelativePath)').Contains('ace/'))
        and (
          $([System.String]::Copy('%(StaticWebAsset.RelativePath)').Contains('mode-'))
          or $([System.String]::Copy('%(StaticWebAsset.RelativePath)').Contains('theme-'))
          or $([System.String]::Copy('%(StaticWebAsset.RelativePath)').Contains('worker-'))
          or $([System.String]::Copy('%(StaticWebAsset.RelativePath)').Contains('keybinding-'))
        )
        and !$([System.String]::Copy('%(StaticWebAsset.RelativePath)').EndsWith('mode-sqlserver.js'))
        and !$([System.String]::Copy('%(StaticWebAsset.RelativePath)').EndsWith('theme-sqlserver.js'))
        and !$([System.String]::Copy('%(StaticWebAsset.RelativePath)').EndsWith('theme-nord_dark.js'))" />
    </ItemGroup>
  </Target>

</Project>
