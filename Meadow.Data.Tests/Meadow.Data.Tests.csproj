<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meadow.Data\Meadow.Data.csproj" />
    <ProjectReference Include="..\Meadow.Shared\Meadow.Shared.csproj" />

    <!--
      Fuer die Fallen-Tests. Sie pruefen die HTTP-Fassungen der Dienste gegen
      eine erfundene API; ohne diesen Verweis liesse sich Falle 2 nur
      behaupten, denn der Cache-Schreibpfad, um den es geht, liegt in
      Meadow.Client.

      Meadow.Client ist ein BlazorWebAssembly-Projekt, wird hier aber als
      gewoehnliche Assembly referenziert: der Test bootet keinen Host, er ruft
      Methoden auf. Dass das geht, ist kein Zufall - die Dienste haengen an
      HttpClient und ILogger, nicht an einer Browserumgebung.
    -->
    <ProjectReference Include="..\Meadow.Client\Meadow.Client.csproj" />
  </ItemGroup>

</Project>
