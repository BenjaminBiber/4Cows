@inherits LayoutComponentBase
@implements IDisposable

@using _4Cows_FE.Components.Meadow
@using _4Cows_FE.Components.Services

@inject NavigationManager Nav
@inject LayoutState Layout
@inject ThemeState Theme
@inject MeadowDialogLauncher Launcher

<PageTitle>@_title · Meadow</PageTitle>

@* MudBlazor bleibt als Wirt fuer Dialoge, Snackbars und die Formular-Popover.
   MudThemeProvider ist nicht das, was die App dunkel macht - das erledigt das
   data-mw-theme-Attribut. Er wird trotzdem gebunden, damit Muds C#-seitige
   Schattierungen zum Theme passen. *@
<MudThemeProvider IsDarkMode="@Theme.IsDark" Theme="@MeadowMudTheme.Instance" />
<MudPopoverProvider />
<MudDialogProvider Position="DialogPosition.Center" CloseOnEscapeKey="true" BackdropClick="true" />
<MudSnackbarProvider />

<div class="mw-shell">
    <MeadowHeader PageTitle="@_title"
                  HasSiblings="@_hasSiblings"
                  IsDark="@Theme.IsDark"
                  OnMenu="@Layout.ToggleDrawer"
                  OnTitle="@OnTitleClick"
                  OnInfo="@OpenInfo"
                  OnToggleTheme="@Theme.ToggleAsync" />

    <div class="mw-body">
        <MeadowDrawer Open="@Layout.DrawerOpen" OnClose="@Layout.CloseAll" OnInfo="OpenInfo" />

        <main class="mw-content mw-scroll">
            <div class="mw-content-inner">
                @Body
            </div>
        </main>
    </div>

    <MeadowTabbar Route="@_route" FabTitle="@_fabTitle" OnFab="@OnFab" />
</div>

<MeadowPageMenu Open="@Layout.PageMenuOpen" Route="@_route" OnClose="@Layout.CloseAll" />
<MeadowAddMenu Open="@Layout.AddMenuOpen" OnClose="@Layout.CloseAll" />

@code {
    private string _route = "";
    private string _title = "Dashboard";
    private string _fabTitle = "Hinzufügen";
    private bool _hasSiblings;

    protected override void OnInitialized()
    {
        ReadRoute();
        Layout.Changed += OnStateChanged;
        Theme.Changed += OnStateChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Erst hier gibt es JS. Das Attribut steht dank des Inline-Skripts
            // in App.razor schon vor dem ersten Paint; nachgelesen wird es nur,
            // damit MudThemeProvider denselben Zustand kennt.
            await Theme.InitializeAsync();
        }
    }

    private void ReadRoute()
    {
        _route = MeadowRoutes.Normalize(Nav.ToBaseRelativePath(Nav.Uri));
        _title = MeadowRoutes.TitleFor(_route);
        _hasSiblings = MeadowRoutes.HasSiblings(_route);
        _fabTitle = MeadowDialogLauncher.FabTitleFor(_route);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ReadRoute();
        // Jede Navigation schliesst Drawer und Mobile-Menues (Prototyp: go()).
        Layout.CloseAll();
        StateHasChanged();
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void OnTitleClick()
    {
        if (_hasSiblings)
        {
            Layout.TogglePageMenu();
        }
    }

    private Task OpenInfo()
    {
        Layout.CloseAll();
        return Launcher.OpenDatabaseInfoAsync();
    }

    private Task OnFab()
    {
        var action = Launcher.FabActionFor(_route);
        if (action is null)
        {
            Layout.ToggleAddMenu();
            return Task.CompletedTask;
        }

        Layout.CloseAll();
        return action();
    }

    public void Dispose()
    {
        Layout.Changed -= OnStateChanged;
        Theme.Changed -= OnStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
