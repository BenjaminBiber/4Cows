@*
    Meadow-Icons. Pfade 1:1 aus Meadow.dc.html.
    Alle Glyphen sind fill="none" stroke="currentColor" - die Farbe kommt
    also immer von der Elternklasse, ohne Parameter.
*@
<svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="@StrokeWidth"
     stroke-linecap="@LineCap" stroke-linejoin="@LineJoin"
     class="@Class" aria-hidden="true" focusable="false" @attributes="Extra">
    @switch (Name)
    {
        case MeadowIconName.Menu:
            <path d="M3 6h18M3 12h18M3 18h18" />
            break;

        case MeadowIconName.Info:
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v5" stroke-linecap="round" />
            <circle cx="12" cy="7.6" r="1.1" fill="currentColor" stroke="none" />
            break;

        case MeadowIconName.Moon:
            <path d="M21 12.8A8 8 0 1111.2 3 6.2 6.2 0 0021 12.8z" />
            break;

        case MeadowIconName.Sun:
            <circle cx="12" cy="12" r="4.2" />
            <path d="M12 2v2.4M12 19.6V22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M2 12h2.4M19.6 12H22M4.9 19.1l1.7-1.7M17.4 6.6l1.7-1.7" />
            break;

        case MeadowIconName.Dashboard:
            <rect x="3" y="3" width="7" height="9" rx="1.5" />
            <rect x="14" y="3" width="7" height="5" rx="1.5" />
            <rect x="14" y="11" width="7" height="10" rx="1.5" />
            <rect x="3" y="15" width="7" height="6" rx="1.5" />
            break;

        case MeadowIconName.Cow:
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <path d="M3 9h18M9 9v11" />
            break;

        case MeadowIconName.PlannedCow:
            <path d="M14.7 6.3a3.5 3.5 0 00-4.6 4.6l-6.4 6.4a1.5 1.5 0 002.1 2.1l6.4-6.4a3.5 3.5 0 004.6-4.6l-2 2-1.7-1.7 1.6-2z" />
            break;

        case MeadowIconName.Bandage:
            <rect x="2.5" y="8.5" width="19" height="7" rx="3.5" transform="rotate(-45 12 12)" />
            <circle cx="10.4" cy="10.4" r="1" fill="currentColor" stroke="none" />
            <circle cx="13.6" cy="13.6" r="1" fill="currentColor" stroke="none" />
            <circle cx="13.6" cy="10.4" r="1" fill="currentColor" stroke="none" />
            <circle cx="10.4" cy="13.6" r="1" fill="currentColor" stroke="none" />
            break;

        case MeadowIconName.Claw:
            <ellipse cx="12" cy="15.5" rx="4.5" ry="3.5" />
            <ellipse cx="6.5" cy="9.5" rx="1.8" ry="2.4" />
            <ellipse cx="17.5" cy="9.5" rx="1.8" ry="2.4" />
            <ellipse cx="10" cy="6.5" rx="1.6" ry="2.2" />
            <ellipse cx="14" cy="6.5" rx="1.6" ry="2.2" />
            break;

        case MeadowIconName.PlannedClaw:
            <path d="M4 20l5-5M9.5 9.5L4 4l2.5-.5L9 6l1-1-2.5-2.5L9 2c2 0 3.6 1.6 3.6 3.6 0 .5-.1 1-.3 1.4L20 14.7a1.9 1.9 0 01-2.7 2.7L9.6 9.2" />
            break;

        case MeadowIconName.Settings:
            <circle cx="12" cy="12" r="3.2" />
            <path d="M12 2.5v2.6M12 18.9v2.6M4.2 6.8l1.9 1.1M17.9 16.1l1.9 1.1M4.2 17.2l1.9-1.1M17.9 7.9l1.9-1.1" />
            break;

        case MeadowIconName.Search:
            <circle cx="11" cy="11" r="7" />
            <path d="M21 21l-4-4" stroke-linecap="round" />
            break;

        case MeadowIconName.Plus:
        case MeadowIconName.PlusBold:
            <path d="M12 6v12M6 12h12" />
            break;

        case MeadowIconName.Close:
            <path d="M6 6l12 12M18 6L6 18" />
            break;

        case MeadowIconName.Edit:
            <path d="M4 20h4L18.5 9.5a2 2 0 00-2.8-2.8L5 17.2 4 20z" stroke-linejoin="round" />
            break;

        case MeadowIconName.Calendar:
            <rect x="3" y="5" width="18" height="16" rx="2" />
            <path d="M3 9h18M8 3v4M16 3v4" />
            break;

        case MeadowIconName.Filter:
            <path d="M3 5h18M6 12h12M10 19h4" />
            break;

        case MeadowIconName.Download:
            <path d="M12 3v11m0 0l-4-4m4 4l4-4" />
            <path d="M5 20h14" />
            break;

        case MeadowIconName.Trash:
            <path d="M4 7h16M9 7V5a1 1 0 011-1h4a1 1 0 011 1v2M6 7l1 13a1 1 0 001 1h8a1 1 0 001-1l1-13" stroke-linecap="round" />
            break;

        case MeadowIconName.ChevronDown:
            <path d="M6 9l6 6 6-6" />
            break;

        case MeadowIconName.Lock:
            <rect x="4" y="10" width="16" height="10" rx="2" />
            <path d="M8 10V7a4 4 0 018 0v3" />
            break;

        case MeadowIconName.CloudOff:
            <path d="M4.2 18h11.3a4 4 0 00.8-7.9 6 6 0 00-9.1-3.6" />
            <path d="M4.2 18a3.2 3.2 0 01-.6-6.3" />
            <path d="M3 3l18 18" stroke-linecap="round" />
            break;

        case MeadowIconName.Check:
            <path d="M4.5 12.5l4.5 4.5L19.5 6.5" />
            break;

        case MeadowIconName.ArrowRight:
            <path d="M4 12h15m0 0l-5.5-5.5M19 12l-5.5 5.5" />
            break;

        case MeadowIconName.Smartphone:
            <rect x="6.5" y="2.5" width="11" height="19" rx="2.5" />
            <path d="M10.5 18.6h3" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public MeadowIconName Name { get; set; }

    /// <summary>Kantenlaenge in px. Der Prototyp nutzt 16-26.</summary>
    [Parameter] public int Size { get; set; } = 20;

    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Extra { get; set; }

    // Strichstaerken wie im Prototyp: Navigations- und Statusglyphen 1.7,
    // Plus/Schliessen 1.8, der FAB 2.2, Chevron 2.
    private string StrokeWidth => Name switch
    {
        MeadowIconName.Menu => "1.8",
        MeadowIconName.Plus => "1.8",
        MeadowIconName.PlusBold => "2.2",
        MeadowIconName.Close => "1.8",
        MeadowIconName.ChevronDown => "2",
        // Haken und Pfeil sitzen neben 14px-Text und muessen dort noch
        // tragen, ohne dass man sie vergroessert.
        MeadowIconName.Check => "2.1",
        MeadowIconName.ArrowRight => "1.9",
        _ => "1.7"
    };

    private string LineCap => Name switch
    {
        MeadowIconName.Menu => "round",
        MeadowIconName.Moon => "round",
        MeadowIconName.Sun => "round",
        MeadowIconName.Plus => "round",
        MeadowIconName.PlusBold => "round",
        MeadowIconName.Close => "round",
        MeadowIconName.Filter => "round",
        MeadowIconName.Download => "round",
        MeadowIconName.PlannedCow => "round",
        MeadowIconName.PlannedClaw => "round",
        MeadowIconName.ChevronDown => "round",
        MeadowIconName.Check => "round",
        MeadowIconName.ArrowRight => "round",
        MeadowIconName.Smartphone => "round",
        _ => "butt"
    };

    private string LineJoin => Name switch
    {
        MeadowIconName.Filter => "round",
        MeadowIconName.Download => "round",
        MeadowIconName.PlannedCow => "round",
        MeadowIconName.PlannedClaw => "round",
        MeadowIconName.ChevronDown => "round",
        MeadowIconName.Check => "round",
        MeadowIconName.ArrowRight => "round",
        MeadowIconName.Smartphone => "round",
        _ => "miter"
    };
}
