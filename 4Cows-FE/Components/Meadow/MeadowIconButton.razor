@* st.tinyBtn / st.tinyBtnDanger — die Icon-Aktionen in Tabellenzeilen. *@
<button type="button" class="@CssClass" title="@Title" aria-label="@Title"
        disabled="@Disabled" @onclick="OnClick">
    <MeadowIcon Name="Icon" Size="@Size" />
</button>

@code {
    [Parameter, EditorRequired] public MeadowIconName Icon { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public bool Danger { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public int Size { get; set; } = 15;
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private string CssClass =>
        $"mw-tiny-btn {(Danger ? "mw-tiny-btn--danger" : "")} {Class}".Replace("  ", " ").Trim();
}
