@using _4Cows_FE.Components._4CowsComponent.Dialogs
@using _4Cows_FE.Components.Meadow

@inject CowService CowService
@inject ClawTreatmentService ClawTreatmentService
@inject SettingsService Settings
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MeadowToolbar>
    <Left>
        <MeadowSearchBox Value="@_search" ValueChanged="OnSearchChanged"
                         AriaLabel="Klauen Behandlungen durchsuchen" />
    </Left>
</MeadowToolbar>

<MeadowTable TItem="ClawTreatment" Items="_rows" Columns="_columns"
             RowKey="@(r => r.ClawTreatmentId)"
             Class="mw-table-wrap--dense" ShowMobileCards="false"
             DefaultSortTitle="Datum" DefaultSortDescending="true"
             PagerLabel="Behandlungen pro Seite"
             EmptyText="Keine Behandlungen gefunden." />

@code {
    private List<ClawTreatment> _all = new();
    private List<ClawTreatment> _rows = new();
    private string _search = "";

    // Die Zusammenfassung wird einmal pro Datenladen gebaut, nicht pro
    // Tastendruck - sie liest alle vier Befunde plus Verband und Klotz.
    private Dictionary<int, string> _summaries = new();

    private IReadOnlyList<MeadowColumn<ClawTreatment>> _columns = Array.Empty<MeadowColumn<ClawTreatment>>();

    protected override async Task OnInitializedAsync()
    {
        BuildColumns();
        await ClawTreatmentService.GetAllDataAsync();
        Rebuild();
    }

    private void BuildColumns() => _columns = new List<MeadowColumn<ClawTreatment>>
    {
        new()
        {
            Title = "Halsbandnummer",
            Text = r => CollarText(r),
            SortBy = r => CollarSortKey(r),
            Style = MeadowCellStyle.Bold
        },
        new()
        {
            Title = "Datum",
            Text = r => r.TreatmentDate.ToString("dd.MM.yyyy"),
            SortBy = r => r.TreatmentDate,
            NoWrap = true
        },
        new()
        {
            Title = "Befunde",
            Text = r => Summary(r),
            SortBy = r => Summary(r),
            MaxWidth = "360px",
            NoWrap = true
        },
        new()
        {
            IsActions = true,
            Template = row =>
                @<MeadowIconButton Icon="MeadowIconName.Trash" Title="Behandlung löschen"
                                   Danger="true" OnClick="() => Delete(row)" />
        }
    };

    private void Rebuild()
    {
        _all = ClawTreatmentService.GetClawTreatments();
        var fallback = Settings.ClawFindingFallback;
        _summaries = _all.ToDictionary(
            r => r.ClawTreatmentId,
            r => ClawFindingSummary.Build(r, fallback));
        ApplyFilter();
    }

    private string Summary(ClawTreatment row)
        => _summaries.TryGetValue(row.ClawTreatmentId, out var text) ? text : "";

    private string CollarText(ClawTreatment row)
    {
        var collar = CowService.GetCollarNumberByCowId(row.EarTagNumber);
        return collar == int.MinValue ? "—" : collar.ToString();
    }

    private int CollarSortKey(ClawTreatment row)
    {
        var collar = CowService.GetCollarNumberByCowId(row.EarTagNumber);
        return collar == int.MinValue ? int.MaxValue : collar;
    }

    private void OnSearchChanged(string value)
    {
        _search = value;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var term = _search.Trim();
        _rows = term.Length == 0
            ? _all.ToList()
            : _all.Where(r =>
                CollarText(r).Contains(term, StringComparison.OrdinalIgnoreCase)
                || Summary(r).Contains(term, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private async Task Delete(ClawTreatment row)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters<GenericDialog>
        {
            { x => x.HeaderText, "Löschen" },
            { x => x.Description, "Soll die Behandlung wirklich gelöscht werden?" },
            { x => x.AcceptButtonText, "Löschen" },
            { x => x.CancelButtonText, "Abbrechen" },
            { x => x.ColorScheme, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<GenericDialog>(string.Empty, parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        await ClawTreatmentService.DeleteDataAsync(row.ClawTreatmentId);
        await ClawTreatmentService.GetAllDataAsync();
        Rebuild();
        Snackbar.Add("Behandlung gelöscht.", Severity.Success);
    }
}
