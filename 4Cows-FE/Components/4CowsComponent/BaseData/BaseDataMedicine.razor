@using _4Cows_FE.Components._4CowsComponent.Dialogs.BaseData
@using _4Cows_FE.Components.Meadow

@inject MedicineService MedicineService
@inject IDialogService DialogService

<MeadowToolbar>
    <Left>
        <MeadowSearchBox Value="@_search" ValueChanged="OnSearchChanged"
                         AriaLabel="Medikamente durchsuchen" />
    </Left>
</MeadowToolbar>

<MeadowTable TItem="Medicine" Items="_rows" Columns="_columns"
             RowKey="@(m => m.MedicineId)"
             Class="mw-table-wrap--dense" ShowMobileCards="false"
             DefaultSortTitle="Medikamentenname"
             PagerLabel="Medikamente pro Seite"
             EmptyText="Keine Medikamente gefunden." />

@code {
    private List<Medicine> _all = new();
    private List<Medicine> _rows = new();
    private string _search = "";

    private IReadOnlyList<MeadowColumn<Medicine>> _columns = Array.Empty<MeadowColumn<Medicine>>();

    protected override async Task OnInitializedAsync()
    {
        BuildColumns();
        await MedicineService.GetAllDataAsync();
        Reload();
    }

    private void BuildColumns() => _columns = new List<MeadowColumn<Medicine>>
    {
        new()
        {
            Title = "ID",
            Text = m => m.MedicineId.ToString(),
            SortBy = m => m.MedicineId,
            Style = MeadowCellStyle.Mono,
            Width = "70px"
        },
        new()
        {
            Title = "Medikamentenname",
            Text = m => m.MedicineName,
            SortBy = m => m.MedicineName,
            Style = MeadowCellStyle.Bold
        },
        new()
        {
            IsActions = true,
            Template = medicine =>
                @<MeadowIconButton Icon="MeadowIconName.Edit" Title="Medikament ändern"
                                   OnClick="() => OpenMedicineDialog(medicine)" />
        }
    };

    private void Reload()
    {
        _all = MedicineService.Medicines.Values.ToList();
        ApplyFilter();
    }

    private void OnSearchChanged(string value)
    {
        _search = value;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var term = _search.Trim();
        _rows = term.Length == 0
            ? _all.ToList()
            : _all.Where(m => m.MedicineName.Contains(term, StringComparison.OrdinalIgnoreCase))
                .ToList();
    }

    private async Task OpenMedicineDialog(Medicine medicine)
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false
        };
        var parameters = new DialogParameters<EditMedicineDialog>
        {
            { x => x._Medicine, medicine }
        };

        var dialog = await DialogService.ShowAsync<EditMedicineDialog>(
            string.Empty, parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        await MedicineService.GetAllDataAsync();
        Reload();
    }
}
