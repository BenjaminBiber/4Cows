@using _4Cows_FE.Components.Meadow

@inject ISnackbar Snackbar
@inject CowTreatmentService cowTreatmentService
@inject CowService cowService
@inject MedicineService medicineService
@inject WhereHowService WhereHowService
@inject UdderService UdderService
@inject TreatmentReasonService TreatmentReasonService
@inject SettingsService SettingsService

<MeadowDialog Title="Kuh Behandlung hinzufügen" Size="MeadowDialogSize.Cow">
    <ChildContent>
        @* Mehrere Tiere mit gleichem Datum und gleichem Grund. Medikament,
           Menge und Wie/Wo stehen in den Karten weiter unten - jedes Tier
           bekommt jedes Medikament. *@
        @foreach (var entry in _numbers)
        {
            <div class="mw-field-row" @key="entry">
                <div class="mw-col">
                    <span class="mw-label">Halsbandnummer</span>
                    <div class="mw-field">
                        <MudNumericField T="int?" Label="Halsbandnummer" Variant="Variant.Text" HideSpinButtons="true"
                                         Immediate="true" Value="@entry.Value"
                                         ValueChanged="@(v => OnCollarChanged(entry, v))"
                                         Placeholder="z.B. 142" />
                    </div>
                </div>
                <div class="mw-col mw-col--wide">
                    <span class="mw-label">Kuh / Kalb</span>
                    <div class="mw-field">
                        <MudAutocomplete T="string" Label="Kuh / Kalb" Variant="Variant.Text"
                                         SearchFunc="cowService.SearchCows"
                                         ToStringFunc="cowService.GetDisplayLabel"
                                         ResetValueOnEmptyText="true" Immediate="true"
                                         Value="@entry.EarValue"
                                         ValueChanged="@(v => OnCowChanged(entry, v))"
                                         Placeholder="DE 08 1523 …" />
                    </div>
                </div>
                @if (_numbers.Count > 1)
                {
                    <MeadowIconButton Icon="MeadowIconName.Trash" Title="Tier entfernen"
                                      Danger="true" OnClick="() => _numbers.Remove(entry)" />
                }
            </div>
        }

        <button type="button" class="mw-add-row" @onclick="AddRow">
            <MeadowIcon Name="MeadowIconName.Plus" Size="16" />
            <span>Weiteres Tier hinzufügen</span>
        </button>

        <div>
            <span class="mw-label">Verabreichungsdatum</span>
            <div class="mw-field">
                <MudDatePicker Label="Verabreichungsdatum" Variant="Variant.Text" Editable="true"
                               DateFormat="dd.MM.yyyy" @bind-Date="NullDate" />
            </div>
        </div>

        <MeadowMedicationRows Rows="_medications" OnChanged="StateHasChanged" />

        <div>
            <label class="mw-label" for="mw-reason">Behandlungsgrund</label>
            <div class="mw-field">
                @* Optional: leer lassen ist erlaubt und loest in Save keine
                   Meldung aus. CoerceValue wie beim Medikament - ein
                   unbekannter Grund wird beim Speichern angelegt. *@
                <MudAutocomplete T="string" InputId="mw-reason" Variant="Variant.Text"
                                 SelectValueOnTab="true" CoerceValue="true"
                                 ResetValueOnEmptyText="true"
                                 @bind-Value="ReasonName"
                                 SearchFunc="TreatmentReasonService.SearchAsync"
                                 Placeholder="optional, z.B. Mastitis" />
            </div>
        </div>

        @if (TotalTreatments > 1)
        {
            @* Ohne diesen Hinweis ist das Kreuzprodukt erst an der
               Erfolgsmeldung zu merken - und dann stehen die Zeilen schon in
               der Tabelle. *@
            <div class="mw-hint">
                Jedes Tier bekommt jedes Medikament: @TotalTreatments Behandlungen werden gespeichert.
            </div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="mw-btn mw-btn--plain mw-btn--wide" @onclick="Cancel">
            Abbrechen
        </button>
        <button type="button" class="mw-btn mw-btn--primary mw-btn--wide" @onclick="Save">
            Speichern
        </button>
    </Footer>
</MeadowDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>
    /// Vorbelegung, nicht Ablage: gelesen wird sie nur in OnInitialized, und
    /// zurueckgeschrieben wird nie. Gesetzt wird sie ausschliesslich von
    /// Planned_Cow_Table.Complete, um eine geplante Behandlung abzuschliessen.
    /// </summary>
    [Parameter] public CowTreatment Cow_Treatment { get; set; } = new();

    private readonly List<NumberEntry> _numbers = new();
    private readonly List<MedicationEntry> _medications = new();
    private DateTime? NullDate;
    private string? ReasonName;

    private int TotalTreatments => _numbers.Count * _medications.Count;

    protected override void OnInitialized()
    {
        var seed = new MedicationEntry();

        if (!string.IsNullOrEmpty(Cow_Treatment.EarTagNumber))
        {
            var collar = cowService.GetCollarNumberByCowId(Cow_Treatment.EarTagNumber);
            _numbers.Add(new NumberEntry
            {
                Value = collar == int.MinValue ? null : collar,
                EarValue = Cow_Treatment.EarTagNumber
            });

            // Bewusst ueber den Cache und nicht ueber GetMedicineNameById: das
            // liefert bei unbekannter ID "--", und diese Striche stuenden dann
            // im Eingabefeld - und wuerden beim Speichern als Medikament
            // angelegt. Dieselbe Falle wie beim Behandlungsgrund weiter unten.
            if (medicineService.Medicines.TryGetValue(Cow_Treatment.MedicineId, out var medicine))
            {
                seed.MedicineName = medicine.MedicineName;
            }

            seed.Dosage = Cow_Treatment.MedicineDosage;
        }
        else
        {
            _numbers.Add(new NumberEntry());
        }

        // Einheit passend zum vorbelegten Medikament, damit am Mengenfeld von
        // Anfang an die richtige steht. Ohne Medikament ist es die
        // Voreinstellung.
        seed.DosageUnit = MedicationRows.ResolveUnit(seed.MedicineName, medicineService, SettingsService);

        // ERST die Viertel uebernehmen, DANN das Wie/Wo setzen: ApplyWhereHow
        // loescht die Viertel, wenn das Wie/Wo keine Auswahl traegt. Genau
        // diese Reihenfolge hatte der Dialog auch vorher, als die Viertel noch
        // am Parameter hingen.
        seed.UdderId = Cow_Treatment.UdderId;

        if (Cow_Treatment.WhereHowId != int.MinValue)
        {
            // Ueber ApplyWhereHow, damit der Euter-Knopf bei einem vorbelegten
            // Wie/Wo mit ShowDialog sofort erscheint.
            MedicationRows.ApplyWhereHow(
                seed, WhereHowService.GetWhereHowNameById(Cow_Treatment.WhereHowId), WhereHowService);

            // Beim Abschluss einer geplanten Behandlung gewinnt die geplante
            // Verabreichungsart gegen den Standard des Medikaments: sie wurde
            // bewusst geplant. ApplyWhereHow setzt das Flag ohnehin schon auf
            // false, hier steht es nur ausdruecklich.
            seed.WhereHowAutoFilled = false;
        }
        else
        {
            MedicationRows.ApplyMedicine(
                seed, seed.MedicineName, medicineService, WhereHowService, SettingsService);
        }

        _medications.Add(seed);

        NullDate = Cow_Treatment.AdministrationDate == default
            ? DateTime.Now
            : Cow_Treatment.AdministrationDate;

        // Der Abschluss-Dialog einer geplanten Behandlung bekommt den Grund
        // vorbelegt. Bewusst ueber den Cache und nicht ueber GetNameById: das
        // liefert bei unbekannter ID "–", und dieses Zeichen stuende dann im
        // Eingabefeld - und wuerde beim Speichern als Grund angelegt.
        if (Cow_Treatment.TreatmentReasonId is int reasonId
            && TreatmentReasonService.Reasons.TryGetValue(reasonId, out var reason))
        {
            ReasonName = reason.TreatmentReasonName;
        }
    }

    private void AddRow() => _numbers.Add(new NumberEntry());

    // Halsbandnummer und Kuh/Kalb befuellen sich gegenseitig.
    private void OnCollarChanged(NumberEntry entry, int? value)
    {
        entry.Value = value;
        entry.EarValue = value.HasValue ? cowService.GetCowIdByCollarNumber(value.Value) : null;
    }

    private void OnCowChanged(NumberEntry entry, string? cowId)
    {
        entry.EarValue = cowId;
        if (string.IsNullOrEmpty(cowId))
        {
            entry.Value = null;
            return;
        }

        var collar = cowService.GetCollarNumberByCowId(cowId);
        entry.Value = collar == int.MinValue ? null : collar;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        if (NullDate is null)
        {
            Snackbar.Add("Bitte ein Verabreichungsdatum wählen.", Severity.Error);
            return;
        }

        // ALLE Zeilen vorab pruefen. Bisher stand das return in der
        // Einfuege-Schleife: ein Fehler in Zeile 3 liess Zeile 1 und 2
        // gespeichert zurueck, waehrend der Dialog "abgebrochen" aussah.
        var invalid = _numbers
            .Where(n => !n.Value.HasValue || n.Value == 0 || string.IsNullOrEmpty(n.EarValue))
            .ToList();

        if (invalid.Count > 0)
        {
            Snackbar.Add(
                "Hals- und Ohrmarkennummer müssen bei jedem Tier gesetzt sein.",
                Severity.Error);
            return;
        }

        // Medikament, Wie/Wo, Menge und Viertel JEDER Karte - aufgeloest, bevor
        // irgendetwas geschrieben wird. Die Meldung kommt aus ResolveAsync
        // selbst, null heisst abbrechen.
        var medications = await MedicationRows.ResolveAsync(
            _medications, medicineService, WhereHowService, UdderService, Snackbar);

        if (medications is null)
        {
            return;
        }

        // Optional: ein leeres Feld ist gueltig und ergibt null. Aufgeloest
        // wird VOR der Einfuege-Schleife - wie die Medikamente, damit ein
        // Fehlschlag keine halb gespeicherte Serie zuruecklaesst.
        int? reasonId = null;
        if (!string.IsNullOrWhiteSpace(ReasonName))
        {
            var resolved = await TreatmentReasonService.GetIdByNameAsync(ReasonName);
            if (resolved == int.MinValue)
            {
                Snackbar.Add("Behandlungsgrund konnte nicht gespeichert werden.", Severity.Error);
                return;
            }

            reasonId = resolved;
        }

        // Kreuzprodukt, Tier aussen: so stehen in der Tabelle alle Mittel von
        // Tier 1 beieinander, dann die von Tier 2.
        //
        // Pro Paar eine NEUE Entitaet. Eine wiederverwendete Instanz waere beim
        // zweiten Add dieselbe - nun getrackte - Zeile, und AddRange schriebe
        // sie still nur einmal.
        var treatments = new List<CowTreatment>(_numbers.Count * medications.Count);
        foreach (var entry in _numbers)
        {
            foreach (var medication in medications)
            {
                treatments.Add(new CowTreatment
                {
                    EarTagNumber = entry.EarValue!,
                    MedicineId = medication.MedicineId,
                    MedicineDosage = medication.Dosage,
                    WhereHowId = medication.WhereHowId,
                    AdministrationDate = NullDate.Value,
                    UdderId = medication.UdderId,
                    TreatmentReasonId = reasonId
                });
            }
        }

        if (!await cowTreatmentService.InsertRangeAsync(treatments))
        {
            // Der Dialog bleibt OFFEN: es ist nichts gespeichert, und die
            // Eingaben sollen fuer einen zweiten Versuch stehenbleiben. Vorher
            // schloss der Dialog hier und die Eingaben waren weg.
            Snackbar.Add(
                "Speichern fehlgeschlagen. Es wurde keine Behandlung gespeichert.",
                Severity.Error);
            return;
        }

        Snackbar.Add(SavedMessage(_numbers.Count, medications.Count), Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    // Eine Meldung, nicht eine pro Tier. Die Aufschluesselung nur, wenn beides
    // mehr als eins ist: sechs Zeilen aus zwei Eingaben ueberrascht sonst.
    private static string SavedMessage(int animals, int medications)
    {
        var total = animals * medications;

        if (total == 1)
        {
            return "Behandlung gespeichert.";
        }

        return animals > 1 && medications > 1
            ? $"{total} Behandlungen gespeichert ({animals} Tiere × {medications} Medikamente)."
            : $"{total} Behandlungen gespeichert.";
    }
}
