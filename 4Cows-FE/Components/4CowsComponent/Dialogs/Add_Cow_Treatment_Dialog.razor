@using _4Cows_FE.Components.Meadow

@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject CowTreatmentService cowTreatmentService
@inject CowService cowService
@inject MedicineService medicineService
@inject WhereHowService WhereHowService
@inject UdderService UdderService
@inject TreatmentReasonService TreatmentReasonService

<MeadowDialog Title="Kuh Behandlung hinzufügen" Size="MeadowDialogSize.Cow">
    <ChildContent>
        @* Mehrere Tiere mit gleicher Medikation, Datum und Menge. *@
        @foreach (var entry in _numbers)
        {
            <div class="mw-field-row" @key="entry">
                <div class="mw-col">
                    <span class="mw-label">Halsbandnummer</span>
                    <div class="mw-field">
                        <MudNumericField T="int?" Label="Halsbandnummer" Variant="Variant.Text" HideSpinButtons="true"
                                         Immediate="true" Value="@entry.Value"
                                         ValueChanged="@(v => OnCollarChanged(entry, v))"
                                         Placeholder="z.B. 142" />
                    </div>
                </div>
                <div class="mw-col mw-col--wide">
                    <span class="mw-label">Kuh / Kalb</span>
                    <div class="mw-field">
                        <MudAutocomplete T="string" Label="Kuh / Kalb" Variant="Variant.Text"
                                         SearchFunc="cowService.SearchCows"
                                         ToStringFunc="cowService.GetDisplayLabel"
                                         ResetValueOnEmptyText="true" Immediate="true"
                                         Value="@entry.EarValue"
                                         ValueChanged="@(v => OnCowChanged(entry, v))"
                                         Placeholder="DE 08 1523 …" />
                    </div>
                </div>
                @if (_numbers.Count > 1)
                {
                    <MeadowIconButton Icon="MeadowIconName.Trash" Title="Tier entfernen"
                                      Danger="true" OnClick="() => _numbers.Remove(entry)" />
                }
            </div>
        }

        <button type="button" class="mw-add-row" @onclick="AddRow">
            <MeadowIcon Name="MeadowIconName.Plus" Size="16" />
            <span>Weiteres Tier hinzufügen</span>
        </button>

        <div>
            <span class="mw-label">Verabreichungsdatum</span>
            <div class="mw-field">
                <MudDatePicker Label="Verabreichungsdatum" Variant="Variant.Text" Editable="true"
                               DateFormat="dd.MM.yyyy" @bind-Date="NullDate" />
            </div>
        </div>

        <div>
            <label class="mw-label" for="mw-medicine">Medikament</label>
            <div class="mw-field">
                @* CoerceValue bleibt: unbekannte Medikamente werden beim
                   Speichern angelegt (MedicineService.GetMedicineIdByName). *@
                <MudAutocomplete T="string" InputId="mw-medicine" Variant="Variant.Text"
                                 SelectValueOnTab="true" CoerceValue="true"
                                 @bind-Value="MedicineName"
                                 SearchFunc="@((string s, CancellationToken c) =>
                                     cowTreatmentService.SearchCowTreatmentMedicaments(s, c, medicineService))"
                                 Placeholder="Medikament suchen…" />
            </div>
        </div>

        <div class="mw-field-row">
            <div class="mw-col mw-col--double">
                <label class="mw-label" for="mw-wherehow">Wie / Wo</label>
                @* Die Icons bleiben Geschwister des Feldes: MudAutocomplete
                   erlaubt nur ein Adornment, hier braucht es bis zu zwei. *@
                <div class="mw-field mw-field--row">
                    <MudAutocomplete T="string" InputId="mw-wherehow" Variant="Variant.Text"
                                     SelectValueOnTab="true" CoerceValue="true" CoerceText="true"
                                     Immediate="true"
                                     Value="@_selectedWhereHow"
                                     ValueChanged="OnWhereHowChanged"
                                     SearchFunc="@((string s, CancellationToken c) =>
                                         cowTreatmentService.SearchCowTreatmentWhereHow(s, c))"
                                     Placeholder="z.B. Euter · VL" />

                    @if (_showEditWhereHowOptions)
                    {
                        <MeadowIconButton Icon="@(_showDialogForNewWhereHow ? MeadowIconName.Claw : MeadowIconName.Cow)"
                                          Title="@(_showDialogForNewWhereHow
                                                   ? "Mit Viertel-Auswahl (aktiv)"
                                                   : "Ohne Viertel-Auswahl")"
                                          Size="16"
                                          OnClick="() => _showDialogForNewWhereHow = !_showDialogForNewWhereHow" />
                        <MeadowIconButton Icon="MeadowIconName.Plus" Title="Wie / Wo speichern"
                                          Size="16" OnClick="SaveNewWhereHow" />
                    }
                    else if (_showUdderButton)
                    {
                        @* Danger, solange kein Viertel gewaehlt ist: sonst
                           waere die neue Pflicht erst nach dem Klick auf
                           Speichern zu sehen. *@
                        <MeadowIconButton Icon="MeadowIconName.Cow" Title="@UdderButtonTitle"
                                          Danger="@(!UdderService.HasAnyQuarter(Cow_Treatment.UdderId))"
                                          Size="16" OnClick="OpenUdderDialog" />
                    }
                </div>
            </div>
            <div class="mw-col">
                <label class="mw-label" for="mw-dosage">Menge</label>
                <div class="mw-field">
                    <MudNumericField T="float" InputId="mw-dosage" Variant="Variant.Text"
                                     HideSpinButtons="true"
                                     @bind-Value="Cow_Treatment.MedicineDosage"
                                     Placeholder="20" />
                </div>
            </div>
        </div>

        <div>
            <label class="mw-label" for="mw-reason">Behandlungsgrund</label>
            <div class="mw-field">
                @* Optional: leer lassen ist erlaubt und loest in Save keine
                   Meldung aus. CoerceValue wie beim Medikament - ein
                   unbekannter Grund wird beim Speichern angelegt. *@
                <MudAutocomplete T="string" InputId="mw-reason" Variant="Variant.Text"
                                 SelectValueOnTab="true" CoerceValue="true"
                                 ResetValueOnEmptyText="true"
                                 @bind-Value="ReasonName"
                                 SearchFunc="TreatmentReasonService.SearchAsync"
                                 Placeholder="optional, z.B. Mastitis" />
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="mw-btn mw-btn--plain mw-btn--wide" @onclick="Cancel">
            Abbrechen
        </button>
        <button type="button" class="mw-btn mw-btn--primary mw-btn--wide" @onclick="Save">
            Speichern
        </button>
    </Footer>
</MeadowDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public CowTreatment Cow_Treatment { get; set; } = new();

    private readonly List<NumberEntry> _numbers = new();
    private DateTime? NullDate;
    private string? MedicineName;
    private string? ReasonName;
    private string _selectedWhereHow = "";
    private bool _showEditWhereHowOptions;
    private bool _showDialogForNewWhereHow;
    private bool _showUdderButton;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Cow_Treatment.EarTagNumber))
        {
            var collar = cowService.GetCollarNumberByCowId(Cow_Treatment.EarTagNumber);
            _numbers.Add(new NumberEntry
            {
                Value = collar == int.MinValue ? null : collar,
                EarValue = Cow_Treatment.EarTagNumber
            });
            MedicineName = medicineService.GetMedicineNameById(Cow_Treatment.MedicineId);
        }
        else
        {
            _numbers.Add(new NumberEntry());
        }

        NullDate = Cow_Treatment.AdministrationDate == default
            ? DateTime.Now
            : Cow_Treatment.AdministrationDate;

        if (Cow_Treatment.WhereHowId != int.MinValue)
        {
            // Ueber OnWhereHowChanged, damit der Euter-Button bei einem
            // vorbelegten Wie/Wo mit ShowDialog sofort erscheint.
            OnWhereHowChanged(WhereHowService.GetWhereHowNameById(Cow_Treatment.WhereHowId));
        }

        // Der Abschluss-Dialog einer geplanten Behandlung bekommt den Grund
        // vorbelegt. Bewusst ueber den Cache und nicht ueber GetNameById: das
        // liefert bei unbekannter ID "–", und dieses Zeichen stuende dann im
        // Eingabefeld - und wuerde beim Speichern als Grund angelegt.
        if (Cow_Treatment.TreatmentReasonId is int reasonId
            && TreatmentReasonService.Reasons.TryGetValue(reasonId, out var reason))
        {
            ReasonName = reason.TreatmentReasonName;
        }
    }

    private void AddRow() => _numbers.Add(new NumberEntry());

    // Halsbandnummer und Kuh/Kalb befuellen sich gegenseitig.
    private void OnCollarChanged(NumberEntry entry, int? value)
    {
        entry.Value = value;
        entry.EarValue = value.HasValue ? cowService.GetCowIdByCollarNumber(value.Value) : null;
    }

    private void OnCowChanged(NumberEntry entry, string? cowId)
    {
        entry.EarValue = cowId;
        if (string.IsNullOrEmpty(cowId))
        {
            entry.Value = null;
            return;
        }

        var collar = cowService.GetCollarNumberByCowId(cowId);
        entry.Value = collar == int.MinValue ? null : collar;
    }

    private void OnWhereHowChanged(string? value)
    {
        _selectedWhereHow = value ?? "";
        var text = _selectedWhereHow.Trim();

        var known = WhereHowService.WhereHows.Values
            .FirstOrDefault(w => string.Equals(w.WhereHowName.Trim(), text, StringComparison.OrdinalIgnoreCase));

        _showUdderButton = known?.ShowDialog ?? false;
        _showEditWhereHowOptions = known is null && text.Length > 0;

        // Ohne Viertel-Auswahl darf keine haengenbleiben: wer erst "Euter"
        // mit LV waehlt und dann auf "i.m." wechselt, speicherte sonst die
        // Viertel der verworfenen Auswahl mit.
        if (!_showUdderButton)
        {
            Cow_Treatment.UdderId = int.MinValue;
        }
    }

    private async Task SaveNewWhereHow()
    {
        if (string.IsNullOrWhiteSpace(_selectedWhereHow))
        {
            Snackbar.Add("Wie / Wo ist leer.", Severity.Error);
            return;
        }

        if (!await Confirm("Speichern", $"„{_selectedWhereHow}\" als Wie / Wo speichern?", "Ja", Color.Warning))
        {
            return;
        }

        // Rueckgabewert auswerten: schlaegt der Insert fehl - etwa an der
        // UNIQUE-Spalte auf Alt-Bestaenden, wenn jemand parallel denselben
        // Namen anlegt - lief der Dialog vorher weiter und meldete Erfolg.
        var inserted = await WhereHowService.InsertDataAsync(new WhereHow
        {
            WhereHowName = _selectedWhereHow.Trim(),
            ShowDialog = _showDialogForNewWhereHow
        });

        if (!inserted)
        {
            Snackbar.Add("Wie / Wo konnte nicht gespeichert werden.", Severity.Error);
            return;
        }

        _showEditWhereHowOptions = false;

        // Der neue Eintrag steht jetzt im Cache. Traegt er die Viertel-
        // Auswahl, muss der Euter-Knopf erreichbar bleiben: bricht der Nutzer
        // den Viertel-Dialog gleich darunter ab, waere er sonst mit einem
        // Wie/Wo ohne Viertel eingesperrt, das Save nicht mehr durchlaesst.
        _showUdderButton = _showDialogForNewWhereHow;

        if (_showDialogForNewWhereHow)
        {
            await OpenUdderDialog();
        }
        else
        {
            Cow_Treatment.UdderId = await UdderService.GetIdForNoQuarters();
        }
    }

    private async Task OpenUdderDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<UdderDialog>(string.Empty, options);
        var result = await dialog.Result;

        // Abbruch darf NICHT als "keine Viertel" durchgehen - dann bliebe die
        // vorher getroffene Auswahl bestehen.
        if (result is null || result.Canceled || result.Data is not int id || id == int.MinValue)
        {
            return;
        }

        Cow_Treatment.UdderId = id;

        // Der Knopf bleibt stehen (vorher: _showUdderButton = false). Er ist
        // jetzt der einzige Weg, eine getroffene Auswahl noch zu aendern -
        // und sein Titel ist die einzige Stelle, an der sie ueberhaupt zu
        // sehen ist.
    }

    private string UdderButtonTitle
    {
        get
        {
            if (!UdderService.HasAnyQuarter(Cow_Treatment.UdderId))
            {
                return "Euterviertel wählen — erforderlich";
            }

            var quarters = WhereHowService.GetUdderString(
                UdderService.GetById(Cow_Treatment.UdderId));
            return $"Euterviertel {quarters} — ändern";
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        if (NullDate is null)
        {
            Snackbar.Add("Bitte ein Verabreichungsdatum wählen.", Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(MedicineName))
        {
            Snackbar.Add("Bitte ein Medikament angeben.", Severity.Error);
            return;
        }

        // ALLE Zeilen vorab pruefen. Bisher stand das return in der
        // Einfuege-Schleife: ein Fehler in Zeile 3 liess Zeile 1 und 2
        // gespeichert zurueck, waehrend der Dialog "abgebrochen" aussah.
        var invalid = _numbers
            .Where(n => !n.Value.HasValue || n.Value == 0 || string.IsNullOrEmpty(n.EarValue))
            .ToList();

        if (invalid.Count > 0)
        {
            Snackbar.Add(
                "Hals- und Ohrmarkennummer müssen bei jedem Tier gesetzt sein.",
                Severity.Error);
            return;
        }

        var medicineId = await medicineService.GetMedicineIdByName(MedicineName);
        if (medicineId == int.MinValue)
        {
            Snackbar.Add("Medikament nicht gefunden!", Severity.Error);
            return;
        }

        var whereHowId = await WhereHowService.GetWhereHowIDByName(_selectedWhereHow, _showDialogForNewWhereHow);
        if (whereHowId == int.MinValue)
        {
            Snackbar.Add("Wie/Wo nicht gefunden!", Severity.Error);
            return;
        }

        // Traegt das Wie/Wo die Viertel-Auswahl, ist "kein Viertel" keine
        // gueltige Angabe. Vorher fiel Save hier still auf
        // GetIdForNoQuarters() zurueck: wer den Euter-Knopf nie antippte oder
        // den Viertel-Dialog abbrach, speicherte eine Euterbehandlung ohne
        // Viertel - in der Tabelle nur an einem fehlenden "(LV)" zu erkennen.
        //
        // ShowDialog wird am aufgeloesten Eintrag gelesen, nicht an
        // _showDialogForNewWhereHow: der Toggle gilt nur fuer neu angelegte
        // Wie/Wos, und new WhereHow() hat ShowDialog = true.
        var whereHow = WhereHowService.GetById(whereHowId);
        if (whereHow.ShowDialog && !UdderService.HasAnyQuarter(Cow_Treatment.UdderId))
        {
            Snackbar.Add(
                $"„{whereHow.WhereHowName}\" braucht mindestens ein Euterviertel.",
                Severity.Error);
            return;
        }

        var udderId = Cow_Treatment.UdderId == int.MinValue
            ? await UdderService.GetIdForNoQuarters()
            : Cow_Treatment.UdderId;

        // Optional: ein leeres Feld ist gueltig und ergibt null. Aufgeloest
        // wird VOR der Einfuege-Schleife - wie Medikament und Wie/Wo, damit
        // ein Fehlschlag keine halb gespeicherte Serie zuruecklaesst.
        int? reasonId = null;
        if (!string.IsNullOrWhiteSpace(ReasonName))
        {
            var resolved = await TreatmentReasonService.GetIdByNameAsync(ReasonName);
            if (resolved == int.MinValue)
            {
                Snackbar.Add("Behandlungsgrund konnte nicht gespeichert werden.", Severity.Error);
                return;
            }

            reasonId = resolved;
        }

        var saved = 0;
        foreach (var entry in _numbers)
        {
            var success = await cowTreatmentService.InsertDataAsync(new CowTreatment
            {
                EarTagNumber = entry.EarValue!,
                MedicineId = medicineId,
                MedicineDosage = Cow_Treatment.MedicineDosage,
                WhereHowId = whereHowId,
                AdministrationDate = NullDate.Value,
                UdderId = udderId,
                TreatmentReasonId = reasonId
            });

            if (!success)
            {
                Snackbar.Add(
                    $"Speichern fehlgeschlagen bei Halsbandnummer {entry.Value}. "
                    + $"{saved} von {_numbers.Count} Behandlungen wurden gespeichert.",
                    Severity.Error);
                MudDialog.Close(DialogResult.Ok(saved > 0));
                return;
            }

            saved++;
        }

        // Eine Meldung, nicht eine pro Tier.
        Snackbar.Add(
            saved == 1 ? "Behandlung gespeichert." : $"{saved} Behandlungen gespeichert.",
            Severity.Success);

        MudDialog.Close(DialogResult.Ok(true));
    }

    private async Task<bool> Confirm(string header, string description, string accept, Color scheme)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters<GenericDialog>
        {
            { x => x.HeaderText, header },
            { x => x.Description, description },
            { x => x.AcceptButtonText, accept },
            { x => x.CancelButtonText, "Abbrechen" },
            { x => x.ColorScheme, scheme }
        };

        var dialog = await DialogService.ShowAsync<GenericDialog>(string.Empty, parameters, options);
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }
}
