@using _4Cows_FE.Components.Meadow

@inject ISnackbar Snackbar
@inject PCowTreatmentService pCowTreatmentService
@inject CowService cowService
@inject MedicineService medicineService
@inject WhereHowService WhereHowService
@inject UdderService UdderService
@inject TreatmentReasonService TreatmentReasonService
@inject SettingsService SettingsService

<MeadowDialog Title="Kuh Behandlung planen" Size="MeadowDialogSize.Cow">
    <ChildContent>
        @* Mehrere Tiere mit gleichem Datum und gleichem Grund. Medikament,
           Menge und Wie/Wo stehen in den Karten weiter unten - jedes Tier
           bekommt jedes Medikament. *@
        @foreach (var entry in _numbers)
        {
            <div class="mw-field-row" @key="entry">
                <div class="mw-col">
                    <span class="mw-label">Halsbandnummer</span>
                    <div class="mw-field">
                        <MudNumericField T="int?" Label="Halsbandnummer" Variant="Variant.Text" HideSpinButtons="true"
                                         Immediate="true" Value="@entry.Value"
                                         ValueChanged="@(v => OnCollarChanged(entry, v))"
                                         Placeholder="z.B. 142" />
                    </div>
                </div>
                <div class="mw-col mw-col--wide">
                    <span class="mw-label">Kuh / Kalb</span>
                    <div class="mw-field">
                        <MudAutocomplete T="string" Label="Kuh / Kalb" Variant="Variant.Text"
                                         SearchFunc="cowService.SearchCows"
                                         ToStringFunc="cowService.GetDisplayLabel"
                                         ResetValueOnEmptyText="true" Immediate="true"
                                         Value="@entry.EarValue"
                                         ValueChanged="@(v => OnCowChanged(entry, v))"
                                         Placeholder="DE 08 1523 …" />
                    </div>
                </div>
                @if (_numbers.Count > 1)
                {
                    <MeadowIconButton Icon="MeadowIconName.Trash" Title="Tier entfernen"
                                      Danger="true" OnClick="() => _numbers.Remove(entry)" />
                }
            </div>
        }

        <button type="button" class="mw-add-row" @onclick="AddRow">
            <MeadowIcon Name="MeadowIconName.Plus" Size="16" />
            <span>Weiteres Tier hinzufügen</span>
        </button>

        <div>
            <span class="mw-label">Geplant für</span>
            <div class="mw-field">
                <MudDatePicker Label="Geplant für" Variant="Variant.Text" Editable="true"
                               DateFormat="dd.MM.yyyy" @bind-Date="NullDate" />
            </div>
        </div>

        <MeadowMedicationRows Rows="_medications" OnChanged="StateHasChanged" />

        <div>
            <label class="mw-label" for="mw-planned-reason">Behandlungsgrund</label>
            <div class="mw-field">
                @* Optional: leer lassen ist erlaubt und loest in Save keine
                   Meldung aus. CoerceValue wie beim Medikament - ein
                   unbekannter Grund wird beim Planen angelegt. *@
                <MudAutocomplete T="string" InputId="mw-planned-reason" Variant="Variant.Text"
                                 SelectValueOnTab="true" CoerceValue="true"
                                 ResetValueOnEmptyText="true"
                                 @bind-Value="_reasonName"
                                 SearchFunc="TreatmentReasonService.SearchAsync"
                                 Placeholder="optional, z.B. Mastitis" />
            </div>
        </div>

        @if (TotalTreatments > 1)
        {
            @* Ohne diesen Hinweis ist das Kreuzprodukt erst an der
               Erfolgsmeldung zu merken - und dann stehen die Zeilen schon in
               der Tabelle. *@
            <div class="mw-hint">
                Jedes Tier bekommt jedes Medikament: @TotalTreatments Behandlungen werden geplant.
            </div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="mw-btn mw-btn--plain mw-btn--wide" @onclick="Cancel">
            Abbrechen
        </button>
        <button type="button" class="mw-btn mw-btn--primary mw-btn--wide" @onclick="Save">
            Planen
        </button>
    </Footer>
</MeadowDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>
    /// Vorbelegtes Tier, gesetzt von der Kuh-Seite. Die Cow_ID, nicht die
    /// Ohrmarke und nicht die Halsbandnummer. Null oeffnet den Dialog leer wie
    /// bisher.
    ///
    /// Anders als bei den beiden erfassten Behandlungen gibt es hier keine
    /// Entitaet zum Vorbelegen: der Dialog plant mehrere Tiere auf einmal und
    /// haelt seinen Zustand deshalb in _numbers.
    /// </summary>
    [Parameter] public string? CowId { get; set; }

    private readonly List<NumberEntry> _numbers = new();
    private readonly List<MedicationEntry> _medications = new();
    private DateTime? NullDate;
    private string? _reasonName;

    private int TotalTreatments => _numbers.Count * _medications.Count;

    protected override void OnInitialized()
    {
        NullDate = DateTime.Now;

        if (string.IsNullOrEmpty(CowId))
        {
            _numbers.Add(new NumberEntry());
        }
        else
        {
            // Halsband darf leer bleiben: ein abgegangenes Tier hat keines
            // mehr, das die Suche findet - die Cow_ID identifiziert es
            // trotzdem.
            var collar = cowService.GetCollarNumberByCowId(CowId);
            _numbers.Add(new NumberEntry
            {
                Value = collar == int.MinValue ? null : collar,
                EarValue = CowId
            });
        }

        // Mit der Voreinstellung als Einheit: hier ist noch kein Medikament
        // gewaehlt, das eine eigene mitbringen koennte. Steht bewusst hinter
        // dem if/else und nicht in einem der Zweige - ohne
        // Medikamenten-Zeile hat der Dialog kein Mengenfeld.
        _medications.Add(new MedicationEntry { DosageUnit = SettingsService.DefaultDosageUnit });
    }

    private void AddRow() => _numbers.Add(new NumberEntry());

    private void OnCollarChanged(NumberEntry entry, int? value)
    {
        entry.Value = value;
        entry.EarValue = value.HasValue ? cowService.GetCowIdByCollarNumber(value.Value) : null;
    }

    private void OnCowChanged(NumberEntry entry, string? cowId)
    {
        entry.EarValue = cowId;
        if (string.IsNullOrEmpty(cowId))
        {
            entry.Value = null;
            return;
        }

        var collar = cowService.GetCollarNumberByCowId(cowId);
        entry.Value = collar == int.MinValue ? null : collar;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        if (NullDate is null)
        {
            Snackbar.Add("Bitte ein Datum wählen.", Severity.Error);
            return;
        }

        // Erst alle Zeilen pruefen, dann speichern.
        if (_numbers.Any(n => !n.Value.HasValue || n.Value == 0 || string.IsNullOrEmpty(n.EarValue)))
        {
            Snackbar.Add(
                "Hals- und Ohrmarkennummer müssen bei jedem Tier gesetzt sein.",
                Severity.Error);
            return;
        }

        // Medikament, Wie/Wo, Menge und Viertel JEDER Karte - aufgeloest, bevor
        // irgendetwas geschrieben wird. Die Meldung kommt aus ResolveAsync
        // selbst, null heisst abbrechen.
        var medications = await MedicationRows.ResolveAsync(
            _medications, medicineService, WhereHowService, UdderService, Snackbar);

        if (medications is null)
        {
            return;
        }

        // Optional: ein leeres Feld ist gueltig und ergibt null. Aufgeloest
        // wird VOR der Einfuege-Schleife - wie die Medikamente, damit ein
        // Fehlschlag keine halb gespeicherte Serie zuruecklaesst.
        int? reasonId = null;
        if (!string.IsNullOrWhiteSpace(_reasonName))
        {
            var resolved = await TreatmentReasonService.GetIdByNameAsync(_reasonName);
            if (resolved == int.MinValue)
            {
                Snackbar.Add("Behandlungsgrund konnte nicht gespeichert werden.", Severity.Error);
                return;
            }

            reasonId = resolved;
        }

        // Kreuzprodukt, Tier aussen: so stehen in der Tabelle alle Mittel von
        // Tier 1 beieinander, dann die von Tier 2.
        //
        // Pro Paar eine NEUE Entitaet. Eine wiederverwendete Instanz waere beim
        // zweiten Add dieselbe - nun getrackte - Zeile, und AddRange schriebe
        // sie still nur einmal.
        var planned = new List<PlannedCowTreatment>(_numbers.Count * medications.Count);
        foreach (var entry in _numbers)
        {
            foreach (var medication in medications)
            {
                planned.Add(new PlannedCowTreatment
                {
                    EarTagNumber = entry.EarValue!,
                    MedicineId = medication.MedicineId,
                    MedicineDosage = medication.Dosage,
                    WhereHowId = medication.WhereHowId,
                    AdministrationDate = NullDate.Value,
                    UdderId = medication.UdderId,
                    TreatmentReasonId = reasonId
                });
            }
        }

        if (!await pCowTreatmentService.InsertRangeAsync(planned))
        {
            // Der Dialog bleibt OFFEN: es ist nichts gespeichert, und die
            // Eingaben sollen fuer einen zweiten Versuch stehenbleiben. Vorher
            // schloss der Dialog hier und die Eingaben waren weg.
            Snackbar.Add(
                "Planen fehlgeschlagen. Es wurde keine Behandlung geplant.",
                Severity.Error);
            return;
        }

        Snackbar.Add(PlannedMessage(_numbers.Count, medications.Count), Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    // Eine Meldung, nicht eine pro Tier. Die Aufschluesselung nur, wenn beides
    // mehr als eins ist: sechs Zeilen aus zwei Eingaben ueberrascht sonst.
    private static string PlannedMessage(int animals, int medications)
    {
        var total = animals * medications;

        if (total == 1)
        {
            return "Behandlung geplant.";
        }

        return animals > 1 && medications > 1
            ? $"{total} Behandlungen geplant ({animals} Tiere × {medications} Medikamente)."
            : $"{total} Behandlungen geplant.";
    }
}
