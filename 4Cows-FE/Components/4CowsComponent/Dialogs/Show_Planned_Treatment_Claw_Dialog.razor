@using _4Cows_FE.Components.Meadow

@inject CowService cowService

@* Zeigt jetzt auch Beschreibung und Datum - beides wurde bisher nie angezeigt. *@
<MeadowDialog Title="@($"Geplante Klauen Behandlung · Nr. {Collar}")"
              Size="MeadowDialogSize.ShowClaw">
    <Meta>
        <div>
            <span class="mw-label">Halsband</span>
            <div class="mw-dlg-meta__value">Nr. @Collar</div>
        </div>
        <div>
            <span class="mw-label">Ohrmarke</span>
            <div class="mw-dlg-meta__mono">@EarTag</div>
        </div>
        <div>
            <span class="mw-label">Geplant für</span>
            <div class="mw-dlg-meta__value">
                @Planned_Claw_Treatment.TreatmentDate.ToString("dd.MM.yyyy")
            </div>
        </div>
    </Meta>
    <ChildContent>
        <div>
            <span class="mw-label">Beschreibung</span>
            <div class="mw-readonly">@Description</div>
        </div>

        <ClawSummary Planned="Planned_Claw_Treatment" />
    </ChildContent>
    <Footer>
        <button type="button" class="mw-btn mw-btn--plain mw-btn--wide" @onclick="Close">
            Schließen
        </button>
    </Footer>
</MeadowDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public PlannedClawTreatment Planned_Claw_Treatment { get; set; } = new();

    private string Collar
    {
        get
        {
            var collar = cowService.GetCollarNumberByCowId(Planned_Claw_Treatment.EarTagNumber);
            return collar == int.MinValue ? "–" : collar.ToString();
        }
    }

    private string EarTag => cowService.GetEarTagDisplay(Planned_Claw_Treatment.EarTagNumber);

    private string Description => string.IsNullOrWhiteSpace(Planned_Claw_Treatment.Desciption)
        ? "–"
        : Planned_Claw_Treatment.Desciption!;

    private void Close() => MudDialog.Cancel();
}
