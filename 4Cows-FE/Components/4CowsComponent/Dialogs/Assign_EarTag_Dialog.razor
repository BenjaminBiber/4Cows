@using _4Cows_FE.Components.Meadow

@inject ISnackbar Snackbar
@inject CowService cowService

<MeadowDialog Title="Ohrenmarke zuweisen" Size="MeadowDialogSize.Info">
    <ChildContent>
        <div>
            <span class="mw-label">Halsbandnummer</span>
            @* Nur-Lese-Wert: kein Eingabefeld, das man anfassen kann. *@
            <div class="mw-readonly">@Calf.CollarNumber</div>
        </div>

        <div>
            <label class="mw-label" for="mw-eartag">Ohrmarkennummer</label>
            <div class="mw-field">
                <MudTextField T="string" InputId="mw-eartag" Variant="Variant.Text"
                              Immediate="true" @bind-Value="EarTagNumber"
                              Placeholder="DE 08 1523 4567" />
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="mw-btn mw-btn--plain mw-btn--wide" @onclick="Cancel">
            Abbrechen
        </button>
        <button type="button" class="mw-btn mw-btn--primary mw-btn--wide" @onclick="Save">
            Speichern
        </button>
    </Footer>
</MeadowDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Cow Calf { get; set; } = new();

    private string EarTagNumber = "";

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        var earTag = EarTagNumber?.Trim() ?? "";
        if (string.IsNullOrEmpty(earTag))
        {
            Snackbar.Add("Ohrmarkennummer darf nicht leer sein!", Severity.Error);
            return;
        }

        // Die DB erzwingt das ueber einen Unique-Index; eine Meldung ist
        // freundlicher als ein fehlgeschlagenes Speichern.
        var existing = cowService.GetByEarTagNumber(earTag);
        if (existing != null && existing.CowId != Calf.CowId)
        {
            Snackbar.Add($"Ohrmarkennummer {earTag} ist bereits vergeben!", Severity.Error);
            return;
        }

        var success = await cowService.PromoteCalfAsync(Calf.CowId, earTag);
        if (!success)
        {
            Snackbar.Add("Zuweisen fehlgeschlagen.", Severity.Error);
            return;
        }

        Snackbar.Add($"Ohrenmarke {earTag} zugewiesen.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }
}
