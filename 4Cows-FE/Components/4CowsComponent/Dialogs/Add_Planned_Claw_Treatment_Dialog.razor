@using _4Cows_FE.Components.Meadow

@inject ISnackbar Snackbar
@inject PClawTreatmentService pClawTreatmentService
@inject CowService cowService

@*
    Bewusst ein Aufsatz aufs Design: der Prototyp zeigt im "geplant"-Zweig nur
    ein Beschreibungsfeld. Die vier Booleans Claw_Finding_* sind aber
    NOT NULL-Spalten, werden im Anzeige-Dialog dargestellt und in der Tabelle
    als Spalte "Klauen" gelistet - sie wegzulassen wuerde Daten zerstoeren.
    Also Beschreibung UND Klauen-Auswahl.
*@
<MeadowDialog Title="Geplante Klauen Behandlung" Size="MeadowDialogSize.Claw">
    <ChildContent>
        <div class="mw-field-row">
            <div class="mw-col">
                <label class="mw-label" for="mw-pcollar">Halsbandnummer</label>
                <div class="mw-field">
                    <MudNumericField T="int" InputId="mw-pcollar" Variant="Variant.Text"
                                     HideSpinButtons="true" @bind-Value="CollarNumber"
                                     Placeholder="z.B. 142" />
                </div>
            </div>
            <div class="mw-col">
                <span class="mw-label">Geplant für</span>
                <div class="mw-field">
                    <MudDatePicker Label="Geplant für" Variant="Variant.Text" Editable="true"
                                   DateFormat="dd.MM.yyyy" @bind-Date="NullDate" />
                </div>
            </div>
        </div>

        <div>
            <label class="mw-label" for="mw-pdesc">Beschreibung</label>
            <div class="mw-field">
                <MudTextField T="string" InputId="mw-pdesc" Variant="Variant.Text"
                              @bind-Value="Planned.Desciption"
                              Placeholder="z.B. Klotz entfernen, Verband kontrollieren…" />
            </div>
        </div>

        <span class="mw-label mw-label--spaced">Auffällige Klauen — tippe auf eine Position</span>

        <ClawSelector Planned="Planned" Mode="ClawSelectorMode.Flags"
                      OnChanged="StateHasChanged" />
    </ChildContent>
    <Footer>
        <button type="button" class="mw-btn mw-btn--plain mw-btn--wide" @onclick="Cancel">
            Abbrechen
        </button>
        <button type="button" class="mw-btn mw-btn--primary mw-btn--wide" @onclick="Save">
            Planen
        </button>
    </Footer>
</MeadowDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    private PlannedClawTreatment Planned = new();
    private DateTime? NullDate = DateTime.Today;
    private int CollarNumber;

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        if (NullDate is null)
        {
            Snackbar.Add("Bitte ein Datum wählen.", Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(Planned.Desciption))
        {
            Snackbar.Add("Bitte eine Beschreibung angeben.", Severity.Error);
            return;
        }

        var cowId = cowService.GetCowIdByCollarNumber(CollarNumber);
        if (string.IsNullOrEmpty(cowId))
        {
            Snackbar.Add($"Halsbandnummer {CollarNumber} nicht gefunden!", Severity.Error);
            return;
        }

        Planned.TreatmentDate = NullDate.Value;
        Planned.EarTagNumber = cowId;

        if (await pClawTreatmentService.InsertDataAsync(Planned))
        {
            Snackbar.Add("Behandlung geplant.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add("Speichern fehlgeschlagen!", Severity.Error);
        }
    }
}
