@using _4Cows_FE.Components.Meadow
@using BB_Cow.Profile
@*
    Die vier Klauen als Pegel: jede fuellt sich von unten, so weit sie am
    Hoechstwert dieser Kuh liegt.

    Beantwortet die Frage, die eine Liste nicht beantwortet: ist immer
    dieselbe Klaue betroffen?

    Frueher war das eine Farbrampe aus vier Blautoenen. Die war nebeneinander
    nicht ablesbar - zwei benachbarte Stufen sehen gleich aus, und bei drei
    behandelten Klauen steht man vor drei blauen Umrissen. Ein Fuellstand ist
    eine LAENGE, und Laengen vergleicht das Auge ohne Nachdenken. Die Farbe
    sagt jetzt nur noch "behandelt oder nicht" und traegt damit keine
    Abstufung mehr, die jemand ohne Farbwahrnehmung verpassen koennte.

    Der Pegel bleibt der ZWEITE Kanal - jede Zelle nennt ihre Zahl.

    Bezugsgroesse ist der Hoechstwert DIESER Kuh. Eine absolute Skala
    zeichnete ein Tier, dessen schlimmste Klaue zweimal dran war, als vier
    kaum gefuellte Umrisse - und die Frage auf einer Detailseite lautet nie
    "wie steht sie zur Herde", sondern immer "welche ihrer vier Klauen ist das
    Problem".

    Die Bezugsgroesse steht bewusst NICHT mehr unter dem Raster. Sie war eine
    Zeile Kleingedrucktes fuer eine Zahl, die daneben in jeder Zelle steht:
    die voll gefuellte Klaue IST der Hoechstwert, und ihre Zahl liest man
    direkt ab.
*@
@if (TotalTreatments == 0)
{
    @* Vier leere Umrisse unter einer Skala "Hoechstwert 0" beschreiben einen
       Pegel ohne Daten - das liest sich als kaputtes Widget, nicht als
       leeres. *@
    <div class="mw-empty">Für diese Kuh sind keine Klauenbehandlungen erfasst.</div>
}
else
{
    <div class="mw-claw-grid" role="group" aria-label="Klauen nach Behandlungshäufigkeit">
        @foreach (var hoof in Hoofs)
        {
            <div class="mw-show-cell">
                <div class="mw-show-cell__row">
                    @* Zwei deckungsgleiche Umrisse: der untere leer, der obere
                       gefuellt und oben weggeschnitten. Beide tragen kein
                       Title und sind damit aria-hidden - die Zahl daneben sagt
                       dasselbe in Worten.

                       Der Pegel steht im style und nicht in einer Klasse: er
                       ist ein Messwert mit hundert moeglichen Stufen, keine
                       Kategorie. *@
                    <span class="mw-hoof-thumb mw-hoof-level"
                          style="@($"--mw-hoof-level: {Level(hoof.TreatmentCount)}%")">
                        <Hoof />
                        <span class="mw-hoof-level__fill"><Hoof /></span>
                    </span>

                    <div class="mw-show-cell__body">
                        @* Bezeichnung und Zahl auf EINER Grundlinie. Unter-
                           einander kostete jede Zelle rund 20px mehr, und
                           vier davon sind auf einer hoehenbegrenzten Seite
                           ein Drittel der Karte. *@
                        <div class="mw-claw-cell__head">
                            <span class="mw-show-cell__title">@HoofPositions.Label(hoof.Position)</span>
                            <span class="mw-claw-cell__count">
                                @hoof.TreatmentCount.ToString("N0")
                                <span class="mw-sr-only">
                                    @(hoof.TreatmentCount == 1 ? "Behandlung" : "Behandlungen")
                                </span>
                            </span>
                        </div>
                        <div class="mw-show-cell__finding">@FindingText(hoof)</div>

                        <div class="mw-show-cell__tags">
                            @if (hoof.OpenBandageCount > 0)
                            {
                                <span class="mw-tag mw-tag--bandage">
                                    @hoof.OpenBandageCount @(hoof.OpenBandageCount == 1 ? "Verband" : "Verbände")
                                </span>
                            }
                            @* Der Klotz haengt NICHT an IsBandageRemoved - genau
                               diese Vermischung war der Fehler, den ClawSummary
                               behoben hat. *@
                            @if (hoof.BlockCount > 0)
                            {
                                <span class="mw-tag mw-tag--block">
                                    @hoof.BlockCount @(hoof.BlockCount == 1 ? "Klotz" : "Klötze")
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    /// <summary>Genau vier, in der Reihenfolge von HoofPositions.All.</summary>
    [Parameter] public IReadOnlyList<CowProfileHoof> Hoofs { get; set; } = Array.Empty<CowProfileHoof>();

    /// <summary>Anzahl der Klauenbehandlungen dieser Kuh - entscheidet ueber den Leerzustand.</summary>
    [Parameter] public int TotalTreatments { get; set; }

    /// <summary>
    /// Anzeigetext, wenn an einer Klaue nichts erfasst wurde. Pflegbar unter
    /// Einstellungen -> Standardwerte; gespeichert wird er nicht, und in die
    /// Auswertung geht er nicht ein - sonst hiesse der haeufigste Befund
    /// jeder Kuh "Pflege". Genau wie in ClawSummary.
    /// </summary>
    [Parameter] public string FallbackFinding { get; set; } = "";

    /// <summary>
    /// Untergrenze fuer eine Klaue, die ueberhaupt behandelt wurde. Bei
    /// "einmal von neun" waeren es sonst 11 Prozent, und im 34px hohen Umriss
    /// ist das ein Streifen von vier Pixeln - nicht von "nie behandelt" zu
    /// unterscheiden. Dieselbe Ueberlegung wie das min-width der
    /// Balkenlisten.
    /// </summary>
    private const int MinLevel = 18;

    private const int MaxSegments = 3;

    private int Max => Hoofs.Count == 0 ? 0 : Hoofs.Max(h => h.TreatmentCount);

    /// <summary>
    /// Fuellstand in Prozent der Umrisshoehe. Ganzzahlig, damit der Wert ohne
    /// Ruecksicht auf die Kultur in den style-Wert darf - "0,42%" waere ein
    /// ungueltiger CSS-Wert und der Pegel fiele still auf null zurueck.
    /// Dasselbe Thema wie MeadowBarList.Share, dort mit InvariantCulture
    /// geloest.
    /// </summary>
    private int Level(int count)
        => count == 0 || Max == 0
            ? 0
            : Math.Max(MinLevel, (int)Math.Round(100.0 * count / Max));

    /// <summary>
    /// Die Befunde dieser Klaue, haeufigster zuerst. Gekappt wie in
    /// ClawFindingSummary - drei Segmente plus Rest, sonst sprengt eine Kuh
    /// mit fuenf verschiedenen Befunden die Zelle.
    /// </summary>
    private string FindingText(CowProfileHoof hoof)
    {
        if (hoof.Findings.Count == 0)
        {
            return string.IsNullOrEmpty(FallbackFinding) ? "–" : FallbackFinding;
        }

        var text = string.Join(" · ", hoof.Findings.Take(MaxSegments).Select(f => f.Key));
        var overflow = hoof.Findings.Count - MaxSegments;
        return overflow > 0 ? $"{text} · +{overflow} weitere" : text;
    }
}
