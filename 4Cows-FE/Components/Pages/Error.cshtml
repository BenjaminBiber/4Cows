@page
@model BB_Cow.Pages.ErrorModel

<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fehler · Meadow</title>
    @* Eigenstaendiges Dokument (UseExceptionHandler("/Error")), also ohne
       App.razor. Verlinkt wurden hier bisher Bootstrap und ~/css/site.css -
       letzteres existiert im Projekt nicht. Jetzt nur die Meadow-Tokens. *@
    <link rel="stylesheet" href="~/css/meadow-tokens.css" />
    <link rel="stylesheet" href="~/css/meadow-base.css" />
    <style>
        body { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 20px; }
        .err { width: 460px; max-width: 100%; padding: 36px 32px; text-align: center;
               background: var(--mw-panel); border: 1px solid var(--mw-border);
               border-radius: var(--mw-r-5xl); box-shadow: var(--mw-shadow-card); }
        .err h1 { font-family: var(--mw-font-display); font-weight: 700; font-size: 26px; color: var(--mw-danger); }
        .err p { margin-top: 8px; font-size: 13px; line-height: 1.5; color: var(--mw-muted); }
        .err code { font-family: var(--mw-font-mono); font-size: 12px; }
        .err a { display: inline-block; margin-top: 18px; padding: 10px 22px;
                 border-radius: var(--mw-r-lg); background: var(--mw-primary); color: #fff;
                 font-weight: 600; font-size: 14px; }
    </style>
</head>

<body>
    <div class="err">
        <h1>Ein Fehler ist aufgetreten</h1>
        <p>Beim Verarbeiten der Anfrage ist etwas schiefgegangen.</p>

        @if (Model.ShowRequestId)
        {
            <p>Anfrage-ID: <code>@Model.RequestId</code></p>
        }

        <a href="/">Zum Dashboard</a>
    </div>
</body>

</html>
