@page "/Kuh_Daten"

@using _4Cows_FE.Components._4CowsComponent.Dialogs
@using _4Cows_FE.Components.Meadow
@using _4Cows_FE.Components.Services

@inject MeadowDataLoader Data
@inject MeadowDialogLauncher Launcher
@inject CowTreatmentService cowTreatmentService
@inject CowService cowService
@inject MedicineService medicineService
@inject WhereHowService WhereHowService
@inject UdderService UdderService

<MeadowToolbar>
    <Left>
        <MeadowSearchBox Value="@_filter.Search" ValueChanged="OnSearchChanged"
                         AriaLabel="Kuh Behandlungen durchsuchen" />
        @if (_filter.HasAny)
        {
            <span class="mw-result-count mw-only-desktop">@CountText</span>
        }
    </Left>
    <Right>
        <MeadowFilterPopover Open="_filterOpen" ShowReset="@(_filter.ActiveCount > 0)"
                             CountText="@($"{CountText} Behandlungen")"
                             OnClose="CloseFilter" OnReset="ResetFilter">
            <Trigger>
                <MeadowFilterButton ActiveCount="_filter.ActiveCount" Open="_filterOpen"
                                    OnClick="ToggleFilter" />
            </Trigger>
            <ChildContent>
                <MeadowMultiSelect Label="Medikament" Options="MedicineOptions"
                                   Selected="_filter.Medicines"
                                   SelectionChanged="Apply" />
                <MeadowSingleSelect Label="Zeitraum" Options="DateRanges.Labels"
                                    Value="@DateRanges.ToLabel(_filter.Range)"
                                    ValueChanged="OnRangeChanged" />
            </ChildContent>
        </MeadowFilterPopover>

        <button type="button" class="mw-btn mw-btn--primary mw-only-desktop" @onclick="AddTreatment">
            <MeadowIcon Name="MeadowIconName.Plus" Size="20" />
            <span>Neue Behandlung</span>
        </button>
    </Right>
</MeadowToolbar>

<MeadowTable TItem="CowTreatment" Items="_rows" Columns="_columns"
             RowKey="@(r => r.CowTreatmentId)"
             DefaultSortTitle="Datum" DefaultSortDescending="true"
             PagerLabel="Behandlungen pro Seite"
             EmptyText="Keine Behandlungen gefunden.">
    <EmptyContent>
        @if (_filter.HasAny)
        {
            <button type="button" class="mw-empty__reset" @onclick="ClearAll">
                Suche und Filter zurücksetzen
            </button>
        }
    </EmptyContent>
    <MobileCard Context="row">
        @{ var place = SplitWhereHow(WhereHow(row)); }
        <div class="mw-row-card">
            <div class="mw-row-card__top">
                <span class="mw-row-card__title">Nr. @Collar(row)</span>
                <span class="mw-row-card__date">
                    <MeadowIcon Name="MeadowIconName.Calendar" Size="13" />
                    @row.AdministrationDate.ToString("dd.MM.yyyy")
                </span>
            </div>
            <span class="mw-row-card__code">@EarTag(row)</span>
            <div class="mw-row-card__fields">
                <div class="mw-row-card__field">
                    <span class="mw-row-card__label">Medikament</span>
                    <span class="mw-row-card__value">
                        <span class="mw-pill">@Medicine(row)</span>
                    </span>
                </div>
                <div class="mw-row-card__field">
                    <span class="mw-row-card__label">Stelle</span>
                    <span class="mw-row-card__value">
                        @place.Place@if (place.Detail is not null)
                        {
                            <span class="mw-row-card__sep">&#183;</span>@place.Detail
                        }
                    </span>
                </div>
                <div class="mw-row-card__field">
                    <span class="mw-row-card__label">Menge</span>
                    <span class="mw-row-card__value">
                        @Dosage(row)<span class="mw-row-card__unit">@DosageUnit</span>
                    </span>
                </div>
            </div>
        </div>
    </MobileCard>
</MeadowTable>

@code {
    private readonly CowTableFilter _filter = new();
    private bool _filterOpen;

    private List<CowTreatment> _all = new();
    private List<CowTreatment> _rows = new();
    private List<MeadowColumn<CowTreatment>> _columns = new();

    protected override async Task OnInitializedAsync()
    {
        // Vorher fehlten hier Medicine, WhereHow und Cow. Folge: beim
        // Direktaufruf blieben Halsband und Medikament leer - und weil
        // FilterFuncCow bei unbekannter Cow_ID false liefert, filterte die
        // Suche zusaetzlich ALLE Zeilen weg.
        await Data.EnsureCowTreatmentsAsync();
        _all = cowTreatmentService.Treatments.Values.ToList();
        BuildColumns();
        Apply();
    }

    // ---- Spalten ------------------------------------------------------

    private void BuildColumns() => _columns = new()
    {
        new MeadowColumn<CowTreatment>
        {
            Title = "Halsband",
            Text = Collar,
            SortBy = r => CollarSortKey(r),
            Style = MeadowCellStyle.Bold
        },
        new MeadowColumn<CowTreatment>
        {
            Title = "Ohrmarke",
            Text = EarTag,
            SortBy = EarTag,
            Style = MeadowCellStyle.Mono
        },
        new MeadowColumn<CowTreatment>
        {
            Title = "Datum",
            Text = r => r.AdministrationDate.ToString("dd.MM.yyyy"),
            SortBy = r => r.AdministrationDate,
            NoWrap = true
        },
        new MeadowColumn<CowTreatment>
        {
            Title = "Medikament",
            Text = Medicine,
            // Sortiert nach dem Namen. Vorher stand hier x.MedicineId, also
            // nach einer ID, die niemand sieht.
            SortBy = Medicine,
            Template = row => @<span class="mw-pill">@Medicine(row)</span>
        },
        new MeadowColumn<CowTreatment>
        {
            Title = "Wie / Wo",
            Text = WhereHow,
            SortBy = WhereHow
        },
        new MeadowColumn<CowTreatment>
        {
            Title = "Menge",
            Text = Dosage,
            SortBy = r => r.MedicineDosage,
            NoWrap = true
        }
    };

    // ---- Anzeige-Helfer -----------------------------------------------

    private string Collar(CowTreatment r)
    {
        var collar = cowService.GetCollarNumberByCowId(r.EarTagNumber);
        return collar == int.MinValue ? "–" : collar.ToString();
    }

    // Unbekannt ist int.MinValue und wuerde sonst VOR allen echten
    // Halsbandnummern sortieren.
    private int CollarSortKey(CowTreatment r)
    {
        var collar = cowService.GetCollarNumberByCowId(r.EarTagNumber);
        return collar == int.MinValue ? int.MaxValue : collar;
    }

    private string EarTag(CowTreatment r) => cowService.GetEarTagDisplay(r.EarTagNumber);

    private string Medicine(CowTreatment r) => medicineService.GetMedicineNameById(r.MedicineId);

    private string WhereHow(CowTreatment r)
        => WhereHowService.GetFullWhereHowName(r.WhereHowId, UdderService, r.UdderId);

    private string Dosage(CowTreatment r) => r.MedicineDosage.ToString("0.##");

    // Der Entwurf zeigt die Menge mit Einheit. In der Datenbank steht nur
    // die Zahl (Cow_Treatment.Medicine_Dosage, float) - ein Einheitenfeld
    // gibt es weder am Medikament noch an der Behandlung. Bis es eines
    // gibt, ist das hier die einzige Stelle, die sich aendern muss.
    private const string DosageUnit = "ml";

    // GetFullWhereHowName liefert "Euter (LV/ RH)". Auf der Kachel steht
    // die Stelle als "Euter . LV/RH": dieselbe Angabe, aber ohne Klammern,
    // die in einer 100px breiten Spalte nur Platz kosten. Die Desktop-
    // Spalte "Wie / Wo" bleibt unveraendert.
    private static (string Place, string? Detail) SplitWhereHow(string value)
    {
        var open = value.LastIndexOf('(');
        if (open <= 0 || !value.EndsWith(')'))
        {
            return (value.Trim(), null);
        }

        var detail = value[(open + 1)..^1].Replace("/ ", "/").Trim();
        return (value[..open].TrimEnd(), detail.Length == 0 ? null : detail);
    }

    // ---- Filter -------------------------------------------------------

    /// <summary>
    /// Nur die tatsaechlich vorkommenden Medikamente - nicht die fuenf
    /// hartcodierten des Prototyps und auch nicht GetMedicineNames(), das
    /// nie benutzte und automatisch angelegte Namen enthaelt und nicht
    /// einmal Distinct() macht.
    /// </summary>
    private IReadOnlyList<string> MedicineOptions => _all
        .Select(r => medicineService.GetMedicineNameById(r.MedicineId))
        .Where(n => !string.IsNullOrEmpty(n) && n != "--")
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(n => n, StringComparer.CurrentCulture)
        .ToList();

    private string CountText => $"{_rows.Count} von {_all.Count}";

    private void Apply()
    {
        IEnumerable<CowTreatment> query = _all;

        var search = _filter.Search.Trim();
        if (search.Length > 0)
        {
            query = query.Where(r =>
                Contains(Collar(r), search)
                || Contains(EarTag(r), search)
                || Contains(Medicine(r), search));
        }

        // Leere Auswahl = kein Filter. Sonst ODER ueber die gewaehlten
        // Medikamente; das HashSet vergleicht OrdinalIgnoreCase.
        if (_filter.Medicines.Count > 0)
        {
            query = query.Where(r => _filter.Medicines.Contains(Medicine(r)));
        }

        query = query.Where(r => DateRanges.Matches(_filter.Range, r.AdministrationDate));

        _rows = query.ToList();
    }

    private static bool Contains(string haystack, string needle)
        => haystack.Contains(needle, StringComparison.OrdinalIgnoreCase);

    private void OnSearchChanged(string value)
    {
        _filter.Search = value;
        Apply();
    }

    private void OnRangeChanged(string label)
    {
        _filter.Range = DateRanges.Parse(label);
        Apply();
    }

    private void ToggleFilter() => _filterOpen = !_filterOpen;

    private void CloseFilter() => _filterOpen = false;

    private void ResetFilter()
    {
        _filter.Reset();
        Apply();
    }

    private void ClearAll()
    {
        _filter.Search = "";
        _filter.Reset();
        Apply();
    }

    // ---- Aktionen -----------------------------------------------------

    private async Task AddTreatment()
    {
        if (await Launcher.ShowAndAwaitAsync<Add_Cow_Treatment_Dialog>())
        {
            await ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        await cowTreatmentService.GetAllDataAsync();
        _all = cowTreatmentService.Treatments.Values.ToList();
        Apply();
    }
}
