@page "/Verband_Daten"

@using _4Cows_FE.Components._4CowsComponent.Dialogs
@using _4Cows_FE.Components.Meadow
@using _4Cows_FE.Components.Services

@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject MeadowDataLoader Data
@inject MeadowDialogLauncher Launcher
@inject ClawTreatmentService clawTreatmentService
@inject CowService cowService

<MeadowToolbar>
    <Left>
        <MeadowSearchBox Value="@_search" ValueChanged="OnSearchChanged"
                         AriaLabel="Verbände durchsuchen" />
        <MeadowChip Label="@OverdueLabel" Selected="_onlyOverdue" OnClick="ToggleOverdue" />
    </Left>
    <Right>
        <button type="button" class="mw-btn mw-btn--primary mw-only-desktop" @onclick="AddTreatment">
            <MeadowIcon Name="MeadowIconName.Plus" Size="20" />
            <span>Neue Behandlung</span>
        </button>
    </Right>
</MeadowToolbar>

<MeadowTable TItem="BandagedClaw" Items="_rows" Columns="_columns"
             RowKey="@(r => r.Key)"
             DefaultSortTitle="Tage" DefaultSortDescending="true"
             PagerLabel="Verbände pro Seite"
             MoreLabel="Weitere Verbände laden"
             EmptyText="Keine offenen Verbände gefunden.">
    <MobileCard Context="row">
        <div class="mw-row-card">
            <div class="mw-row-card__top">
                <span class="mw-row-card__title">Nr. @Collar(row)</span>
                <MeadowDayChip Days="row.Days" />
            </div>
            <div class="mw-row-card__meta">
                <span>@row.HoofText</span>
                <span>seit @row.Since.ToString("dd.MM.yyyy")</span>
            </div>
            <div class="mw-row-card__actions">
                <button type="button" class="mw-btn mw-btn--ghost mw-btn--sm"
                        @onclick="() => OpenTreatment(row)">Öffnen</button>
                <button type="button" class="mw-btn mw-btn--primary mw-btn--sm"
                        @onclick="() => RemoveBandage(row)">Entfernen</button>
            </div>
        </div>
    </MobileCard>
</MeadowTable>

@code {
    // Eine Zeile pro bandagierter Klaue. Die Datenbank kennt nur ein
    // gemeinsames IsBandageRemoved pro Behandlung - das ist der Grund,
    // warum das Entfernen die Geschwister-Klauen benennen muss.
    private List<BandagedClaw> _all = new();
    private List<BandagedClaw> _rows = new();
    private List<MeadowColumn<BandagedClaw>> _columns = new();

    private string _search = "";
    private bool _onlyOverdue;

    private string OverdueLabel => "Nur überfällig";

    protected override async Task OnInitializedAsync()
    {
        // OnInitialized war synchron und lud gar nichts - beim Direktaufruf
        // dieser Route war die Seite deshalb immer leer.
        await Data.EnsureClawTreatmentsAsync();
        Rebuild();
        BuildColumns();
    }

    private void Rebuild()
    {
        _all = BandagedClaw.Project(clawTreatmentService.GetClawTreatmentsWithBandage()).ToList();
        Apply();
    }

    private void BuildColumns() => _columns = new()
    {
        new MeadowColumn<BandagedClaw>
        {
            Title = "Halsband",
            Text = Collar,
            SortBy = r => CollarSortKey(r),
            Style = MeadowCellStyle.Bold
        },
        new MeadowColumn<BandagedClaw>
        {
            Title = "Klaue",
            Text = r => r.HoofText,
            SortBy = r => r.Position.ToString()
        },
        new MeadowColumn<BandagedClaw>
        {
            Title = "Angelegt",
            Text = r => r.Since.ToString("dd.MM.yyyy"),
            SortBy = r => r.Since,
            NoWrap = true
        },
        new MeadowColumn<BandagedClaw>
        {
            Title = "Tage",
            Text = r => $"{r.Days} Tage",
            SortBy = r => r.Days,
            Template = row => @<MeadowDayChip Days="row.Days" />
        },
        new MeadowColumn<BandagedClaw>
        {
            IsActions = true,
            Template = row =>
                @<text>
                    <button type="button" class="mw-btn mw-btn--sm mw-btn--ghost"
                            @onclick="() => OpenTreatment(row)">Behandlung öffnen</button>
                    <button type="button" class="mw-btn mw-btn--sm mw-btn--primary"
                            @onclick="() => RemoveBandage(row)">Entfernen</button>
                </text>
        }
    };

    // ---- Anzeige-Helfer -----------------------------------------------

    private string Collar(BandagedClaw r)
    {
        var collar = cowService.GetCollarNumberByCowId(r.CowId);
        return collar == int.MinValue ? "–" : collar.ToString();
    }

    private int CollarSortKey(BandagedClaw r)
    {
        var collar = cowService.GetCollarNumberByCowId(r.CowId);
        return collar == int.MinValue ? int.MaxValue : collar;
    }

    // ---- Filter -------------------------------------------------------

    private void Apply()
    {
        IEnumerable<BandagedClaw> query = _all;

        var search = _search.Trim();
        if (search.Length > 0)
        {
            query = query.Where(r =>
                Collar(r).Contains(search, StringComparison.OrdinalIgnoreCase)
                || cowService.GetEarTagDisplay(r.CowId)
                    .Contains(search, StringComparison.OrdinalIgnoreCase)
                || r.Position.ToString().Contains(search, StringComparison.OrdinalIgnoreCase)
                || HoofPositions.SideLabel(r.Position)
                    .Contains(search, StringComparison.OrdinalIgnoreCase)
                || r.Finding.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        if (_onlyOverdue)
        {
            query = query.Where(r => r.IsOverdue);
        }

        _rows = query.ToList();
    }

    private void OnSearchChanged(string value)
    {
        _search = value;
        Apply();
    }

    private void ToggleOverdue()
    {
        _onlyOverdue = !_onlyOverdue;
        Apply();
    }

    // ---- Aktionen -----------------------------------------------------

    private async Task OpenTreatment(BandagedClaw row)
    {
        var treatment = clawTreatmentService.Treatments.Values
            .FirstOrDefault(t => t.ClawTreatmentId == row.TreatmentId);
        if (treatment is null)
        {
            return;
        }

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };
        var parameters = new DialogParameters<Show_Claw_Treatment_Dialog>
        {
            { x => x.Claw_Treatment, treatment }
        };

        var dialog = await DialogService.ShowAsync<Show_Claw_Treatment_Dialog>(
            string.Empty, parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not ClawTreatment edit)
        {
            return;
        }

        await EditTreatment(edit);
    }

    private async Task EditTreatment(ClawTreatment treatment)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };
        var parameters = new DialogParameters<Add_Claw_Treatment_Dialog>
        {
            { x => x.Claw_Treatment, treatment }
        };

        var dialog = await DialogService.ShowAsync<Add_Claw_Treatment_Dialog>(
            string.Empty, parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        // Der Verband kann jetzt woanders sitzen - Projektion neu bauen.
        await clawTreatmentService.GetAllDataAsync();
        Rebuild();
    }

    private async Task RemoveBandage(BandagedClaw row)
    {
        // RemoveBandageAsync legt das eine IsBandageRemoved der ganzen
        // Behandlung um. Bei mehreren bandagierten Klauen verschwinden
        // deshalb alle - das muss vorher dastehen. Bisher gab es hier
        // ueberhaupt keine Bestaetigung.
        var siblings = _all.Where(r => r.TreatmentId == row.TreatmentId).ToList();
        var collar = Collar(row);

        var description = siblings.Count == 1
            ? $"Verband {row.HoofText} bei Halsband {collar} als entfernt markieren?"
            : $"Bei Halsband {collar} sind {siblings.Count} Verbände erfasst "
              + $"({string.Join(", ", siblings.Select(s => s.Position))}). "
              + "Diese Behandlung speichert nur ein gemeinsames Kennzeichen — beim "
              + $"Entfernen werden ALLE {siblings.Count} Verbände als entfernt markiert. Fortfahren?";

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, NoHeader = true };
        var parameters = new DialogParameters<GenericDialog>
        {
            { x => x.HeaderText, "Verband entfernen" },
            { x => x.Description, description },
            { x => x.AcceptButtonText, "Entfernen" },
            { x => x.CancelButtonText, "Abbrechen" },
            { x => x.ColorScheme, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<GenericDialog>(string.Empty, parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        if (await clawTreatmentService.RemoveBandageAsync(row.TreatmentId))
        {
            Snackbar.Add(
                siblings.Count == 1
                    ? "Verband als entfernt markiert."
                    : $"{siblings.Count} Verbände als entfernt markiert.",
                Severity.Success);

            // Ohne das blieb die Zeile bis zum Reload stehen.
            Rebuild();
        }
        else
        {
            Snackbar.Add("Entfernen des Verbands fehlgeschlagen.", Severity.Error);
        }
    }

    private async Task AddTreatment()
    {
        if (await Launcher.ShowAndAwaitAsync<Add_Claw_Treatment_Dialog>())
        {
            await clawTreatmentService.GetAllDataAsync();
            Rebuild();
        }
    }
}
