@page "/geplante_Klauen_Daten"
@implements IDisposable

@using _4Cows_FE.Components._4CowsComponent.Dialogs
@using _4Cows_FE.Components.Meadow
@using _4Cows_FE.Components.Services
@using BB_Cow.Class
@using BB_Cow.Kpi

@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject MeadowDataLoader Data
@inject MeadowDialogLauncher Launcher
@inject MeadowDataChanges Changes
@inject PClawTreatmentService pClawTreatmentService
@inject ClawTreatmentService clawTreatmentService
@inject CowService cowService

@* Dieselbe Filterleiste wie die anderen Tabellen - bisher gab es hier nur ein
   Suchfeld. Gefiltert wird nach Klauenposition, weil Planned_Claw_Treatment
   die Befunde als vier Booleans speichert und nicht als Namen: die Position
   ist alles, was diese Tabelle ueber einen Befund weiss.

   Der Zeitraum zeigt in die ZUKUNFT, siehe PlannedDateRanges. *@
<MeadowToolbar>
    <Left>
        <MeadowSearchBox Value="@_filter.Search" ValueChanged="OnSearchChanged"
                         AriaLabel="Geplante Klauen Behandlungen durchsuchen" />
        @if (_filter.HasAny)
        {
            <span class="mw-result-count mw-only-desktop">@CountText</span>
        }
    </Left>
    <Right>
        <MeadowFilterPopover Open="_filterOpen" ShowReset="@(_filter.ActiveCount > 0)"
                             CountText="@($"{CountText} Behandlungen")"
                             OnClose="CloseFilter" OnReset="ResetFilter">
            <Trigger>
                <MeadowFilterButton ActiveCount="_filter.ActiveCount" Open="_filterOpen"
                                    OnClick="ToggleFilter" />
            </Trigger>
            <ChildContent>
                <MeadowMultiSelect Label="Klaue" Options="PositionOptions"
                                   Selected="_filter.Positions"
                                   SelectionChanged="Apply" />
                <MeadowSingleSelect Label="Zeitraum" Options="PlannedDateRanges.Labels"
                                    Value="@PlannedDateRanges.ToLabel(_filter.Range)"
                                    ValueChanged="OnRangeChanged" />
            </ChildContent>
        </MeadowFilterPopover>

        <button type="button" class="mw-btn mw-btn--primary mw-only-desktop" @onclick="Plan">
            <MeadowIcon Name="MeadowIconName.Plus" Size="20" />
            <span>Planen</span>
        </button>
    </Right>
</MeadowToolbar>

<MeadowTable TItem="PlannedClawTreatment" Items="_rows" Columns="_columns"
             RowKey="@(r => r.PlannedClawTreatmentId)"
             DefaultSortTitle="Geplant für"
             PagerLabel="Behandlungen pro Seite"
             MoreLabel="Weitere Behandlungen laden"
             EmptyText="Keine geplanten Behandlungen gefunden.">
    <EmptyContent>
        @if (_filter.HasAny)
        {
            <button type="button" class="mw-empty__reset" @onclick="ClearAll">
                Suche und Filter zurücksetzen
            </button>
        }
    </EmptyContent>
    <MobileCard Context="row">
        <div class="mw-row-card">
            <div class="mw-row-card__top">
                <span class="mw-row-card__title">Nr. @Collar(row)</span>
                <span class="mw-row-card__sub">@row.TreatmentDate.ToString("dd.MM.yyyy")</span>
            </div>
            <span class="mw-row-card__code">@EarTag(row)</span>
            <div class="mw-row-card__meta">
                <span>@Description(row)</span>
                <span>@AffectedClaws(row)</span>
            </div>
            <div class="mw-row-card__actions">
                <button type="button" class="mw-btn mw-btn--sm mw-btn--ghost"
                        @onclick="() => OpenTreatment(row)">Öffnen</button>
                <button type="button" class="mw-btn mw-btn--sm mw-btn--primary"
                        @onclick="() => Complete(row)">Abschließen</button>
                @* Die Desktop-Zeile hat drei Aktionen; ohne diese waere das
                   Entfernen mobil nicht erreichbar. *@
                <MeadowIconButton Icon="MeadowIconName.Trash" Title="Planung entfernen"
                                  Danger="true" OnClick="() => Remove(row)" />
            </div>
        </div>
    </MobileCard>
</MeadowTable>

@code {
    private List<PlannedClawTreatment> _all = new();
    private List<PlannedClawTreatment> _rows = new();
    private List<MeadowColumn<PlannedClawTreatment>> _columns = new();

    private readonly PlannedClawTableFilter _filter = new();
    private bool _filterOpen;

    protected override async Task OnInitializedAsync()
    {
        await Data.EnsurePlannedClawAsync();
        // Eine KPI-Kachel verlinkt mit ihren Filtern im Query-String hierher.
        KpiDrillDown.ApplyTo(_filter, Nav);
        Reload();
        BuildColumns();

        Changes.Changed += OnDataChanged;
    }

    public void Dispose() => Changes.Changed -= OnDataChanged;

    private void OnDataChanged(MeadowDataKind kind)
    {
        if (kind != MeadowDataKind.PlannedClawTreatment)
        {
            return;
        }

        // Die Meldung kommt aus dem Dialog-Aufrufer, nicht aus dem
        // Renderpfad dieser Seite - deshalb InvokeAsync.
        _ = InvokeAsync(async () =>
        {
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private async Task ReloadAsync()
    {
        await pClawTreatmentService.GetAllDataAsync();
        Reload();
    }

    private void Reload()
    {
        _all = pClawTreatmentService.Treatments.Values.ToList();
        Apply();
    }

    private void BuildColumns() => _columns = new()
    {
        new MeadowColumn<PlannedClawTreatment>
        {
            Title = "Halsband",
            Text = Collar,
            SortBy = r => CollarSortKey(r),
            Style = MeadowCellStyle.Bold
        },
        new MeadowColumn<PlannedClawTreatment>
        {
            Title = "Ohrmarke",
            Text = EarTag,
            SortBy = EarTag,
            Style = MeadowCellStyle.Mono
        },
        new MeadowColumn<PlannedClawTreatment>
        {
            // Diese Spalte fehlte der Seite komplett, obwohl das Datum in der
            // Datenbank steht (Treatment_Date).
            Title = "Geplant für",
            Text = r => r.TreatmentDate.ToString("dd.MM.yyyy"),
            SortBy = r => r.TreatmentDate,
            NoWrap = true
        },
        new MeadowColumn<PlannedClawTreatment>
        {
            Title = "Klauen",
            Text = AffectedClaws,
            SortBy = AffectedClaws,
            NoWrap = true
        },
        new MeadowColumn<PlannedClawTreatment>
        {
            Title = "Beschreibung",
            Text = Description,
            SortBy = Description
        },
        new MeadowColumn<PlannedClawTreatment>
        {
            IsActions = true,
            Template = row =>
                @<text>
                    <button type="button" class="mw-btn mw-btn--sm mw-btn--ghost"
                            @onclick="() => OpenTreatment(row)">Öffnen</button>
                    <button type="button" class="mw-btn mw-btn--sm mw-btn--primary"
                            @onclick="() => Complete(row)">Abschließen</button>
                    <MeadowIconButton Icon="MeadowIconName.Trash" Title="Behandlung entfernen"
                                      Danger="true" OnClick="() => Remove(row)" />
                </text>
        }
    };

    // ---- Anzeige-Helfer -----------------------------------------------

    private string Collar(PlannedClawTreatment r)
    {
        var collar = cowService.GetCollarNumberByCowId(r.EarTagNumber);
        return collar == int.MinValue ? "–" : collar.ToString();
    }

    private int CollarSortKey(PlannedClawTreatment r)
    {
        var collar = cowService.GetCollarNumberByCowId(r.EarTagNumber);
        return collar == int.MinValue ? int.MaxValue : collar;
    }

    private string EarTag(PlannedClawTreatment r) => cowService.GetEarTagDisplay(r.EarTagNumber);

    private string Description(PlannedClawTreatment r)
        => string.IsNullOrWhiteSpace(r.Desciption) ? "–" : r.Desciption!;

    /// <summary>Die als auffaellig markierten Klauen, z.B. "LV/RH".</summary>
    private string AffectedClaws(PlannedClawTreatment r)
    {
        var claws = HoofPositions.All.Where(r.GetFlag).ToList();
        return claws.Count == 0 ? "–" : string.Join("/", claws);
    }

    private string CountText => $"{_rows.Count} von {_all.Count}";

    // ---- Filter -------------------------------------------------------

    /// <summary>
    /// Nur die tatsaechlich vorkommenden Positionen, in der Zeichenreihenfolge
    /// des 2x2-Gitters (HoofPositions.All) statt alphabetisch - so stehen sie
    /// auch im Klauen-Selektor der Dialoge.
    /// </summary>
    private IReadOnlyList<string> PositionOptions => HoofPositions.All
        .Where(p => _all.Any(r => r.GetFlag(p)))
        .Select(p => p.ToString())
        .ToList();

    private void Apply()
    {
        IEnumerable<PlannedClawTreatment> query = _all;

        var search = _filter.Search.Trim();
        if (search.Length > 0)
        {
            query = query.Where(r =>
                Collar(r).Contains(search, StringComparison.OrdinalIgnoreCase)
                || cowService.GetEarTagDisplay(r.EarTagNumber)
                    .Contains(search, StringComparison.OrdinalIgnoreCase)
                || (r.Desciption ?? "").Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        // Leere Auswahl = kein Filter. ODER innerhalb der Gruppe: eine Zeile
        // passt, sobald EINE der gewaehlten Klauen angehakt ist.
        if (_filter.Positions.Count > 0)
        {
            query = query.Where(r =>
                HoofPositions.All.Any(p => r.GetFlag(p) && _filter.Positions.Contains(p.ToString())));
        }

        query = query.Where(r => PlannedDateRanges.Matches(_filter.Range, r.TreatmentDate));

        _rows = query.ToList();
    }

    private void OnRangeChanged(string label)
    {
        _filter.Range = PlannedDateRanges.Parse(label);
        Apply();
    }

    private void ToggleFilter() => _filterOpen = !_filterOpen;

    private void CloseFilter() => _filterOpen = false;

    private void ResetFilter()
    {
        _filter.Reset();
        Apply();
    }

    /// <summary>Aus dem Leerzustand heraus: hier gehoert der Suchtext mit weg.</summary>
    private void ClearAll()
    {
        _filter.Reset();
        _filter.Search = "";
        Apply();
    }

    private void OnSearchChanged(string value)
    {
        _filter.Search = value;
        Apply();
    }

    // ---- Aktionen -----------------------------------------------------

    private async Task OpenTreatment(PlannedClawTreatment planned)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };
        var parameters = new DialogParameters<Show_Planned_Treatment_Claw_Dialog>
        {
            { x => x.Planned_Claw_Treatment, planned }
        };

        await DialogService.ShowAsync<Show_Planned_Treatment_Claw_Dialog>(
            string.Empty, parameters, options);
    }

    // Derselbe Weg wie FAB, Add-Menue und Dashboard: der Launcher meldet das
    // Speichern, OnDataChanged laedt nach.
    private Task Plan() => Launcher.OpenPlannedClawTreatmentAsync();

    private async Task Complete(PlannedClawTreatment planned)
    {
        if (!await Confirm("Speichern", "Wollen Sie die Behandlung wirklich speichern?",
                "Ja", Color.Success))
        {
            return;
        }

        var treatment = new ClawTreatment
        {
            EarTagNumber = planned.EarTagNumber,
            TreatmentDate = DateTime.Now
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };
        var parameters = new DialogParameters<Add_Claw_Treatment_Dialog>
        {
            { x => x.Claw_Treatment, treatment }
        };

        // Der Aufruf war bisher nicht awaitet, und die Planung wurde direkt
        // danach geloescht - egal ob gespeichert oder abgebrochen.
        var dialog = await DialogService.ShowAsync<Add_Claw_Treatment_Dialog>(
            string.Empty, parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            Snackbar.Add("Abgebrochen — die Planung bleibt bestehen.", Severity.Warning);
            return;
        }

        await pClawTreatmentService.RemoveByIDAsync(planned.PlannedClawTreatmentId);
        await clawTreatmentService.GetAllDataAsync();
        Snackbar.Add("Behandlung abgeschlossen.", Severity.Success);
        Reload();
    }

    private async Task Remove(PlannedClawTreatment planned)
    {
        if (!await Confirm("Löschen", "Wollen Sie die geplante Behandlung wirklich löschen?",
                "Löschen", Color.Error))
        {
            return;
        }

        await pClawTreatmentService.RemoveByIDAsync(planned.PlannedClawTreatmentId);
        Snackbar.Add("Geplante Behandlung gelöscht.", Severity.Success);
        Reload();
    }

    private async Task<bool> Confirm(string header, string description, string accept, Color scheme)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, NoHeader = true };
        var parameters = new DialogParameters<GenericDialog>
        {
            { x => x.HeaderText, header },
            { x => x.Description, description },
            { x => x.AcceptButtonText, accept },
            { x => x.CancelButtonText, "Abbrechen" },
            { x => x.ColorScheme, scheme }
        };

        var dialog = await DialogService.ShowAsync<GenericDialog>(string.Empty, parameters, options);
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }
}
