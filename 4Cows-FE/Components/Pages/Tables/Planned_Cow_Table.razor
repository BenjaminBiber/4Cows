@page "/geplante_Kuh_Daten"

@using _4Cows_FE.Components._4CowsComponent.Dialogs
@using _4Cows_FE.Components.Meadow
@using _4Cows_FE.Components.Services

@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject MeadowDataLoader Data
@inject MeadowDialogLauncher Launcher
@inject PCowTreatmentService pCowTreatmentService
@inject MedicineService medicineService
@inject CowService cowService
@inject WhereHowService WhereHowService
@inject UdderService UdderService

<MeadowToolbar>
    <Left>
        <span class="mw-section-title mw-only-desktop">Geplante Kuh Behandlungen</span>
        @if (!_simpleView)
        {
            <MeadowSearchBox Value="@_search" ValueChanged="OnSearchChanged"
                             AriaLabel="Geplante Kuh Behandlungen durchsuchen" />
            @if (_search.Length > 0)
            {
                <span class="mw-result-count mw-only-desktop">@CountText</span>
            }
        }
    </Left>
    <Right>
        @* Stall-Modus: blendet Suche, Zaehler, Pager und zwei Spalten aus und
           ueberspringt die Speichern-Bestaetigung. Bleibt in der Toolbar, weil
           es der einzige Weg zurueck ist. *@
        <MeadowSwitch Value="_simpleView" ValueChanged="OnSimpleViewChanged"
                      Label="Simple Ansicht" />

        <button type="button" class="mw-btn mw-btn--primary" @onclick="Plan">
            <MeadowIcon Name="MeadowIconName.Plus" Size="20" />
            <span>Planen</span>
        </button>
    </Right>
</MeadowToolbar>

<MeadowTable TItem="PlannedCowTreatment" Items="_rows" Columns="_columns"
             RowKey="@(r => r.PlannedCowTreatmentId)"
             DefaultSortTitle="Geplant für"
             ShowPager="@(!_simpleView)"
             PagerLabel="Behandlungen pro Seite"
             EmptyText="Keine geplanten Behandlungen gefunden.">
    <MobileCard Context="row">
        <div class="mw-row-card">
            <div class="mw-row-card__top">
                <span class="mw-row-card__title">Nr. @Collar(row)</span>
                <span class="mw-pill">@Medicine(row)</span>
            </div>
            <div class="mw-row-card__meta">
                <span>@row.AdministrationDate.ToString("dd.MM.yyyy")</span>
                <span>@WhereHow(row)</span>
                <span>@Dosage(row)</span>
            </div>
            <div class="mw-row-card__actions">
                <button type="button" class="mw-btn mw-btn--sm mw-btn--primary"
                        @onclick="() => Complete(row)">Abschließen</button>
                <button type="button" class="mw-btn mw-btn--sm mw-btn--ghost"
                        @onclick="() => Remove(row)">Entfernen</button>
            </div>
        </div>
    </MobileCard>
</MeadowTable>

@code {
    private List<PlannedCowTreatment> _all = new();
    private List<PlannedCowTreatment> _rows = new();
    private List<MeadowColumn<PlannedCowTreatment>> _columns = new();

    private string _search = "";
    private bool _simpleView;

    protected override async Task OnInitializedAsync()
    {
        await Data.EnsurePlannedCowAsync();
        Reload();
    }

    private void Reload()
    {
        _all = pCowTreatmentService.Treatments.Values.ToList();
        _columns = BuildColumns(_simpleView);
        Apply();
    }

    /// <summary>
    /// Beide Spaltenformen an einer Stelle, damit die einfache Ansicht nicht
    /// an zwei Orten gepflegt werden muss.
    /// </summary>
    private List<MeadowColumn<PlannedCowTreatment>> BuildColumns(bool simple)
    {
        var columns = new List<MeadowColumn<PlannedCowTreatment>>
        {
            new()
            {
                Title = "Halsband",
                Text = Collar,
                SortBy = r => CollarSortKey(r),
                Style = MeadowCellStyle.Bold
            },
            new()
            {
                Title = "Ohrmarke",
                // Im Stall-Modus nur die letzten fuenf Stellen - so war es
                // auch bisher.
                Text = r => simple ? ShortEarTag(r) : EarTag(r),
                SortBy = EarTag,
                Style = MeadowCellStyle.Mono
            }
        };

        if (!simple)
        {
            columns.Add(new MeadowColumn<PlannedCowTreatment>
            {
                Title = "Geplant für",
                Text = r => r.AdministrationDate.ToString("dd.MM.yyyy"),
                SortBy = r => r.AdministrationDate,
                NoWrap = true
            });
        }

        columns.Add(new MeadowColumn<PlannedCowTreatment>
        {
            Title = "Medikament",
            Text = Medicine,
            SortBy = Medicine,
            Template = row => @<span class="mw-pill">@Medicine(row)</span>
        });

        // Statt der gezeichneten Spalte "Notiz": Planned_Cow_Treatment hat
        // kein Beschreibungsfeld, also die vorhandenen Angaben.
        columns.Add(new MeadowColumn<PlannedCowTreatment>
        {
            Title = "Wie / Wo",
            Text = WhereHow,
            SortBy = WhereHow
        });

        if (!simple)
        {
            columns.Add(new MeadowColumn<PlannedCowTreatment>
            {
                Title = "Menge",
                Text = Dosage,
                SortBy = r => r.MedicineDosage,
                NoWrap = true
            });
        }

        // Der bisherige Kopf "Behandelt" hatte keine zugehoerige Zelle -
        // Kopf- und Zellenzahl liefen dadurch auseinander.
        columns.Add(new MeadowColumn<PlannedCowTreatment>
        {
            IsActions = true,
            Template = row =>
                @<text>
                    <button type="button" class="mw-btn mw-btn--sm mw-btn--primary"
                            @onclick="() => Complete(row)">Behandlung abschließen</button>
                    <MeadowIconButton Icon="MeadowIconName.Trash" Title="Behandlung entfernen"
                                      Danger="true" OnClick="() => Remove(row)" />
                </text>
        });

        return columns;
    }

    // ---- Anzeige-Helfer -----------------------------------------------

    private string Collar(PlannedCowTreatment r)
    {
        var collar = cowService.GetCollarNumberByCowId(r.EarTagNumber);
        return collar == int.MinValue ? "–" : collar.ToString();
    }

    private int CollarSortKey(PlannedCowTreatment r)
    {
        var collar = cowService.GetCollarNumberByCowId(r.EarTagNumber);
        return collar == int.MinValue ? int.MaxValue : collar;
    }

    private string EarTag(PlannedCowTreatment r) => cowService.GetEarTagDisplay(r.EarTagNumber);

    private string ShortEarTag(PlannedCowTreatment r)
    {
        var tag = EarTag(r);
        return tag.Length > 5 ? tag[^5..] : tag;
    }

    private string Medicine(PlannedCowTreatment r) => medicineService.GetMedicineNameById(r.MedicineId);

    private string WhereHow(PlannedCowTreatment r)
        => WhereHowService.GetFullWhereHowName(r.WhereHowId, UdderService, r.UdderId);

    private string Dosage(PlannedCowTreatment r) => r.MedicineDosage.ToString("0.##");

    private string CountText => $"{_rows.Count} von {_all.Count}";

    // ---- Filter -------------------------------------------------------

    private void Apply()
    {
        IEnumerable<PlannedCowTreatment> query = _all;

        var search = _search.Trim();
        if (search.Length > 0 && !_simpleView)
        {
            query = query.Where(r =>
                Collar(r).Contains(search, StringComparison.OrdinalIgnoreCase)
                || EarTag(r).Contains(search, StringComparison.OrdinalIgnoreCase)
                || Medicine(r).Contains(search, StringComparison.OrdinalIgnoreCase)
                || WhereHow(r).Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        _rows = query.ToList();
    }

    private void OnSearchChanged(string value)
    {
        _search = value;
        Apply();
    }

    private void OnSimpleViewChanged(bool value)
    {
        _simpleView = value;
        _columns = BuildColumns(_simpleView);
        Apply();
    }

    // ---- Aktionen -----------------------------------------------------

    private async Task Plan()
    {
        if (await Launcher.ShowAndAwaitAsync<Add_Planned_Cow_Treatment_Dialog>())
        {
            await pCowTreatmentService.GetAllDataAsync();
            Reload();
        }
    }

    private async Task Complete(PlannedCowTreatment planned)
    {
        if (!_simpleView && !await Confirm(
                "Speichern",
                "Wollen Sie die Behandlung wirklich speichern?",
                "Ja", Color.Success))
        {
            return;
        }

        var treatment = new CowTreatment
        {
            EarTagNumber = planned.EarTagNumber,
            AdministrationDate = planned.AdministrationDate,
            MedicineDosage = planned.MedicineDosage,
            MedicineId = planned.MedicineId,
            WhereHowId = planned.WhereHowId,
            UdderId = planned.UdderId
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var parameters = new DialogParameters<Add_Cow_Treatment_Dialog>
        {
            { x => x.Cow_Treatment, treatment }
        };

        var dialog = await DialogService.ShowAsync<Add_Cow_Treatment_Dialog>(
            string.Empty, parameters, options);
        var result = await dialog.Result;

        // Bisher wurde der geplante Eintrag geloescht, sobald der Dialog
        // geoeffnet war - auch wenn der Nutzer dort abbrach. Damit war die
        // Planung weg, ohne dass eine Behandlung entstand.
        if (result is null || result.Canceled)
        {
            Snackbar.Add("Abgebrochen — die Planung bleibt bestehen.", Severity.Warning);
            return;
        }

        await pCowTreatmentService.RemoveByIDAsync(planned.PlannedCowTreatmentId);
        Snackbar.Add("Behandlung abgeschlossen.", Severity.Success);
        Reload();
    }

    private async Task Remove(PlannedCowTreatment planned)
    {
        if (!await Confirm(
                "Löschen",
                "Wollen Sie die geplante Behandlung wirklich löschen?",
                "Löschen", Color.Error))
        {
            return;
        }

        await pCowTreatmentService.RemoveByIDAsync(planned.PlannedCowTreatmentId);
        Snackbar.Add("Geplante Behandlung gelöscht.", Severity.Success);
        Reload();
    }

    private async Task<bool> Confirm(string header, string description, string accept, Color scheme)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, NoHeader = true };
        var parameters = new DialogParameters<GenericDialog>
        {
            { x => x.HeaderText, header },
            { x => x.Description, description },
            { x => x.AcceptButtonText, accept },
            { x => x.CancelButtonText, "Abbrechen" },
            { x => x.ColorScheme, scheme }
        };

        var dialog = await DialogService.ShowAsync<GenericDialog>(string.Empty, parameters, options);
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }
}
