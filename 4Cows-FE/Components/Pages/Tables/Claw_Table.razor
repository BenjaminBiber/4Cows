@page "/Klauen_Daten"
@implements IDisposable

@using _4Cows_FE.Components._4CowsComponent.Dialogs
@using _4Cows_FE.Components.Meadow
@using _4Cows_FE.Components.Services
@using OfficeOpenXml
@using OfficeOpenXml.Style

@inject IDialogService DialogService
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject MeadowDataLoader Data
@inject MeadowDialogLauncher Launcher
@inject MeadowDataChanges Changes
@inject ISnackbar Snackbar
@inject ClawTreatmentService clawTreatmentService
@inject CowService cowService
@inject SettingsService Settings

<MeadowToolbar>
    <Left>
        <MeadowSearchBox Value="@_filter.Search" ValueChanged="OnSearchChanged"
                         AriaLabel="Klauen Behandlungen durchsuchen" />
        @if (_filter.HasAny)
        {
            <span class="mw-result-count mw-only-desktop">@CountText</span>
        }
    </Left>
    <Right>
        <MeadowFilterPopover Open="_filterOpen" ShowReset="@(_filter.ActiveCount > 0)"
                             CountText="@($"{CountText} Behandlungen")"
                             OnClose="CloseFilter" OnReset="ResetFilter">
            <Trigger>
                <MeadowFilterButton ActiveCount="_filter.ActiveCount" Open="_filterOpen"
                                    OnClick="ToggleFilter" />
            </Trigger>
            <ChildContent>
                <MeadowMultiSelect Label="Befund" Options="FindingOptions"
                                   Selected="_filter.Findings"
                                   SelectionChanged="Apply" />
                <MeadowMultiSelect Label="Kuh (Halsband)" Options="CowOptions"
                                   Selected="_filter.Cows"
                                   SelectionChanged="Apply" />
            </ChildContent>
        </MeadowFilterPopover>

        <MeadowSplitButton Label="Neue Behandlung" Icon="MeadowIconName.Plus"
                           Class="mw-only-desktop"
                           Open="_actionsOpen"
                           OnClick="AddTreatment"
                           OnToggle="ToggleActions"
                           OnClose="CloseActions">
            <button type="button" role="menuitem" class="mw-split__item"
                    @onclick="ExportFile">
                <MeadowIcon Name="MeadowIconName.Download" Size="17" />
                <span>Als Excel exportieren</span>
            </button>
        </MeadowSplitButton>

        @* Mobil faellt der Split-Button weg: die Hauptaktion deckt der FAB in
           der Tabbar ab, und im Menue bleibt nur der Export - der bekommt
           deshalb einen eigenen Icon-Button statt eines Chevrons, der erst
           ein Menue mit einem einzigen Eintrag aufklappt. *@
        <button type="button" class="mw-btn mw-btn--ghost mw-btn--icon mw-only-mobile"
                title="Als Excel exportieren" aria-label="Als Excel exportieren"
                @onclick="DownloadFile">
            <MeadowIcon Name="MeadowIconName.Download" Size="18" />
        </button>
    </Right>
</MeadowToolbar>

<MeadowTable TItem="ClawTreatment" Items="_rows" Columns="_columns"
             RowKey="@(r => r.ClawTreatmentId)"
             DefaultSortTitle="Datum" DefaultSortDescending="true"
             PagerLabel="Behandlungen pro Seite"
             MoreLabel="Weitere Behandlungen laden"
             EmptyText="Keine Behandlungen gefunden.">
    <EmptyContent>
        @if (_filter.HasAny)
        {
            <button type="button" class="mw-empty__reset" @onclick="ClearAll">
                Suche und Filter zurücksetzen
            </button>
        }
    </EmptyContent>
    <MobileCard Context="row">
        <button type="button" class="mw-row-card mw-row-card--clickable"
                @onclick="() => OpenTreatment(row)">
            <div class="mw-row-card__top">
                <span class="mw-row-card__title">Nr. @Collar(row)</span>
                <span class="mw-row-card__sub">@row.TreatmentDate.ToString("dd.MM.yyyy")</span>
            </div>
            <span class="mw-row-card__code">@EarTag(row)</span>
            <div class="mw-row-card__meta"><span>@Summary(row)</span></div>
        </button>
    </MobileCard>
</MeadowTable>

@code {
    private readonly ClawTableFilter _filter = new();
    private bool _filterOpen;
    private bool _actionsOpen;

    private List<ClawTreatment> _all = new();
    private List<ClawTreatment> _rows = new();
    private List<MeadowColumn<ClawTreatment>> _columns = new();

    // Die Befunde-Zusammenfassung ist auch das Suchfeld dieser Tabelle -
    // deshalb einmal pro Datenladen vorberechnet, nicht pro Tastendruck.
    private Dictionary<int, string> _summaries = new();

    protected override async Task OnInitializedAsync()
    {
        await Data.EnsureClawTreatmentsAsync();
        // Eine KPI-Kachel verlinkt mit ihren Filtern im Query-String hierher. ApplyTo mutiert das
        // vorhandene _filter, also leuchtet die ganze Filter-UI von selbst auf.
        KpiDrillDown.ApplyTo(_filter, Nav);
        Reload();
        BuildColumns();

        Changes.Changed += OnDataChanged;
    }

    public void Dispose() => Changes.Changed -= OnDataChanged;

    private void OnDataChanged(MeadowDataKind kind)
    {
        if (kind != MeadowDataKind.ClawTreatment)
        {
            return;
        }

        // Die Meldung kommt aus dem Dialog-Aufrufer, nicht aus dem
        // Renderpfad dieser Seite - deshalb InvokeAsync.
        _ = InvokeAsync(async () =>
        {
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private async Task ReloadAsync()
    {
        await clawTreatmentService.GetAllDataAsync();
        Reload();
    }

    private void Reload()
    {
        _all = clawTreatmentService.GetClawTreatments();
        _summaries = _all.ToDictionary(
            t => t.ClawTreatmentId,
            t => ClawFindingSummary.Build(t, Settings.ClawFindingFallback));
        Apply();
    }

    private void BuildColumns() => _columns = new()
    {
        new MeadowColumn<ClawTreatment>
        {
            Title = "Halsband",
            Text = Collar,
            SortBy = r => CollarSortKey(r),
            Style = MeadowCellStyle.Bold
        },
        new MeadowColumn<ClawTreatment>
        {
            Title = "Ohrmarke",
            Text = EarTag,
            SortBy = EarTag,
            Style = MeadowCellStyle.Mono
        },
        new MeadowColumn<ClawTreatment>
        {
            Title = "Datum",
            Text = r => r.TreatmentDate.ToString("dd.MM.yyyy"),
            SortBy = r => r.TreatmentDate,
            NoWrap = true
        },
        new MeadowColumn<ClawTreatment>
        {
            // Neu: bisher musste man jede Behandlung oeffnen, um irgendeinen
            // klinischen Befund zu sehen.
            Title = "Befunde",
            Text = Summary,
            SortBy = Summary
        },
        new MeadowColumn<ClawTreatment>
        {
            IsActions = true,
            Template = row => @<button type="button" class="mw-btn mw-btn--sm mw-btn--primary"
                                       @onclick="() => OpenTreatment(row)">Behandlung öffnen</button>
        }
    };

    // ---- Anzeige-Helfer -----------------------------------------------

    private string Collar(ClawTreatment r)
    {
        var collar = cowService.GetCollarNumberByCowId(r.EarTagNumber);
        return collar == int.MinValue ? "–" : collar.ToString();
    }

    private int CollarSortKey(ClawTreatment r)
    {
        var collar = cowService.GetCollarNumberByCowId(r.EarTagNumber);
        return collar == int.MinValue ? int.MaxValue : collar;
    }

    private string EarTag(ClawTreatment r) => cowService.GetEarTagDisplay(r.EarTagNumber);

    private string Summary(ClawTreatment r)
        => _summaries.TryGetValue(r.ClawTreatmentId, out var s) ? s : "";

    // ---- Filter -------------------------------------------------------

    /// <summary>
    /// Die tatsaechlich vorkommenden Befunde - ClawFindingList macht nur
    /// Distinct() ohne Leer-Filter, sonst gaebe es leere Chips. Dazu die zwei
    /// synthetischen Chips aus dem Design, die keine Befunde sind.
    /// </summary>
    private IReadOnlyList<string> FindingOptions
    {
        get
        {
            var findings = clawTreatmentService.ClawFindingList
                .Select(f => f?.Trim() ?? "")
                .Where(f => f.Length > 0)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(f => f, StringComparer.CurrentCulture)
                .ToList();

            findings.Add(ClawTableFilter.BandageOption);
            findings.Add(ClawTableFilter.BlockOption);
            return findings;
        }
    }

    /// <summary>
    /// Halsbandnummern der vorkommenden Zeilen, numerisch sortiert - alphabetisch
    /// stuende 104 vor 21.
    /// </summary>
    private IReadOnlyList<string> CowOptions => _all
        .Select(Collar)
        .Where(c => c != "–")
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(c => int.TryParse(c, out var number) ? number : int.MaxValue)
        .ToList();

    private string CountText => $"{_rows.Count} von {_all.Count}";

    private void Apply()
    {
        IEnumerable<ClawTreatment> query = _all;

        var search = _filter.Search.Trim();
        if (search.Length > 0)
        {
            query = query.Where(r =>
                Collar(r).Contains(search, StringComparison.OrdinalIgnoreCase)
                || cowService.GetEarTagDisplay(r.EarTagNumber)
                    .Contains(search, StringComparison.OrdinalIgnoreCase)
                || Summary(r).Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        // Leere Auswahl = kein Filter.
        if (_filter.Findings.Count > 0)
        {
            query = query.Where(MatchesAnyFinding);
        }

        // Gleichheit auf der Halsbandnummer, nicht Teilstring: genau das
        // unterscheidet den Kachel-Drill-down von der Suche, die "104" auch in
        // der Ohrmarke "... 1042" findet.
        if (_filter.Cows.Count > 0)
        {
            query = query.Where(r => _filter.Cows.Contains(Collar(r)));
        }

        _rows = query.ToList();
    }

    // ODER ueber die gewaehlten Werte: eine Zeile passt, sobald sie EINEN
    // davon traegt. Damit laesst sich "Mortellaro oder Sohlengeschwuer" in
    // einem Durchgang zeigen - die fruehere Einfachauswahl brauchte zwei.
    private bool MatchesAnyFinding(ClawTreatment r)
        => _filter.Findings.Any(value => MatchesFinding(r, value));

    // Verband und Klotz stehen mit in der Werteliste, sind aber Zustaende und
    // keine Befunde - deshalb getrennt geprueft.
    private bool MatchesFinding(ClawTreatment r, string value)
    {
        if (string.Equals(value, ClawTableFilter.BandageOption, StringComparison.OrdinalIgnoreCase))
        {
            return !r.IsBandageRemoved && HoofPositions.All.Any(r.GetBandage);
        }

        if (string.Equals(value, ClawTableFilter.BlockOption, StringComparison.OrdinalIgnoreCase))
        {
            return HoofPositions.All.Any(r.GetBlock);
        }

        // Gleichheit auf dem Befund, nicht Teilstring auf der
        // Zusammenfassung - sonst wuerde "Mortellaro" auch "Mortellaro (M2)"
        // und die Woerter Verband/Klotz mitfangen.
        return HoofPositions.All.Any(p =>
            string.Equals(r.GetFinding(p)?.Trim(), value, StringComparison.OrdinalIgnoreCase));
    }

    private void OnSearchChanged(string value)
    {
        _filter.Search = value;
        Apply();
    }

    // Die beiden Popover schliessen sich gegenseitig - sonst liegen zwei
    // Backdrops uebereinander und der erste Klick daneben trifft nur einen.
    private void ToggleFilter()
    {
        _filterOpen = !_filterOpen;
        _actionsOpen = false;
    }

    private void ToggleActions()
    {
        _actionsOpen = !_actionsOpen;
        _filterOpen = false;
    }

    private void CloseActions() => _actionsOpen = false;

    private async Task ExportFile()
    {
        _actionsOpen = false;
        await DownloadFile();
    }

    private void CloseFilter() => _filterOpen = false;

    private void ResetFilter()
    {
        _filter.Reset();
        Apply();
    }

    private void ClearAll()
    {
        _filter.Search = "";
        _filter.Reset();
        Apply();
    }

    // ---- Aktionen -----------------------------------------------------

    private async Task OpenTreatment(ClawTreatment treatment)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };
        var parameters = new DialogParameters<Show_Claw_Treatment_Dialog>
        {
            { x => x.Claw_Treatment, treatment }
        };

        var dialog = await DialogService.ShowAsync<Show_Claw_Treatment_Dialog>(
            string.Empty, parameters, options);
        var result = await dialog.Result;

        // "Bearbeiten" gibt die Behandlung zurueck und oeffnet damit den
        // Add-Dialog im Aenderungsmodus (ClawTreatmentId != 0). Moeglich,
        // seit der Service ein UpdateDataAsync hat.
        if (result is null || result.Canceled || result.Data is not ClawTreatment edit)
        {
            return;
        }

        await EditTreatment(edit);
    }

    private async Task EditTreatment(ClawTreatment treatment)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };
        var parameters = new DialogParameters<Add_Claw_Treatment_Dialog>
        {
            { x => x.Claw_Treatment, treatment }
        };

        var dialog = await DialogService.ShowAsync<Add_Claw_Treatment_Dialog>(
            string.Empty, parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        await ReloadAsync();
    }

    // Derselbe Weg wie FAB, Add-Menue und Dashboard: der Launcher meldet das
    // Speichern, OnDataChanged laedt nach.
    private Task AddTreatment() => Launcher.OpenClawTreatmentAsync();

    // ---- Excel-Export -------------------------------------------------

    private async Task DownloadFile()
    {
        try
        {
            var bytes = ExportDataToExcel();
            await JS.InvokeVoidAsync(
                "downloadFile",
                $"Klauenbehandlungen Export {DateTime.Now:dd-MM-yyyy}.xlsx",
                Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export fehlgeschlagen: {ex.Message}", Severity.Error);
        }
    }

    private byte[] ExportDataToExcel()
    {
        using var package = new ExcelPackage();
        var sheet = package.Workbook.Worksheets.Add("Klauenbehandlungen");

        // Reihenfolge korrigiert: die Kopfzeile begann mit "Halsbandnummer",
        // geschrieben wurde in Spalte 1 aber die Ohrmarke.
        string[] headers =
        {
            "Ohrmarkennummer", "Halsbandnummer", "Datum",
            "Behandlung LV", "Verband LV", "Klotz LV",
            "Behandlung RV", "Verband RV", "Klotz RV",
            "Behandlung LH", "Verband LH", "Klotz LH",
            "Behandlung RH", "Verband RH", "Klotz RH",
            "Wurde Verband entfernt?"
        };

        for (var i = 0; i < headers.Length; i++)
        {
            var cell = sheet.Cells[1, i + 1];
            cell.Value = headers[i];
            cell.Style.Fill.PatternType = ExcelFillStyle.Solid;
            // Hier stand System.Drawing.ColorTranslator.FromHtml(MudBlazor.Color.Primary.ToString()),
            // also der String "Primary" - das wirft, und zwar beim ersten
            // Kopffeld. Der Export war damit komplett unbenutzbar.
            cell.Style.Fill.BackgroundColor.SetColor(System.Drawing.ColorTranslator.FromHtml("#2C7DA0"));
            cell.Style.Font.Color.SetColor(System.Drawing.Color.White);
            cell.Style.Font.Bold = true;
            cell.Style.Font.Size = 12;
        }

        var rows = _rows.OrderByDescending(r => r.TreatmentDate).ToList();
        for (var i = 0; i < rows.Count; i++)
        {
            var t = rows[i];
            // Datenzeilen beginnen direkt unter dem Kopf; vorher ab Zeile 3,
            // wodurch Zeile 2 immer leer blieb.
            var row = i + 2;

            sheet.Cells[row, 1].Value = cowService.GetEarTagDisplay(t.EarTagNumber);
            sheet.Cells[row, 2].Value = Collar(t);
            sheet.Cells[row, 3].Value = t.TreatmentDate.ToString("dd.MM.yyyy");

            var column = 4;
            foreach (var position in new[] { HoofPosition.LV, HoofPosition.RV, HoofPosition.LH, HoofPosition.RH })
            {
                sheet.Cells[row, column++].Value = t.GetFinding(position);
                sheet.Cells[row, column++].Value = t.GetBandage(position) ? "Verband" : "Kein Verband";
                sheet.Cells[row, column++].Value = t.GetBlock(position) ? "Klotz" : "Kein Klotz";
            }

            // Spalte 16 ist "Wurde Verband entfernt?" - markiert wurde vorher
            // Spalte 15 ("Klotz RH").
            var removed = sheet.Cells[row, 16];
            removed.Value = t.IsBandageRemoved ? "Ja" : "Nein";
            removed.Style.Fill.PatternType = ExcelFillStyle.Solid;
            removed.Style.Fill.BackgroundColor.SetColor(
                t.IsBandageRemoved ? System.Drawing.Color.LightGreen : System.Drawing.Color.LightPink);
        }

        for (var i = 1; i <= headers.Length; i++)
        {
            sheet.Column(i).Width = 20;
        }

        return package.GetAsByteArray();
    }
}
